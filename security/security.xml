<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>

         <record model="ir.module.category" id="car_maintain_category">
            <field name="name">Car Maintain</field>
            <field name="description">All available permissions for Car Maintain</field>
            <field name="sequence">40</field>
        </record>

        <record id="group_sales_man_priv" model="res.groups">
			<field name="name">منح صلاحيات البائع</field>
            <field name="category_id" ref="car_maintain_category" />
		</record>

        <record id="group_supervisor_priv" model="res.groups">
			<field name="name">منح صلاحيات المشرف</field>
            <field name="category_id" ref="car_maintain_category" />

		</record>
        <record id="group_technician_priv" model="res.groups">
			<field name="name">منح صلاحية الفني</field>
            <field name="category_id" ref="car_maintain_category" />

		</record>
         <record id="group_add_spare_parts_priv" model="res.groups">
			<field name="name">منح صلاحية اضافة قطع الغيار في شاشة امر العمل</field>
            <field name="category_id" ref="car_maintain_category" />

		</record>
        <record id="group_rtn_to_draft_and_cancel_priv" model="res.groups">
			<field name="name">منح صلاحية الاستعادة للتعديل والغاء الطلبات في نظام الصيانة</field>
            <field name="category_id" ref="car_maintain_category" />

		</record>
        <record id="group_un_close_cash_priv" model="res.groups">
			<field name="name"> الغاء اقفال الصناديق</field>
            <field name="category_id" ref="car_maintain_category" />

		</record>
        <record id="group_allow_delete_wo_priv" model="res.groups">
			<field name="name">منح صلاحية حذف طلبات الفحص واومر العمل</field>
            <field name="category_id" ref="car_maintain_category" />

		</record>
        <record id="group_allow_matched_cash_priv" model="res.groups">
			<field name="name">منح صلاحية مطابقة الصناديق</field>
            <field name="category_id" ref="car_maintain_category" />

		</record>
        <record id="group_cancel_register_payment" model="res.groups">
			<field name="name">منح صلاحية  الفاء الدفع في نظام الصيانة</field>
            <field name="category_id" ref="car_maintain_category" />

		</record>


        <record id="group_skip_checkup_procedure" model="res.groups">
			<field name="name">تجاوز مرحلة الفحص في نظام الصيانة</field>
            <field name="category_id" ref="car_maintain_category" />

		</record>
        
        <record id="car_checkup_branch_rules" model="ir.rule">
            <field name="name">car checkup Branch</field>
            <field name="model_id" ref="model_mizan_car_entry_card_master"/>
            <field name="global" eval="True"/>
             <!-- <field name="domain_force">['|',('company_id','!=',int(user.is_admin)), ('company_id', 'in',
                    user.allowed_branch_ids.ids)]</field> -->
            	<field name="perm_read" eval="True" />
			<field name="perm_write" eval="True" />
			<field name="perm_create" eval="True" />
			<field name="perm_unlink" eval="True" />
        </record>

         <record id="car_workstation_picking_branch_rules" model="ir.rule">
            <field name="name">workstation picking Branch</field>
            <field name="model_id" ref="model_mizan_picking_workstation"/>
            <field name="global" eval="True"/>
             <!-- <field name="domain_force">['|',('company_id','!=',int(user.is_admin)), ('company_id', 'in',
                    user.allowed_branch_ids.ids)]</field> -->
             <field name="perm_read" eval="True" />
			<field name="perm_write" eval="True" />
			<field name="perm_create" eval="True" />
			<field name="perm_unlink" eval="True" />
        </record>

        <record id="cash_close_branch_rules" model="ir.rule">
            <field name="name">cash close Branch</field>
            <field name="model_id" ref="model_cash_close_closed"/>
            <field name="global" eval="True"/>
             <!-- <field name="domain_force">['|',('company_id','!=',int(user.is_admin)), ('company_id', 'in',
                    user.allowed_branch_ids.ids)]</field> -->
             <field name="perm_read" eval="True" />
			<field name="perm_write" eval="True" />
			<field name="perm_create" eval="True" />
			<field name="perm_unlink" eval="True" />
        </record>


    </data>
</odoo>
