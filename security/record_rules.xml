<?xml version="1.0" encoding="UTF-8"?>
<odoo>
 <!-- Keep workshop permissions together in the user access-rights form. -->
 <record id="module_category_workshop_permissions" model="ir.module.category">
  <field name="name">ورشة السيارات</field>
  <field name="description">صلاحيات عمليات ورشة السيارات</field>
  <field name="sequence">55</field>
 </record>
 <!-- Explicit permission for inspection creation and its smart button. -->
 <record id="group_workshop_inspection" model="res.groups">
  <field name="name">صلاحية الفحص</field>
  <field name="category_id" ref="module_category_workshop_permissions"/>
 </record>
 <record id="group_workshop_cancel_completed" model="res.groups">
  <field name="name">إلغاء أمر عمل مكتمل</field>
  <field name="category_id" ref="module_category_workshop_permissions"/>
 </record>
 <record id="group_workshop_revoke_approval" model="res.groups">
  <field name="name">إلغاء اعتماد أمر العمل</field>
  <field name="category_id" ref="module_category_workshop_permissions"/>
 </record>
 <record id="group_workshop_delete_draft" model="res.groups">
  <field name="name">حذف أوامر العمل غير المعتمدة</field>
  <field name="category_id" ref="module_category_workshop_permissions"/>
 </record>
 <record id="group_workshop_zero_service" model="res.groups">
  <field name="name">السماح ببيع الخدمات بسعر صفر</field>
  <field name="category_id" ref="module_category_workshop_permissions"/>
 </record>
 <record id="group_workshop_zero_part" model="res.groups">
  <field name="name">السماح ببيع قطع الغيار بسعر صفر</field>
  <field name="category_id" ref="module_category_workshop_permissions"/>
 </record>
 <record id="vehicle_company_rule" model="ir.rule"><field name="name">Reception vehicles by company</field><field name="model_id" ref="model_yt_reception_vehicle"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
 <record id="order_company_rule" model="ir.rule"><field name="name">Reception orders by company</field><field name="model_id" ref="model_yt_reception_order"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
 <record id="complaint_company_rule" model="ir.rule"><field name="name">Reception complaints by company</field><field name="model_id" ref="model_yt_reception_complaint"/><field name="domain_force">[('order_id.company_id','in',company_ids)]</field></record>
 <record id="request_company_rule" model="ir.rule"><field name="name">Reception requests by company</field><field name="model_id" ref="model_yt_reception_request"/><field name="domain_force">[('order_id.company_id','in',company_ids)]</field></record>
 <record id="photo_company_rule" model="ir.rule"><field name="name">Reception photos by company</field><field name="model_id" ref="model_yt_reception_photo"/><field name="domain_force">[('order_id.company_id','in',company_ids)]</field></record>
</odoo>