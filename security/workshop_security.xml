<odoo>
    <record id="module_category_workshop_v2" model="ir.module.category">
        <field name="name">الصيانة V2</field>
        <field name="description">صلاحيات إدارة ورشة السيارات</field>
        <field name="sequence">35</field>
    </record>
    <record id="group_workshop_user" model="res.groups"><field name="name">مستخدم الورشة</field><field name="category_id" ref="module_category_workshop_v2"/></record>
    <record id="group_workshop_manager" model="res.groups"><field name="name">مدير الورشة</field><field name="category_id" ref="module_category_workshop_v2"/><field name="implied_ids" eval="[(4, ref('group_workshop_user'))]"/></record>
    <record id="rule_vehicle_company" model="ir.rule"><field name="name">Workshop V2 vehicle companies</field><field name="model_id" ref="model_ycm_v2_vehicle"/><field name="domain_force">[('company_id','in',company_ids)]</field><field name="groups" eval="[(4, ref('group_workshop_user'))]"/></record>
    <record id="rule_order_company" model="ir.rule"><field name="name">Workshop V2 order companies</field><field name="model_id" ref="model_ycm_v2_order"/><field name="domain_force">[('company_id','in',company_ids)]</field><field name="groups" eval="[(4, ref('group_workshop_user'))]"/></record>
    <record id="rule_order_line_company" model="ir.rule"><field name="name">Workshop V2 order line companies</field><field name="model_id" ref="model_ycm_v2_order_line"/><field name="domain_force">[('company_id','in',company_ids)]</field><field name="groups" eval="[(4, ref('group_workshop_user'))]"/></record>
    <record id="rule_workshop_company" model="ir.rule"><field name="name">Workshop V2 config companies</field><field name="model_id" ref="model_ycm_v2_workshop"/><field name="domain_force">[('company_id','in',company_ids)]</field><field name="groups" eval="[(4, ref('group_workshop_user'))]"/></record>
    <record id="rule_owner_company" model="ir.rule"><field name="name">Workshop V2 owner companies</field><field name="model_id" ref="model_ycm_v2_vehicle_owner"/><field name="domain_force">[('company_id','in',company_ids)]</field><field name="groups" eval="[(4, ref('group_workshop_user'))]"/></record>
    <record id="sequence_workshop_v2" model="ir.sequence"><field name="name">Workshop V2 work order</field><field name="code">ycm.v2.order</field><field name="prefix">WO2/%(year)s/</field><field name="padding">5</field><field name="company_id" eval="False"/></record>
    <record id="rule_inspection_company" model="ir.rule"><field name="name">Workshop V2 inspection companies</field><field name="model_id" ref="model_ycm_v2_inspection"/><field name="domain_force">[('company_id','in',company_ids)]</field><field name="groups" eval="[(4, ref('group_workshop_user'))]"/></record>
    <record id="rule_inspection_component_company" model="ir.rule"><field name="name">Workshop V2 inspection component companies</field><field name="model_id" ref="model_ycm_v2_inspection_component"/><field name="domain_force">[('company_id','in',company_ids)]</field><field name="groups" eval="[(4, ref('group_workshop_user'))]"/></record>
</odoo>
