<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve"><t t-name="ycm_v2.Workshop" owl="1">
  <div class="ycm-v2 h-100" dir="rtl">
    <header class="ycm-top"><div><span class="ycm-eyebrow">YOUSENTECH / WORKSHOP V2</span><h2>مساحة أوامر العمل</h2><span class="text-muted">استقبال • تقدير • اعتماد • تنفيذ</span></div><button class="btn btn-primary" t-on-click="() => this.ui.showCreate = !this.ui.showCreate">+ أمر عمل جديد</button></header>
    <div class="ycm-layout">
      <aside class="ycm-side"><input class="form-control mb-3" placeholder="بحث برقم الأمر أو العميل أو السيارة" t-model="ui.search"/><div class="ycm-scroll"><t t-foreach="filteredOrders" t-as="o" t-key="o.id"><button t-att-class="'ycm-order ' + (ui.selected === o.id ? 'active' : '')" t-on-click="() => this.openOrder(o.id)"><strong t-esc="o.name"/><span t-esc="o.partner_id?.[1] || ''"/><small><t t-esc="o.vehicle_id?.[1] || ''"/> · <t t-esc="o.state"/></small></button></t><div t-if="!filteredOrders.length" class="text-muted p-3">لا توجد أوامر عمل</div></div></aside>
      <main class="ycm-main">
        <section t-if="ui.showCreate" class="ycm-panel"><h4>استقبال سيارة جديدة</h4><div class="ycm-fields"><label>العميل<select class="form-select" t-model="ui.customer"><option value="">اختر العميل</option><t t-foreach="ui.customers" t-as="p" t-key="p.id"><option t-att-value="String(p.id)" t-esc="p.name"/></t></select></label><label>السيارة<select class="form-select" t-model="ui.vehicle"><option value="">اختر السيارة</option><t t-foreach="allowedVehicles" t-as="v" t-key="v.id"><option t-att-value="String(v.id)" t-esc="v.plate_number"/></t></select></label></div><label class="d-block mt-2">الشكوى<textarea class="form-control" t-model="ui.complaint"/></label><button class="btn btn-primary mt-3" t-on-click="createOrder">إنشاء أمر العمل</button></section>
        <t t-if="ui.detail"><div class="ycm-panel"><div class="d-flex justify-content-between gap-2 flex-wrap"><div><span class="ycm-eyebrow">WORK ORDER</span><h3 t-esc="ui.detail.order.name"/><div class="text-muted"><t t-esc="ui.detail.order.partner_id?.[1]"/> — <t t-esc="ui.detail.order.vehicle_id?.[1]"/></div></div><div class="ycm-status" t-esc="ui.detail.order.state"/></div><div class="ycm-actions mt-3"><button t-if="ui.detail.order.state === 'draft'" class="btn btn-outline-primary" t-on-click="() => this.transition('estimate')">إعداد التقدير</button><button t-if="ui.detail.order.state === 'estimate'" class="btn btn-primary" t-on-click="() => this.transition('approved')">اعتماد التقدير (داخلي)</button><button t-if="ui.detail.order.state === 'approved'" class="btn btn-primary" t-on-click="() => this.transition('in_progress')">بدء التنفيذ</button><button t-if="ui.detail.order.state === 'in_progress'" class="btn btn-primary" t-on-click="() => this.transition('completed')">اكتمال فني</button><button t-if="['draft','estimate','approved'].includes(ui.detail.order.state)" class="btn btn-outline-danger" t-on-click="() => this.transition('cancelled')">إلغاء</button></div></div>
          <div class="ycm-panel"><div class="d-flex justify-content-between align-items-center"><h4>الخدمات وقطع الغيار</h4><span class="text-muted" t-esc="ui.detail.lines.length + ' بنود'"/></div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>النوع</th><th>البيان</th><th>الكمية</th><th>السعر</th><th>الضريبة</th><th>الإجمالي</th></tr></thead><tbody><t t-foreach="ui.detail.lines" t-as="l" t-key="l.id"><tr><td><span t-att-class="'ycm-chip ' + (l.kind === 'part' ? 'part' : '')" t-esc="l.kind === 'part' ? 'قطعة' : 'خدمة'"/></td><td t-esc="l.name"/><td t-esc="l.qty"/><td t-esc="l.price_unit"/><td t-esc="l.price_tax"/><td class="fw-bold" t-esc="l.price_total"/></tr></t><tr t-if="!ui.detail.lines.length"><td colspan="6" class="text-muted">أضف خدمة أو قطعة غيار لبدء التقدير</td></tr></tbody></table></div><div t-if="['draft','estimate'].includes(ui.detail.order.state)" class="ycm-add"><select class="form-select" t-model="ui.kind"><option value="service">خدمة</option><option value="part">قطعة غيار</option></select><select class="form-select" t-model="ui.product"><option value="">اختر الصنف</option><t t-foreach="filteredProducts" t-as="p" t-key="p.id"><option t-att-value="String(p.id)" t-esc="p.display_name"/></t></select><input class="form-control" type="number" min="0.01" step="1" t-model="ui.qty"/><button class="btn btn-primary" t-on-click="addLine">+ إضافة</button></div></div>
          <div class="ycm-panel ycm-total"><span>إجمالي أمر العمل (شامل الضريبة)</span><h2><t t-esc="amount"/> <small t-esc="ui.currency"/></h2><div class="text-muted">قبل الضريبة: <t t-esc="ui.detail.order.amount_untaxed"/> · الضريبة: <t t-esc="ui.detail.order.amount_tax"/></div><p class="text-muted mt-2 mb-0">مرحلة V2 الأولى: لا يتم إنشاء قيود أو فواتير أو حركات مخزون من هذه الشاشة بعد.</p></div>
        </t><div t-else="" class="ycm-empty"><h3>أهلاً بك في ورشة V2</h3><p>اختر أمر عمل من القائمة أو أنشئ أمرًا جديدًا.</p></div>
      </main>
    </div>
  </div>
</t></templates>
