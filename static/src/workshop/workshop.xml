<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve"><t t-name="ycm_v2.Workshop" owl="1">
  <div class="ycm-v2 h-100" dir="rtl">
    <header class="ycm-top">
      <div class="ycm-top-title"><span class="ycm-top-icon">🔧</span><div><h2>أمر العمل</h2><span class="ycm-eyebrow" t-esc="ui.detail?.order?.name || (ui.screen === 'wizard' ? 'أمر جديد · الاستقبال' : 'سجل أوامر العمل')"/></div></div>
      <div class="ycm-top-actions"><button class="btn btn-light" t-if="ui.screen === 'wizard'" t-on-click="showOrderList">سجل أوامر العمل</button><button class="btn btn-outline-primary" t-if="ui.screen === 'list'" t-on-click="startNewOrder">+ أمر عمل جديد</button><button class="btn btn-primary" t-if="ui.screen === 'wizard' &amp;&amp; ui.showCreate" t-on-click="createOrder" t-att-disabled="ui.busy">حفظ أمر العمل</button></div>
    </header>
    <div t-if="ui.screen === 'list'" class="ycm-order-index"><div class="ycm-index-heading"><h3>سجل أوامر العمل</h3><p>ابحث عن أمر سابق أو ابدأ استقبال سيارة جديدة.</p></div><input class="form-control ycm-index-search" placeholder="بحث برقم الأمر أو العميل أو السيارة" t-model="ui.search"/><div class="ycm-index-grid"><t t-foreach="filteredOrders" t-as="o" t-key="o.id"><button class="ycm-order ycm-index-order" t-on-click="() => this.openExistingOrder(o.id)"><strong t-esc="o.name"/><span t-esc="o.partner_id?.[1] || ''"/><small><t t-esc="o.vehicle_id?.[1] || ''"/> · <t t-esc="o.state"/></small></button></t><div t-if="!filteredOrders.length" class="ycm-empty-index">لا توجد أوامر عمل مطابقة. اضغط «أمر عمل جديد» للبدء.</div></div></div><div t-if="ui.screen === 'wizard'" class="ycm-layout ycm-layout-wizard">
      <main class="ycm-main">
        <section t-if="ui.showCreate" class="ycm-new-order">
          <div class="ycm-work-head"><div class="ycm-work-identity"><span class="ycm-top-icon">🔧</span><div><h3>أمر عمل جديد</h3><span class="ycm-muted">الاستقبال · بيانات العميل والسيارة</span></div></div><div class="ycm-steps" role="navigation" aria-label="مراحل أمر العمل"><t t-foreach="steps" t-as="stepName" t-key="stepName"><div t-att-class="'ycm-step ' + (stepName_index === 0 ? 'is-active' : 'is-disabled')"><span class="ycm-step-number" t-esc="stepName_index + 1"/><span t-esc="stepName"/></div></t></div></div>
          <div class="ycm-panel ycm-intake-panel"><div class="ycm-section-title"><h4>استقبال السيارة</h4><p>اختر العميل وسيارته المسجلة، أو سجل سيارة جديدة لنفس العميل.</p></div><div class="ycm-fields"><label>العميل<select class="form-select" t-model="ui.customer" t-on-change="onCustomerChange"><option value="">اختر العميل</option><t t-foreach="ui.customers" t-as="p" t-key="p.id"><option t-att-value="p.id" t-esc="p.name"/></t></select></label><label>السيارة<select class="form-select" t-model="ui.vehicle"><option value="">اختر السيارة</option><t t-foreach="allowedVehicles" t-as="v" t-key="v.id"><option t-att-value="v.id" t-esc="v.plate_number"/></t></select><button type="button" class="btn btn-outline-primary mt-2" t-on-click="openVehicleModal">+ تسجيل سيارة جديدة لهذا العميل</button></label></div><label class="d-block mt-2">الشكوى<textarea class="form-control" t-model="ui.complaint"/></label><div class="ycm-intake-actions"><button class="btn btn-light" t-on-click="showOrderList">إلغاء</button><button class="btn btn-primary" t-on-click="createOrder" t-att-disabled="ui.busy">حفظ ومتابعة الفحص ←</button></div></div></section>
        <t t-if="ui.detail &amp;&amp; !ui.showCreate">
          <section class="ycm-work-head">
            <div class="ycm-work-identity"><span class="ycm-eyebrow">WORK ORDER</span><h3 t-esc="ui.detail.order.name"/><span class="ycm-status" t-esc="ui.detail.order.state"/></div>
            <div class="ycm-steps" role="navigation" aria-label="مراحل أمر العمل">
              <t t-foreach="steps" t-as="stepName" t-key="stepName">
                <button type="button" t-att-class="'ycm-step ' + (ui.step === stepName_index + 1 ? 'is-active' : '')" t-on-click="() => this.selectStep(stepName_index + 1)">
                  <span class="ycm-step-number" t-esc="stepName_index + 1"/><span t-esc="stepName"/>
                </button>
              </t>
            </div>
          </section>
          <section class="ycm-context">
            <div><span class="ycm-muted">العميل</span><strong t-esc="ui.detail.order.partner_id?.[1] || '—'"/><small t-esc="activeCustomer?.phone || ''"/></div>
            <div><span class="ycm-muted">السيارة</span><strong t-esc="ui.detail.order.vehicle_id?.[1] || '—'"/><small t-esc="activeVehicle ? [activeVehicle.make, activeVehicle.model, activeVehicle.year].filter(Boolean).join(' · ') : ''"/></div>
            <div><span class="ycm-muted">الحالة</span><strong t-esc="ui.detail.order.state"/></div>
          </section>
          <div class="ycm-wizard-grid">
            <div class="ycm-wizard-body">
              <section t-if="ui.step === 1" class="ycm-panel">
                <div class="ycm-section-title"><h4>الاستقبال</h4><p>بيانات السيارة والشكوى المسجلة عند فتح أمر العمل.</p></div>
                <div class="ycm-info-grid"><div><span>العميل</span><strong t-esc="ui.detail.order.partner_id?.[1]"/></div><div><span>السيارة</span><strong t-esc="ui.detail.order.vehicle_id?.[1]"/></div><div><span>قراءة العداد</span><strong t-esc="ui.detail.order.odometer_in"/></div><div><span>موعد التسليم المتوقع</span><strong t-esc="ui.detail.order.promised_at || 'غير محدد'"/></div></div>
                <label class="ycm-field-label">شكوى العميل</label><div class="ycm-readonly" t-esc="ui.detail.order.complaint || 'لم تُسجل شكوى'"/>
              </section>
              <section t-if="ui.step === 2" class="ycm-panel">
                <div class="ycm-section-title"><h4>الفحص العام للسيارة</h4><p>توثيق تشخيص الفني قبل إعداد الخدمات والقطع.</p></div>
                <label class="ycm-field-label" for="ycm-diagnosis">ملاحظات الفحص والتشخيص</label>
                <textarea id="ycm-diagnosis" class="form-control ycm-notes" t-model="ui.diagnosisDraft" t-att-readonly="!canEditLines" placeholder="اكتب نتائج الفحص والملاحظات الفنية..."/>
                <div class="ycm-panel-actions"><button class="btn btn-primary" t-att-disabled="!canEditLines || ui.busy" t-on-click="saveDiagnosis">حفظ الفحص</button></div>
                <div t-if="ui.inspection" class="mt-3">
  <h5 class="ycm-subheading">فحص المكونات الرئيسية</h5>
  <div class="table-responsive"><table class="table ycm-table"><thead><tr><th>المكون</th><th>الحالة</th><th>ملاحظات</th></tr></thead><tbody>
    <t t-foreach="inspectionComponents" t-as="item" t-key="item.key"><tr>
      <td t-esc="item.name"/>
      <td><select class="form-select" t-att-disabled="!canEditLines" t-att-value="ui.inspection.components[item.key].condition" t-on-change="(ev) => this.setInspectionCondition(item.key, ev)">
        <option value="good">جيد</option><option value="inspect">يحتاج فحص</option><option value="repair">يحتاج صيانة</option><option value="damaged">تالف</option>
      </select></td>
      <td><input class="form-control" maxlength="500" t-att-disabled="!canEditLines" t-att-value="ui.inspection.components[item.key].notes" t-on-input="(ev) => this.setInspectionNote(item.key, ev)"/></td>
    </tr></t>
  </tbody></table></div>
  <label class="ycm-field-label">ملاحظات الهيكل الخارجي</label>
  <textarea class="form-control" t-model="ui.inspection.exterior_notes" t-att-readonly="!canEditLines"/>
  <label class="ycm-field-label mt-2">ملاحظات إضافية</label>
  <textarea class="form-control" t-model="ui.inspection.additional_notes" t-att-readonly="!canEditLines"/>
  <div class="ycm-panel-actions"><button class="btn btn-primary" t-att-disabled="!canEditLines || ui.inspectionBusy" t-on-click="saveInspection">حفظ نتائج فحص المكونات</button></div>
</div>
              </section>
              <section t-if="ui.step === 3" class="ycm-panel">
                <div class="ycm-section-title"><h4>الخدمات وقطع الغيار</h4><p>اختر الأصناف من كتالوج Odoo، وتُحسب الضرائب من إعدادات الصنف.</p></div>
                <div class="ycm-catalog-controls">
                  <div class="ycm-tabs"><button t-att-class="ui.kind === 'service' ? 'active' : ''" t-on-click="() => { this.ui.kind = 'service'; this.ui.catalogSearch = ''; }">الخدمات</button><button t-att-class="ui.kind === 'part' ? 'active' : ''" t-on-click="() => { this.ui.kind = 'part'; this.ui.catalogSearch = ''; }">قطع الغيار</button></div>
                  <input class="form-control" placeholder="بحث عن صنف..." t-model="ui.catalogSearch"/>
                </div>
                <div class="ycm-catalog-list"><t t-foreach="matchingProducts" t-as="p" t-key="p.id"><div class="ycm-catalog-item"><div><strong t-esc="p.display_name"/><small><t t-esc="p.list_price"/> <t t-esc="ui.currency"/></small></div><button class="btn btn-outline-primary btn-sm" t-att-disabled="!canEditLines || ui.busy" t-on-click="() => this.addCatalogProduct(p.id, ui.kind)">إضافة +</button></div></t><p t-if="!matchingProducts.length" class="ycm-helper">لا توجد أصناف مطابقة.</p></div>
                <h5 class="ycm-subheading">الخدمات المختارة</h5><div class="table-responsive"><table class="table ycm-table"><thead><tr><th>الخدمة</th><th>الكمية</th><th>قبل الضريبة</th><th>الضريبة</th><th>الإجمالي</th></tr></thead><tbody><t t-foreach="serviceLines" t-as="l" t-key="l.id"><tr><td t-esc="l.name"/><td t-esc="l.qty"/><td t-esc="l.price_subtotal"/><td t-esc="l.price_tax"/><td t-esc="l.price_total"/></tr></t><tr t-if="!serviceLines.length"><td colspan="5" class="ycm-muted">لا توجد خدمات مضافة.</td></tr></tbody></table></div>
                <h5 class="ycm-subheading">قطع الغيار المختارة</h5><div class="table-responsive"><table class="table ycm-table"><thead><tr><th>القطعة</th><th>الكمية</th><th>قبل الضريبة</th><th>الضريبة</th><th>الإجمالي</th></tr></thead><tbody><t t-foreach="partLines" t-as="l" t-key="l.id"><tr><td t-esc="l.name"/><td t-esc="l.qty"/><td t-esc="l.price_subtotal"/><td t-esc="l.price_tax"/><td t-esc="l.price_total"/></tr></t><tr t-if="!partLines.length"><td colspan="5" class="ycm-muted">لا توجد قطع غيار مضافة.</td></tr></tbody></table></div>
              </section>
              <section t-if="ui.step === 4" class="ycm-panel">
                <div class="ycm-section-title"><h4>اعتماد العميل</h4><p>مراجعة تقدير الخدمات وقطع الغيار قبل بدء التنفيذ.</p></div>
                <div class="ycm-info-grid"><div><span>عدد الخدمات</span><strong t-esc="serviceLines.length"/></div><div><span>عدد القطع</span><strong t-esc="partLines.length"/></div><div><span>الإجمالي</span><strong><t t-esc="amount"/> <t t-esc="ui.currency"/></strong></div></div>
                <div class="ycm-warning" t-esc="stepNotice"/>
                <button t-if="ui.detail.order.state === 'draft'" class="btn btn-outline-primary" t-on-click="() => this.transition('estimate')">إعداد التقدير</button>
                <button t-if="ui.detail.order.state === 'estimate'" class="btn btn-primary" t-on-click="() => this.transition('approved')">اعتماد داخلي للتقدير</button>
              </section>
              <section t-if="ui.step === 5" class="ycm-panel">
                <div class="ycm-section-title"><h4>التنفيذ</h4><p>عرض البنود المعتمدة وحالة التنفيذ الفعلية.</p></div>
                <div class="ycm-warning" t-esc="stepNotice"/>
                <div class="ycm-info-grid"><div><span>الخدمات</span><strong t-esc="serviceLines.length"/></div><div><span>قطع الغيار</span><strong t-esc="partLines.length"/></div></div>
                <button t-if="ui.detail.order.state === 'approved'" class="btn btn-primary mt-3" t-on-click="() => this.transition('in_progress')">بدء التنفيذ</button>
                <button t-if="ui.detail.order.state === 'in_progress'" class="btn btn-outline-primary mt-3" t-on-click="() => this.transition('completed')">تسجيل اكتمال فني</button>
              </section>
              <section t-if="ui.step === 6" class="ycm-panel">
                <div class="ycm-section-title"><h4>الإغلاق والتسليم</h4><p>ملخص أمر العمل قبل التسليم.</p></div>
                <div class="ycm-warning" t-esc="stepNotice"/>
                <div class="ycm-info-grid"><div><span>حالة أمر العمل</span><strong t-esc="ui.detail.order.state"/></div><div><span>إجمالي المستحق</span><strong><t t-esc="amount"/> <t t-esc="ui.currency"/></strong></div></div>
                <p class="ycm-helper">لن يظهر زر تسليم نهائي قبل ربط فحص الجودة والفواتير والمدفوعات والتوقيع ببيانات فعلية.</p>
              </section>
            </div>
            <aside class="ycm-wizard-aside">
              <div class="ycm-panel"><h5>ملخص الأسعار</h5><div class="ycm-price-row"><span>قبل الضريبة</span><strong t-esc="ui.detail.order.amount_untaxed"/></div><div class="ycm-price-row"><span>الضريبة</span><strong t-esc="ui.detail.order.amount_tax"/></div><div class="ycm-price-row ycm-price-total"><span>الإجمالي</span><strong><t t-esc="amount"/> <t t-esc="ui.currency"/></strong></div></div>
              <div class="ycm-panel"><h5>معلومات الأمر</h5><div class="ycm-price-row"><span>رقم الأمر</span><strong t-esc="ui.detail.order.name"/></div><div class="ycm-price-row"><span>العميل</span><strong t-esc="ui.detail.order.partner_id?.[1]"/></div><div class="ycm-price-row"><span>السيارة</span><strong t-esc="ui.detail.order.vehicle_id?.[1]"/></div></div>
            </aside>
          </div>
          <footer class="ycm-wizard-footer"><button class="btn btn-light" t-att-disabled="ui.step === 1" t-on-click="() => this.selectStep(ui.step - 1)">السابق</button><button class="btn btn-primary" t-att-disabled="ui.step === 6" t-on-click="() => this.selectStep(ui.step + 1)">التالي</button></footer>
        </t>
      </main>
    </div>
    <div t-if="ui.showVehicleModal" class="modal d-block" tabindex="-1" role="dialog" style="background: rgba(0,0,0,.45); z-index: 1060;">
      <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable" role="document">
        <div class="modal-content">
          <div class="modal-header"><h5 class="modal-title">تسجيل سيارة جديدة للعميل</h5><button type="button" class="btn-close" aria-label="إغلاق" t-on-click="() => this.ui.showVehicleModal = false"/></div>
          <div class="modal-body">
            <p class="text-muted">سيتم حفظ السيارة في سجل السيارات وربطها بالعميل المختار، مع التحقق من عدم التكرار.</p>
            <div class="row g-3">
              <div class="col-md-6"><label class="form-label">رقم اللوحة *</label><input class="form-control" t-model="ui.vehicleDraft.plate_number"/></div>
              <div class="col-md-3"><label class="form-label">دولة اللوحة</label><input class="form-control" t-model="ui.vehicleDraft.plate_country"/></div>
              <div class="col-md-3"><label class="form-label">نوع اللوحة</label><select class="form-select" t-model="ui.vehicleDraft.plate_type"><option value="private">خصوصي</option><option value="commercial">تجاري</option><option value="public">عام</option><option value="other">أخرى</option></select></div>
              <div class="col-md-6"><label class="form-label">رقم الشاصي VIN</label><input class="form-control" maxlength="17" t-model="ui.vehicleDraft.vin"/></div>
              <div class="col-md-6">
                <label class="form-label">الشركة المصنعة *</label>
                <select class="form-select" t-model="ui.vehicleDraft.make_id" t-on-change="onMakeChange">
                  <option value="">اختر الشركة المصنعة</option>
                  <t t-foreach="ui.makes" t-as="make" t-key="make.id"><option t-att-value="make.id" t-esc="make.name"/></t>
                </select>
                <button type="button" class="btn btn-link btn-sm p-0 mt-1" t-on-click="() => this.ui.showMakeCreate = !this.ui.showMakeCreate">+ إنشاء شركة مصنعة</button>
                <div t-if="ui.showMakeCreate" class="input-group mt-2">
                  <input class="form-control" placeholder="اسم الشركة الجديدة" t-model="ui.newMakeName"/>
                  <button type="button" class="btn btn-outline-primary" t-att-disabled="ui.savingCatalog || !ui.newMakeName.trim()" t-on-click="createMake">إنشاء واختيار</button>
                </div>
              </div>
              <div class="col-md-6">
                <label class="form-label">الموديل *</label>
                <select class="form-select" t-model="ui.vehicleDraft.model_id" t-att-disabled="!ui.vehicleDraft.make_id">
                  <option value="">اختر الموديل</option>
                  <t t-foreach="allowedModels" t-as="model" t-key="model.id"><option t-att-value="model.id" t-esc="model.name"/></t>
                </select>
                <button type="button" class="btn btn-link btn-sm p-0 mt-1" t-att-disabled="!ui.vehicleDraft.make_id" t-on-click="() => this.ui.showModelCreate = !this.ui.showModelCreate">+ إنشاء موديل لهذه الشركة</button>
                <div t-if="ui.showModelCreate &amp;&amp; ui.vehicleDraft.make_id" class="input-group mt-2">
                  <input class="form-control" placeholder="اسم الموديل الجديد" t-model="ui.newModelName"/>
                  <button type="button" class="btn btn-outline-primary" t-att-disabled="ui.savingCatalog || !ui.newModelName.trim()" t-on-click="createModel">إنشاء واختيار</button>
                </div>
              </div>
              <div class="col-md-3"><label class="form-label">سنة الصنع</label><input class="form-control" type="number" min="1886" t-model="ui.vehicleDraft.year"/></div>
              <div class="col-md-3"><label class="form-label">نوع الجير</label><select class="form-select" t-model="ui.vehicleDraft.transmission"><option value="">غير محدد</option><option value="automatic">أوتوماتيك</option><option value="manual">عادي</option><option value="cvt">CVT</option><option value="other">أخرى</option></select></div>
              <div class="col-md-4"><label class="form-label">اللون</label><input class="form-control" t-model="ui.vehicleDraft.color"/></div>
              <div class="col-md-4"><label class="form-label">رقم المحرك</label><input class="form-control" t-model="ui.vehicleDraft.engine_number"/></div>
              <div class="col-md-4"><label class="form-label">قراءة العداد</label><input class="form-control" type="number" min="0" t-model="ui.vehicleDraft.odometer"/></div>
            </div>
          </div>
          <div class="modal-footer"><button type="button" class="btn btn-secondary" t-on-click="() => this.ui.showVehicleModal = false">إلغاء</button><button type="button" class="btn btn-primary" t-att-disabled="ui.savingVehicle" t-on-click="saveVehicle">حفظ واختيار السيارة</button></div>
        </div>
      </div>
    </div>
  </div>
</t></templates>
