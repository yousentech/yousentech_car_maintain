<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

 <!-- Reusable bits -->
 <t t-name="yousentech_car_maintain.MrBadge">
  <span t-attf-class="o_yt_mr_badge #{cls}"><i/><t t-esc="label"/></span>
 </t>

 <t t-name="yousentech_car_maintain.MaintenanceReport">
  <div class="o_yt_mr" dir="rtl">
   <t t-if="state.loading and !state.data"><div class="o_yt_mr_page"><div class="o_yt_mr_state">جاري تحميل التقرير…</div></div></t>
   <t t-elif="state.error"><div class="o_yt_mr_page"><div class="o_yt_mr_state" role="alert"><i class="fa fa-info-circle"/> <t t-esc="state.error"/></div></div></t>
   <t t-elif="state.data">
    <t t-set="d" t-value="state.data"/>
    <div class="o_yt_mr_page">

     <!-- =================== Vehicle detail =================== -->
     <t t-if="type === 'customer' and state.vehicle">
      <t t-set="v" t-value="state.vehicle"/>
      <header class="o_yt_mr_hero">
       <div class="o_yt_mr_hero_main">
        <nav class="o_yt_mr_crumb"><a href="#" t-on-click.prevent="closeVehicle"><i class="fa fa-angle-right"/> سجل صيانة سيارات العميل</a><span>/</span><t t-esc="v.owner"/></nav>
        <div class="o_yt_mr_hero_title">
         <span class="o_yt_mr_hero_icon"><i class="fa fa-car"/></span>
         <div><h1 t-esc="v.title"/><div class="o_yt_mr_hero_meta"><span class="o_yt_mr_plate" dir="ltr" t-esc="v.plate"/><span t-if="v.vin"><i class="fa fa-barcode"/> <t t-esc="v.vin"/></span><span t-if="v.color"><i class="fa fa-tint"/> <t t-esc="v.color"/></span></div></div>
        </div>
       </div>
       <div class="o_yt_mr_hero_box"><small>آخر ممشى مسجل بأمر العمل</small><strong t-esc="v.odo"/><small t-if="v.odo_date" t-esc="v.odo_date"/></div>
       <div class="o_yt_mr_hero_actions">
        <button class="o_yt_mr_hbtn" t-on-click="() => this.printPdf(v.id)"><i class="fa fa-file-pdf-o"/> PDF للعميل</button>
        <button t-if="canFollow" class="o_yt_mr_hbtn o_yt_mr_hbtn_solid" t-on-click="() => this.openFollowup(v.id, v.partner_id, false)"><i class="fa fa-phone"/> تسجيل متابعة</button>
       </div>
      </header>

      <div class="o_yt_mr_grid2">
       <section t-foreach="v.tracks" t-as="t" t-key="t.key" t-attf-class="o_yt_mr_panel o_yt_mr_track is-#{t.status}">
        <div class="o_yt_mr_panel_head">
         <span class="o_yt_mr_panel_icon"><i t-attf-class="fa #{t.is_oil ? 'fa-tint' : 'fa-wrench'}"/></span>
         <div class="o_yt_mr_panel_title"><h2 t-esc="t.name"/></div>
         <t t-call="yousentech_car_maintain.MrBadge"><t t-set="cls" t-value="t.cls"/><t t-set="label" t-value="t.label"/></t>
        </div>
        <dl class="o_yt_mr_kv">
         <div><dt>آخر تنفيذ</dt><dd t-esc="t.last"/></div>
         <div t-if="t.is_oil"><dt>الصنف</dt><dd t-esc="t.product or '—'"/></div>
         <div t-if="!t.is_oil"><dt>الفترة المحددة</dt><dd t-esc="t.interval or '—'"/></div>
         <div><dt>الموعد القادم</dt><dd t-esc="t.next"/></div>
        </dl>
        <table t-if="t.is_oil and t.log.length" class="o_yt_mr_table o_yt_mr_table_mini">
         <thead><tr><th>تاريخ التغيير</th><th>الممشى</th><th>الصنف</th></tr></thead>
         <tbody><tr t-foreach="t.log" t-as="l" t-key="l_index"><td t-esc="l.date"/><td t-esc="l.odo"/><td><t t-esc="l.product"/><span t-if="l.history" class="o_yt_mr_tag">ترحيل تاريخي</span></td></tr></tbody>
        </table>
        <div t-if="canFollow and (t.status === 'due' or t.status === 'soon')" class="o_yt_mr_panel_foot">
         <button class="o_yt_mr_btn" t-on-click="() => this.openFollowup(v.id, v.partner_id, t.key)"><i class="fa fa-phone"/> متابعة هذا البند</button>
        </div>
       </section>
      </div>
      <p class="o_yt_mr_footnote"><i class="fa fa-info-circle"/> المتبقي = التاريخ أو الكيلو أيهما أقرب. الكيلو محسوب من آخر ممشى مسجل في الورشة، وليس من ممشى السيارة الحالي.</p>

      <section class="o_yt_mr_panel">
       <div class="o_yt_mr_tabs" role="tablist">
        <button role="tab" t-att-aria-selected="state.tab === 'timeline' ? 'true' : 'false'" t-attf-class="o_yt_mr_tab #{state.tab === 'timeline' ? 'active' : ''}" t-on-click="() => this.setTab('timeline')"><i class="fa fa-history"/> الخط الزمني <span class="o_yt_mr_count" t-esc="v.timeline.length"/></button>
        <button role="tab" t-att-aria-selected="state.tab === 'inspection' ? 'true' : 'false'" t-attf-class="o_yt_mr_tab #{state.tab === 'inspection' ? 'active' : ''}" t-on-click="() => this.setTab('inspection')"><i class="fa fa-search"/> آخر فحص <span class="o_yt_mr_count" t-esc="v.inspection.lines.length"/></button>
        <button role="tab" t-att-aria-selected="state.tab === 'followups' ? 'true' : 'false'" t-attf-class="o_yt_mr_tab #{state.tab === 'followups' ? 'active' : ''}" t-on-click="() => this.setTab('followups')"><i class="fa fa-comments-o"/> المتابعات <span class="o_yt_mr_count" t-esc="v.followups.length"/></button>
       </div>
       <div t-if="state.tab === 'timeline'" class="o_yt_mr_table_wrap">
        <table class="o_yt_mr_table">
         <thead><tr><th>التاريخ</th><th>أمر العمل</th><th>الأعمال</th><th>التفاصيل</th><th>الحالة</th></tr></thead>
         <tbody>
          <tr t-if="!v.timeline.length"><td colspan="5" class="o_yt_mr_empty">لا توجد أوامر عمل ضمن الفترة.</td></tr>
          <tr t-foreach="v.timeline" t-as="o" t-key="o.id">
           <td class="o_yt_mr_nowrap" t-esc="o.date"/>
           <td class="o_yt_mr_nowrap"><a href="#" t-on-click.prevent="() => this.openOrder(o.id)" t-esc="o.name"/></td>
           <td class="o_yt_mr_strong" t-esc="o.services"/>
           <td class="o_yt_mr_muted" t-esc="o.meta"/>
           <td><t t-call="yousentech_car_maintain.MrBadge"><t t-set="cls" t-value="o.cls"/><t t-set="label" t-value="o.state"/></t></td>
          </tr>
         </tbody>
        </table>
       </div>
       <div t-if="state.tab === 'inspection'" class="o_yt_mr_table_wrap">
        <div class="o_yt_mr_subhead" t-if="v.inspection.order">آخر فحص مكتمل <b t-esc="v.inspection.date"/> · <a href="#" t-on-click.prevent="() => this.openOrder(v.inspection.order_id)" t-esc="v.inspection.order"/><t t-if="v.inspection.employee"> · فني الفحص: <t t-esc="v.inspection.employee"/></t></div>
        <table class="o_yt_mr_table">
         <thead><tr><th>المكون</th><th>الملاحظة</th><th>النتيجة</th></tr></thead>
         <tbody>
          <tr t-if="!v.inspection.order"><td colspan="3" class="o_yt_mr_empty">لا يوجد فحص مكتمل لهذه السيارة.</td></tr>
          <tr t-elif="!v.inspection.lines.length"><td colspan="3" class="o_yt_mr_empty">لا توجد بنود تحتاج متابعة.</td></tr>
          <tr t-foreach="v.inspection.lines" t-as="l" t-key="l_index">
           <td class="o_yt_mr_strong" t-esc="l.name"/><td class="o_yt_mr_muted" t-esc="l.note"/>
           <td><t t-call="yousentech_car_maintain.MrBadge"><t t-set="cls" t-value="l.cls"/><t t-set="label" t-value="l.status"/></t></td>
          </tr>
         </tbody>
        </table>
       </div>
       <div t-if="state.tab === 'followups'" class="o_yt_mr_table_wrap">
        <table class="o_yt_mr_table">
         <thead><tr><th>التاريخ</th><th>النتيجة</th><th>المسار</th><th>الملاحظة</th><th>المتابعة القادمة</th><th>الموظف</th></tr></thead>
         <tbody>
          <tr t-if="!v.followups.length"><td colspan="6" class="o_yt_mr_empty">لا توجد متابعات مسجلة.</td></tr>
          <tr t-foreach="v.followups" t-as="f" t-key="f_index">
           <td class="o_yt_mr_nowrap" t-esc="f.date"/><td class="o_yt_mr_strong" t-esc="f.result"/><td t-esc="f.track or '—'"/>
           <td class="o_yt_mr_muted" t-esc="f.note or '—'"/><td t-esc="f.next or '—'"/><td t-esc="f.user"/>
          </tr>
         </tbody>
        </table>
       </div>
      </section>
     </t>

     <!-- =================== Customer page =================== -->
     <t t-elif="type === 'customer'">
      <header class="o_yt_mr_hero">
       <div class="o_yt_mr_hero_main">
        <nav class="o_yt_mr_crumb"><span>التقارير</span><span>/</span><span>سجل صيانة سيارات العميل</span></nav>
        <div class="o_yt_mr_hero_title">
         <span class="o_yt_mr_hero_icon o_yt_mr_avatar" t-esc="d.partner.initials"/>
         <div><h1><t t-esc="d.partner.name"/> <span class="o_yt_mr_pill" t-esc="d.partner.type"/></h1>
          <div class="o_yt_mr_hero_meta"><span t-if="d.partner.mobile" dir="ltr"><i class="fa fa-mobile"/> <t t-esc="d.partner.mobile"/></span><span><i class="fa fa-filter"/> <t t-esc="d.filters"/></span><a href="#" t-on-click.prevent="editFilters">تعديل الفلاتر</a></div>
         </div>
        </div>
       </div>
       <div class="o_yt_mr_hero_stats">
        <div class="o_yt_mr_hero_box"><small>السيارات</small><strong t-esc="d.stats.vehicles"/></div>
        <div class="o_yt_mr_hero_box"><small>الزيارات</small><strong t-esc="d.stats.visits"/></div>
        <div class="o_yt_mr_hero_box"><small>أوامر مكتملة</small><strong t-esc="d.stats.orders"/></div>
       </div>
       <div class="o_yt_mr_hero_actions">
        <a t-if="d.partner.tel" class="o_yt_mr_hbtn" t-att-href="d.partner.tel"><i class="fa fa-phone"/> اتصال</a>
        <a t-if="d.partner.whatsapp" class="o_yt_mr_hbtn" t-att-href="d.partner.whatsapp" target="_blank" rel="noopener"><i class="fa fa-whatsapp"/> واتساب</a>
       </div>
      </header>

      <div class="o_yt_mr_layout">
       <section class="o_yt_mr_panel o_yt_mr_layout_main">
        <div class="o_yt_mr_panel_head">
         <span class="o_yt_mr_panel_icon"><i class="fa fa-car"/></span>
         <div class="o_yt_mr_panel_title"><h2>السيارات</h2><p>حالة الصيانة الدورية لكل سيارة</p></div>
         <span class="o_yt_mr_count" t-esc="d.vehicles.length"/>
        </div>
        <div t-if="!d.vehicles.length" class="o_yt_mr_empty">لا توجد سيارات مرتبطة بالعميل.</div>
        <div class="o_yt_mr_vehicles">
         <article t-foreach="d.vehicles" t-as="c" t-key="c.id" class="o_yt_mr_vehicle">
          <div class="o_yt_mr_vehicle_head">
           <div class="o_yt_mr_panel_title"><h3 t-esc="c.title"/><p><t t-esc="c.odo"/><t t-if="c.last_visit"> · آخر زيارة <t t-esc="c.last_visit"/></t></p></div>
           <span class="o_yt_mr_plate" dir="ltr" t-esc="c.plate"/>
          </div>
          <ul class="o_yt_mr_tracklist">
           <t t-foreach="c.tracks" t-as="t" t-key="t.key">
            <li t-if="!t.is_oil or t.status !== 'na'"><span t-esc="t.name"/><t t-call="yousentech_car_maintain.MrBadge"><t t-set="cls" t-value="t.cls"/><t t-set="label" t-value="t.label"/></t></li>
           </t>
          </ul>
          <div class="o_yt_mr_vehicle_foot">
           <span class="o_yt_mr_muted"><t t-esc="c.visits"/> زيارة · <t t-esc="c.orders"/> أمر مكتمل</span>
           <button class="o_yt_mr_btn" t-on-click="() => this.openVehicle(c.id)">سجل السيارة <i class="fa fa-angle-left"/></button>
          </div>
         </article>
        </div>
       </section>

       <aside class="o_yt_mr_panel o_yt_mr_layout_side">
        <div class="o_yt_mr_panel_head">
         <span class="o_yt_mr_panel_icon is-warn"><i class="fa fa-bell"/></span>
         <div class="o_yt_mr_panel_title"><h2>تحتاج متابعة</h2><p>محسوبة على اليوم <t t-esc="d.today"/></p></div>
         <span class="o_yt_mr_count" t-esc="d.alerts.length"/>
        </div>
        <div t-if="!d.alerts.length" class="o_yt_mr_empty"><i class="fa fa-check-circle"/> لا توجد استحقاقات متأخرة أو قريبة.</div>
        <ul class="o_yt_mr_alerts">
         <li t-foreach="d.alerts" t-as="a" t-key="a_index" t-attf-class="is-#{a.status}">
          <div class="o_yt_mr_alert_text"><b t-esc="a.track"/><span dir="ltr" class="o_yt_mr_plate o_yt_mr_plate_sm" t-esc="a.plate"/><small>الموعد: <t t-esc="a.next"/></small></div>
          <div class="o_yt_mr_alert_side">
           <t t-call="yousentech_car_maintain.MrBadge"><t t-set="cls" t-value="a.cls"/><t t-set="label" t-value="a.label"/></t>
           <button t-if="canFollow" class="o_yt_mr_link" t-on-click="() => this.openFollowup(a.vehicle_id, d.partner.id, a.track_key)">متابعة</button>
          </div>
         </li>
        </ul>
        <p class="o_yt_mr_footnote">المتبقي = التاريخ أو الكيلو أيهما أقرب، من آخر ممشى مسجل.</p>
       </aside>
      </div>
     </t>

     <!-- =================== Dues =================== -->
     <t t-elif="type === 'upcoming' or type === 'overdue'">
      <header class="o_yt_mr_hero">
       <div class="o_yt_mr_hero_main">
        <nav class="o_yt_mr_crumb"><span>التقارير</span><span>/</span><span>متابعة العملاء</span></nav>
        <div class="o_yt_mr_hero_title">
         <span class="o_yt_mr_hero_icon"><i t-attf-class="fa #{type === 'overdue' ? 'fa-exclamation-triangle' : 'fa-calendar'}"/></span>
         <div><h1 t-esc="d.title"/><div class="o_yt_mr_hero_meta"><span><i class="fa fa-filter"/> <t t-esc="d.filters"/></span><span><i class="fa fa-clock-o"/> محسوبة على اليوم <t t-esc="d.today"/></span><a href="#" t-on-click.prevent="editFilters">تعديل الفلاتر</a></div></div>
        </div>
       </div>
       <div class="o_yt_mr_hero_stats">
        <div class="o_yt_mr_hero_box"><small>البنود</small><strong t-esc="d.rows.length"/></div>
        <div t-if="type === 'overdue'" class="o_yt_mr_hero_box"><small>متأخر</small><strong t-esc="d.counts.due or 0"/></div>
        <div t-if="type === 'upcoming'" class="o_yt_mr_hero_box"><small>قريب الاستحقاق</small><strong t-esc="d.counts.soon or 0"/></div>
       </div>
      </header>
      <section class="o_yt_mr_panel">
       <div class="o_yt_mr_panel_head">
        <span class="o_yt_mr_panel_icon"><i class="fa fa-list-ul"/></span>
        <div class="o_yt_mr_panel_title"><h2>قائمة الاتصال</h2><p>الأكثر تأخراً أولاً</p></div>
       </div>
       <div class="o_yt_mr_table_wrap">
        <table class="o_yt_mr_table">
         <thead><tr><th>الحالة</th><th>المسار</th><th>السيارة</th><th>العميل</th><th>الجوال</th><th>الموعد</th><th>الفرع</th><th class="o_yt_mr_actions_col">تواصل</th></tr></thead>
         <tbody>
          <tr t-if="!d.rows.length"><td colspan="8" class="o_yt_mr_empty"><i class="fa fa-check-circle"/> لا توجد بنود مطابقة.</td></tr>
          <tr t-foreach="d.rows" t-as="r" t-key="r_index">
           <td><t t-call="yousentech_car_maintain.MrBadge"><t t-set="cls" t-value="r.cls"/><t t-set="label" t-value="r.label"/></t></td>
           <td class="o_yt_mr_strong" t-esc="r.track"/>
           <td><span class="o_yt_mr_plate o_yt_mr_plate_sm" dir="ltr" t-esc="r.plate"/> <span class="o_yt_mr_muted" t-esc="r.vehicle"/></td>
           <td t-esc="r.customer"/>
           <td dir="ltr" class="o_yt_mr_nowrap" t-esc="r.mobile or '—'"/>
           <td class="o_yt_mr_muted" t-esc="r.next"/>
           <td class="o_yt_mr_muted" t-esc="r.branch"/>
           <td class="o_yt_mr_actions_col">
            <a t-if="r.whatsapp" class="o_yt_mr_icon is-wa" t-att-href="r.whatsapp" target="_blank" rel="noopener" aria-label="واتساب" title="واتساب"><i class="fa fa-whatsapp"/></a>
            <a t-if="r.tel" class="o_yt_mr_icon" t-att-href="r.tel" aria-label="اتصال" title="اتصال"><i class="fa fa-phone"/></a>
            <button t-if="canFollow" class="o_yt_mr_link" t-on-click="() => this.openFollowup(r.vehicle_id, r.partner_id, r.track_key)">متابعة</button>
           </td>
          </tr>
         </tbody>
        </table>
       </div>
      </section>
     </t>

     <!-- =================== Lapsed customers =================== -->
     <t t-elif="type === 'lapsed'">
      <header class="o_yt_mr_hero">
       <div class="o_yt_mr_hero_main">
        <nav class="o_yt_mr_crumb"><span>التقارير</span><span>/</span><span>متابعة العملاء</span></nav>
        <div class="o_yt_mr_hero_title">
         <span class="o_yt_mr_hero_icon"><i class="fa fa-user-times"/></span>
         <div><h1>العملاء المنقطعون</h1><div class="o_yt_mr_hero_meta"><span><i class="fa fa-filter"/> <t t-esc="d.filters"/></span><a href="#" t-on-click.prevent="editFilters">تعديل الفلاتر</a></div></div>
        </div>
       </div>
       <div class="o_yt_mr_hero_stats">
        <div class="o_yt_mr_hero_box"><small>عملاء منقطعون</small><strong t-esc="d.rows.length"/></div>
        <div class="o_yt_mr_hero_box"><small>بلا زيارة منذ أكثر من</small><strong><t t-esc="d.lapsed_days"/> يوم</strong></div>
       </div>
      </header>
      <section class="o_yt_mr_panel">
       <div class="o_yt_mr_panel_head">
        <span class="o_yt_mr_panel_icon"><i class="fa fa-list-ul"/></span>
        <div class="o_yt_mr_panel_title"><h2>قائمة العملاء</h2><p>الأطول انقطاعاً أولاً</p></div>
       </div>
       <div class="o_yt_mr_table_wrap">
        <table class="o_yt_mr_table">
         <thead><tr><th>العميل</th><th>الجوال</th><th>آخر زيارة</th><th>الانقطاع</th><th>السيارات</th><th>أوامر مكتملة</th><th class="o_yt_mr_actions_col">تواصل</th></tr></thead>
         <tbody>
          <tr t-if="!d.rows.length"><td colspan="7" class="o_yt_mr_empty"><i class="fa fa-check-circle"/> لا يوجد عملاء منقطعون حسب المدة المحددة.</td></tr>
          <tr t-foreach="d.rows" t-as="r" t-key="r.partner_id">
           <td class="o_yt_mr_strong" t-esc="r.customer"/>
           <td dir="ltr" class="o_yt_mr_nowrap" t-esc="r.mobile or '—'"/>
           <td class="o_yt_mr_nowrap" t-esc="r.last_visit"/>
           <td><span class="o_yt_mr_badge b-due"><i/>منذ <t t-esc="r.days"/> يوم</span></td>
           <td t-esc="r.vehicles"/><td t-esc="r.orders"/>
           <td class="o_yt_mr_actions_col">
            <a t-if="r.whatsapp" class="o_yt_mr_icon is-wa" t-att-href="r.whatsapp" target="_blank" rel="noopener" aria-label="واتساب" title="واتساب"><i class="fa fa-whatsapp"/></a>
            <a t-if="r.tel" class="o_yt_mr_icon" t-att-href="r.tel" aria-label="اتصال" title="اتصال"><i class="fa fa-phone"/></a>
           </td>
          </tr>
         </tbody>
        </table>
       </div>
      </section>
     </t>

     <!-- =================== Statement =================== -->
     <t t-elif="type === 'statement'">
      <header class="o_yt_mr_hero">
       <div class="o_yt_mr_hero_main">
        <nav class="o_yt_mr_crumb"><span>التقارير</span><span>/</span><span>كشف حساب العميل لدى الورشة</span></nav>
        <div class="o_yt_mr_hero_title">
         <span class="o_yt_mr_hero_icon o_yt_mr_avatar" t-esc="d.partner.initials"/>
         <div><h1><t t-esc="d.partner.name"/> <span class="o_yt_mr_pill" t-esc="d.partner.type"/></h1><div class="o_yt_mr_hero_meta"><span><i class="fa fa-filter"/> <t t-esc="d.filters"/></span><a href="#" t-on-click.prevent="editFilters">تعديل الفلاتر</a></div></div>
        </div>
       </div>
      </header>
      <div class="o_yt_mr_kpis">
       <div t-foreach="d.kpis" t-as="k" t-key="k_index" t-attf-class="o_yt_mr_kpi #{k_last ? 'is-balance' : ''}">
        <small t-esc="k.label"/><strong t-esc="k.value"/><span t-esc="k.hint"/>
       </div>
      </div>
      <p t-if="d.to_refund or d.refunded" class="o_yt_mr_notice"><i class="fa fa-info-circle"/>
       <t t-if="d.refunded"> مبالغ مردودة للعميل ضمن الفترة: <b t-esc="d.refunded"/>.</t>
       <t t-if="d.to_refund"> مستحق رده للعميل حتى اليوم: <b t-esc="d.to_refund"/>.</t>
      </p>
      <div class="o_yt_mr_grid2 o_yt_mr_grid2_wide">
       <section class="o_yt_mr_panel">
        <div class="o_yt_mr_panel_head">
         <span class="o_yt_mr_panel_icon"><i class="fa fa-exchange"/></span>
         <div class="o_yt_mr_panel_title"><h2>الحركات ضمن الفترة</h2><p>فواتير، إشعارات دائنة، تحصيل ورد</p></div>
         <span class="o_yt_mr_count" t-esc="d.movements.length"/>
        </div>
        <div class="o_yt_mr_table_wrap">
         <table class="o_yt_mr_table">
          <thead><tr><th>التاريخ</th><th>النوع</th><th>المرجع</th><th>أمر العمل</th><th class="o_yt_mr_num">المبلغ</th></tr></thead>
          <tbody>
           <tr t-if="!d.movements.length"><td colspan="5" class="o_yt_mr_empty">لا توجد حركات ضمن الفترة.</td></tr>
           <tr t-foreach="d.movements" t-as="m" t-key="m_index"><td class="o_yt_mr_nowrap" t-esc="m.date"/><td class="o_yt_mr_strong" t-esc="m.type"/><td t-esc="m.ref"/><td class="o_yt_mr_muted" t-esc="m.order"/><td class="o_yt_mr_num" t-esc="m.amount"/></tr>
          </tbody>
         </table>
        </div>
       </section>
       <section class="o_yt_mr_panel">
        <div class="o_yt_mr_panel_head">
         <span class="o_yt_mr_panel_icon"><i class="fa fa-file-text-o"/></span>
         <div class="o_yt_mr_panel_title"><h2>أوامر العمل والرصيد القائم</h2><p>حتى اليوم</p></div>
         <span class="o_yt_mr_count" t-esc="d.orders.length"/>
        </div>
        <div class="o_yt_mr_table_wrap">
         <table class="o_yt_mr_table">
          <thead><tr><th>أمر العمل</th><th>الوصول</th><th>السيارة</th><th class="o_yt_mr_num">صافي الفوترة</th><th class="o_yt_mr_num">المستحق</th></tr></thead>
          <tbody>
           <tr t-if="!d.orders.length"><td colspan="5" class="o_yt_mr_empty">لا توجد أوامر عمل.</td></tr>
           <tr t-foreach="d.orders" t-as="o" t-key="o.id"><td class="o_yt_mr_nowrap"><a href="#" t-on-click.prevent="() => this.openOrder(o.id)" t-esc="o.name"/></td><td class="o_yt_mr_nowrap" t-esc="o.date"/><td><span class="o_yt_mr_plate o_yt_mr_plate_sm" dir="ltr" t-esc="o.vehicle"/></td><td class="o_yt_mr_num" t-esc="o.invoiced"/><td class="o_yt_mr_num o_yt_mr_strong" t-esc="o.due"/></tr>
          </tbody>
         </table>
        </div>
       </section>
      </div>
     </t>

    </div>
   </t>
  </div>
 </t>
</templates>
