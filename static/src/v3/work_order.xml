<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="yousentech_car_maintain.WorkshopV3Order">
  <div class="o_workshop_v3" dir="auto">
    <header class="o_workshop_v3_header">
      <div>
        <div class="o_workshop_v3_eyebrow">إدارة الورشة / Workshop</div>
        <h2>أمر العمل <span t-esc="displayName"/></h2>
        <span t-if="order" class="o_workshop_v3_status" t-esc="order.state"/>
      </div>
      <button class="btn btn-outline-secondary" t-on-click="openLegacy">تفاصيل إضافية</button>
    </header>
    <div t-if="state.loading" class="o_workshop_v3_panel">جاري تحميل أمر العمل…</div>
    <div t-elif="state.error" class="alert alert-danger" t-esc="state.error"/>
    <t t-elif="order">
      <section class="o_workshop_v3_summary">
        <div class="o_workshop_v3_panel"><h5>العميل</h5><strong t-esc="order.partner_id?.[1] || '—'"/><p t-esc="order.partner_mobile || '—'"/></div>
        <div class="o_workshop_v3_panel"><h5>السيارة</h5><strong t-esc="order.car_model || '—'"/><p t-esc="order.car_panel_no || '—'"/><small t-esc="order.vin_no || '—'"/></div>
        <div class="o_workshop_v3_panel"><h5>بيانات الأمر</h5><strong t-esc="displayName"/><p t-esc="order.create_date || '—'"/><small t-esc="order.company_id?.[1] || '—'"/></div>
      </section>
      <div t-if="!editable" class="alert alert-light border">هذا الأمر للعرض فقط بعد البيع أو الفوترة أو الإلغاء.</div>
      <section class="o_workshop_v3_columns">
        <div class="o_workshop_v3_panel">
          <div class="o_workshop_v3_section_header"><h4>الخدمات <span t-esc="serviceCount"/></h4><strong t-esc="serviceSubtotal.toFixed(2)"/></div>
          <div class="o_workshop_v3_add" t-if="editable">
            <input class="form-control" placeholder="ابحث عن خدمة..." t-model="state.serviceSearch" t-on-input="(ev) => this.onSearch('service', ev)"/>
            <select class="form-select" t-model="state.serviceProduct"><option value="">اختر الخدمة</option><option t-foreach="state.serviceOptions" t-as="p" t-key="p.id" t-att-value="p.id" t-esc="p.display_name"/></select>
            <button class="btn btn-primary" t-att-disabled="state.busy || !state.serviceProduct" t-on-click="() => this.addLine('service')">إضافة خدمة</button>
          </div>
          <div class="o_workshop_v3_tablewrap"><table class="table table-sm"><thead><tr><th>الخدمة</th><th>السعر</th><th>الإجمالي</th><th t-if="editable"></th></tr></thead><tbody>
            <tr t-foreach="state.services" t-as="line" t-key="line.id">
              <td t-esc="line.product_id?.[1] || '—'"/>
              <td><input class="form-control form-control-sm" type="number" min="0" step="any" t-att-value="line.unit_price" t-att-disabled="state.busy || !editable" t-on-change="(ev) => this.changeLine('service', line.id, 'unit_price', ev)"/></td>
              <td t-esc="line.total"/>
              <td t-if="editable"><button class="btn btn-sm btn-outline-danger" t-att-disabled="state.busy" t-on-click="() => this.removeLine('service', line.id)">حذف</button></td>
            </tr>
            <tr t-if="!serviceCount"><td colspan="4" class="o_workshop_v3_empty">لا توجد خدمات مضافة</td></tr>
          </tbody></table></div>
        </div>
        <div class="o_workshop_v3_panel">
          <div class="o_workshop_v3_section_header"><h4>قطع الغيار <span t-esc="partCount"/></h4><strong t-esc="partSubtotal.toFixed(2)"/></div>
          <div class="o_workshop_v3_add" t-if="editable">
            <input class="form-control" placeholder="ابحث عن قطعة..." t-model="state.partSearch" t-on-input="(ev) => this.onSearch('part', ev)"/>
            <select class="form-select" t-model="state.partProduct"><option value="">اختر قطعة الغيار</option><option t-foreach="state.partOptions" t-as="p" t-key="p.id" t-att-value="p.id" t-esc="p.display_name"/></select>
            <input type="number" min="0.01" step="any" class="form-control o_workshop_v3_qty" aria-label="الكمية" t-model="state.partQty"/>
            <button class="btn btn-primary" t-att-disabled="state.busy || !state.partProduct" t-on-click="() => this.addLine('part')">إضافة قطعة</button>
          </div>
          <div class="o_workshop_v3_tablewrap"><table class="table table-sm"><thead><tr><th>القطعة</th><th>الكمية</th><th>السعر</th><th>الإجمالي</th><th t-if="editable"></th></tr></thead><tbody>
            <tr t-foreach="state.parts" t-as="line" t-key="line.id">
              <td t-esc="line.product_id?.[1] || '—'"/>
              <td><input class="form-control form-control-sm" type="number" min="0.01" step="any" t-att-value="line.qty_done" t-att-disabled="state.busy || !editable" t-on-change="(ev) => this.changeLine('part', line.id, 'qty_done', ev)"/></td>
              <td><input class="form-control form-control-sm" type="number" min="0" step="any" t-att-value="line.unit_price" t-att-disabled="state.busy || !editable" t-on-change="(ev) => this.changeLine('part', line.id, 'unit_price', ev)"/></td>
              <td t-esc="line.total"/>
              <td t-if="editable"><button class="btn btn-sm btn-outline-danger" t-att-disabled="state.busy" t-on-click="() => this.removeLine('part', line.id)">حذف</button></td>
            </tr>
            <tr t-if="!partCount"><td colspan="5" class="o_workshop_v3_empty">لا توجد قطع غيار مضافة</td></tr>
          </tbody></table></div>
        </div>
      </section>
      <section class="o_workshop_v3_panel o_workshop_v3_totals">
        <div><small>قبل الضريبة</small><strong t-esc="order.total_all_before_tax"/></div>
        <div><small>الضريبة</small><strong t-esc="order.total_tax"/></div>
        <div><small>الدفعة المقدمة</small><strong t-esc="order.advance_amount"/></div>
        <div class="o_workshop_v3_grand"><small>الإجمالي</small><strong t-esc="order.total_all_with_tax"/></div>
      </section>
    </t>
  </div>
</t>
</templates>