<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="checkup_res_config_settings_view_form" model="ir.ui.view">
            <field name="name">checkup.res.config.settings.view.form.inherit</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="109" />
            <field name="inherit_id" ref="yousentech_invoicing.res_config_settings_invoicing_form" />
            <field name="arch" type="xml">
                <xpath expr="/form" position="inside">
                    <app data-string="نظام الصيانة" string="نظام الصيانة" name="work_order_car" >
                            <div id="business_documents" position="after">
                                <h2>اعدادات نظام الفحص</h2>
                                <div class="row mt16 o_settings_container" name="work_order">

                                    <div class="col-12 col-lg-6 o_setting_box">
                                        <div class="o_setting_left_pane">
                                            <field name="discount_posted" />
                                        </div>
                                        <div class="o_setting_right_pane">
                                            <label for="discount_posted" />
                                            <div class="text-muted">ترحيل الخصم على مستوى الفاتورة
                                                من امر الفحص الى ام البيع</div>
                                        </div>
                                    </div>

                                    <div class="col-12 col-lg-6 o_setting_box">
                                        <div class="o_setting_left_pane">
                                            <field name="car_no" />
                                        </div>
                                        <div class="o_setting_right_pane">
                                            <label for="car_no" />
                                            <div class="text-muted">السماح بادخال رقم لوحة السيارة</div>
                                        </div>
                                    </div>

                                    <div class="col-12 col-lg-6 o_setting_box">
                                        <div class="o_setting_left_pane">
                                            <field name="vin_no" />
                                        </div>
                                        <div class="o_setting_right_pane">
                                            <label for="vin_no" />
                                            <div class="text-muted">السماح بادخال رقم الشاصي للسيارة</div>
                                        </div>
                                    </div>

                                    <div class="col-12 col-lg-6 o_setting_box">
                                        <div class="o_setting_left_pane">
                                            <field name="compelete_done_date_not_required" />
                                        </div>
                                        <div class="o_setting_right_pane">
                                            <label for="compelete_done_date_not_required" />
                                            <div class="text-muted">تاريخ اكتمال التفيذ غير اجباري</div>
                                        </div>
                                    </div>

                                    <div class="col-12 col-lg-6 o_setting_box">
                                        <div class="o_setting_left_pane">
                                            <field name="partner_mobile_not_required" />
                                        </div>
                                        <div class="o_setting_right_pane">
                                            <label for="partner_mobile_not_required" />
                                            <div class="text-muted">ادخال رقم جوال العميل</div>
                                        </div>
                                    </div>

                              
                                    <div class="col-12 col-lg-6 o_setting_box">
                                        <div class="o_setting_left_pane">
                                            <field name="collecting_products" />
                                        </div>
                                        <div class="o_setting_right_pane">
                                            <label for="collecting_products" />
                                            <div class="text-muted">طباعة اصناف الفاتورة</div>
                                        </div>
                                    </div>

                                    <div class="col-12 col-lg-6 o_setting_box">
                                        <div class="o_setting_left_pane">
                                            <field name="service_price_include_tax" />
                                        </div>
                                        <div class="o_setting_right_pane">
                                            <label for="service_price_include_tax" />
                                            <div class="text-muted">طريقة احتساب الضريبة في نظام
                                                الفحص</div>
                                        </div>
                                    </div>

                                    <div class="col-12 col-lg-6 o_setting_box">
                                        <div class="o_setting_left_pane">
                                            <field name="car_type" />
                                        </div>
                                        <div class="o_setting_right_pane">
                                            <label for="car_type" />
                                            <div class="text-muted">نوع السيارة</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                    </app>
                </xpath>
            </field>
        </record>
    </data>
</odoo>