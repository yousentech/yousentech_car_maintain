<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="work_order_report_view">
        <t t-if="o and 'company_id' in o">
            <t t-set="company" t-value="o.company_id"></t>
        </t>
        <t t-if="not o or not 'company_id' in o">
            <t t-set="company" t-value="res_company"></t>
        </t>

        <t t-call="web.html_container">

            <t t-call="web.external_layout">
                <style>
                    table {
                    border-collapse: collapse;
                    width: 100%;
                    font-size:9px;
                    }
                    #t01 th, td {
                    text-align: left;
                    padding: 3px;
                    font-size:9px;
                    vertical-align: middle;
                    }
                </style>
                <style>
                    #customers {
                    border-collapse: collapse;
                    width: 100%;
                    border: 1px solid DarkOrange;

                    overflow:hidden
                    }

                    #supplier {
                    border-collapse: collapse;
                    width: 100%;
                    border: 1px solid DarkOrange;

                    overflow:hidden
                    }

                    #customers td, #customers th {
                    border: 1px solid gray;
                    padding: 5px;
                    text-align: right;
                    }

                    #supplier td, #supplier th {
                    border: 1px solid #D3D3D3;
                    padding: 8px;
                    text-align: right;
                    vertical-align: top;
                    }

                    #customers tr:nth-child(even){background-color: #F5F5F5;}

                    #customers tr:hover {background-color: #ddd;}

                    #customers th {
                    padding-top: 5px;
                    padding-bottom: 5px;
                    text-align: right;


                    }

                    #supplier th {
                    padding-top: 5px;
                    padding-bottom: 5px;
                    text-align: right;

                    }
                </style>
                <style>
                    #table1 {
                    border-collapse: collapse;
                    width: 100%;
                    font-size:9px;
                    }

                    #table1 th, #table1 td {
                    padding: 8px;
                    text-align: right;
                    font-size:9px;
                    }
                </style>
                <style>
                    #foo {
                    position:absolute;
                    bottom:300px;
                    right:0px;
                    }
                </style>

                <t t-foreach="docs" t-as="doc">
                    <div class="page">
                        <center>
                            <strong>تقرير امر عمل / Work Order Report</strong>
                        </center>

                        <table id="table1" style="font-size:11px;">
                            <tr>
                                <td
                                    style="vertical-align:top;font-size:11px; border-collapse: collapse;">
                                    <table id="table1" class="table table-sm table table-bordered"
                                        style="background-color:white;">
                                        <tr style="background-color:white;">

                                            <td
                                                style="vertical-align:top;font-size:11px; border-collapse: collapse;">
                                                <strong>رقم امر العمل </strong>
                                            </td>
                                            <td>
                                                <span t-esc="docs.id" />
                                            </td>
                                            <td>
                                                <strong> التاريخ </strong>
                                            </td>
                                            <td>
                                                <span t-esc="docs.create_date.strftime('%Y-%m-%d')" />
                                            </td>

                                            <td>
                                                <strong> الفرع </strong>
                                            </td>
                                            <td>
                                                <span t-esc="docs.entry_card_id.company_id.name" />
                                            </td>


                                        </tr>
                                        <tr style="background-color:white;">
                                            <td>
                                                <strong> اسم العميل </strong>
                                            </td>
                                            <td>
                                                <span t-esc="docs.partner_id.name" />
                                            </td>
                                            <td>
                                                <strong> الجوال </strong>
                                            </td>
                                            <td>
                                                <span t-esc="docs.partner_mobile" />
                                            </td>
                                            <td>
                                                <strong> رقم اللوحة </strong>
                                            </td>
                                            <td>
                                                <span t-esc="docs.car_panel_no" />
                                            </td>
                                        </tr>
                                        <tr style="background-color:white;">
                                            <td>
                                                <strong> نوع السيارة </strong>
                                            </td>
                                            <td>
                                                <span t-esc="docs.car_size_id.name" /> - <span
                                                    t-esc="docs.car_type_id.name" />
                                            </td>
                                            <td>
                                                <strong> رقم الشاصي </strong>
                                            </td>
                                            <td>
                                                <span t-esc="docs.vin_no" />
                                            </td>


                                        </tr>
                                    </table>
                                </td>

                            </tr>
                        </table>


                        <t t-set="l_line_cnt" t-value="0" />


                        <t t-if="docs.lines_spare_parts">
                            <stong> قطع الغيار </stong>

                            <table id="table1" class="table table-sm table table-bordered"
                                style="background-color:white;">
                                <thread>
                                    <th class="text-center" style="width: 20%">الرقم</th>
                                    <th class="text-center" style="width: 20%">الرمز</th>

                                    <th class="text-center" style="width: 20%">البيان</th>
                                    <th class="text-center" style="width: 20%">الكمية</th>
                                 
                                    <th class="text-center" style="width: 10%">السعر </th>
                                    <th class="text-center" style="width: 10%">الخصم </th>
                                    <th class="text-center" style="width: 10%">الضريبة </th>

                                    <th class="text-center" style="width: 10%">المبلغ</th>
                                </thread>
                                <tbody>
                                    <t t-foreach="docs.lines_spare_parts" t-as="line">
                                        <tr>
                                            <t t-set="l_line_cnt" t-value="l_line_cnt + 1" />
                                            <td>
                                                <span t-esc="l_line_cnt" />
                                            </td>
                                            <td>قطع غيار</td>

                                            <td>
                                                <span t-esc="line.name" />
                                            </td>
                                            <td>
                                                <span t-esc="line.qty_done" />
                                            </td>
                                            <td>
                                                <span t-esc="line.unit_price" />
                                            </td>
                                            <td>
                                                <span t-esc="line.discount_amount" />
                                            </td>
                                            <td>
                                                <span t-esc="line.product_tax.name" />
                                            </td>

                                            <td>
                                                <span t-esc="line.total_tax" />
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                                <tr>
                                    <td colspan="7">
                                        <strong> صافي المبلغ </strong>
                                    </td>
                                    <td>
                                        <span t-esc="docs.spare_parts_amt_after_tax" />
                                    </td>

                                </tr>
                                <tr>
                                    <td colspan="7">
                                        <strong>الدفعة المقدمة </strong>
                                    </td>
                                    <td>
                                        <span t-esc="docs.advance_amount" />
                                    </td>

                                </tr>
                            </table>
                        </t>
                        <t t-if="docs.result_lines">
                            <stong> الخدمات </stong>

                            <table id="table1" class="table table-sm table table-bordered"
                                style="background-color:white;">
                                <thread>
                                    <th class="text-center" style="width: 20%">الرقم</th>
                                    <th class="text-center" style="width: 20%">الرمز</th>

                                    <th class="text-center" style="width: 20%">البيان</th>
                                    <th class="text-center" style="width: 20%">الكمية</th>
                                  
                                    <th class="text-center" style="width: 10%">السعر </th>
                                    <th class="text-center" style="width: 10%">الخصم </th>
                                    <th class="text-center" style="width: 10%">الضريبة </th>

                                    <th class="text-center" style="width: 10%">المبلغ</th>
                                </thread>
                                <tbody>
                                    <t t-foreach="docs.result_lines" t-as="line">
                                        <tr>
                                            <t t-set="l_line_cnt" t-value="l_line_cnt + 1" />
                                            <td>
                                                <span t-esc="l_line_cnt" />
                                            </td>
                                            <td>خدمة</td>

                                            <td>
                                                <span t-esc="line.name" />
                                            </td>
                                            <td>1</td>
                                            <td>
                                                <span t-esc="line.unit_price" />
                                            </td>
                                            <td>
                                                <span t-esc="line.discount_amount" />
                                            </td>
                                            <td>
                                                <span t-esc="line.product_tax.name" />
                                            </td>

                                            <td>
                                                <span t-esc="line.total_tax" />
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                                <tr>
                                    <td colspan="7">
                                        <strong> صافي المبلغ </strong>
                                    </td>
                                    <td>
                                        <span t-esc="docs.services_amt_after_tax" />
                                    </td>

                                </tr>
                                <tr>
                                    <td colspan="7">
                                        <strong>الدفعة المقدمة </strong>
                                    </td>
                                    <td>
                                        <span t-esc="docs.advance_amount" />
                                    </td>
                                </tr>
                            </table>
                        </t>
                        <table class="table">
                            <tr>
                                <td>
                                    <strong> اسم العميل </strong>
                                    <span> Customer Name </span>
                                </td>
                                <td>
                                    --------------------------------
                                </td>

                                <td>
                                    <strong> اسم الفني </strong>
                                    <span> Installer Name </span>
                                </td>
                                <td>
                                    --------------------------------
                                </td>

                                <td>
                                    <strong> اسم الموظف </strong>
                                    <span> Representative Name </span>
                                </td>
                                <td>
                                    --------------------------------
                                </td>

                            </tr>
                            <tr>
                                <td>
                                    <strong>التوقيع</strong>
                                    <span>Signature</span>
                                </td>
                                <td>
                                    --------------------------------
                                </td>

                                <td>
                                    <strong> التوقيع </strong>
                                    <span>Signature</span>
                                </td>
                                <td>
                                    --------------------------------
                                </td>

                                <td>
                                    <strong> التوقيع </strong>
                                    <span>Signature</span>
                                </td>
                                <td>
                                    --------------------------------
                                </td>

                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>


    <record id="print_mizan_work_order_report" model="ir.actions.report">
        <field name="name"> طباعة امر العمل</field>
        <field name="model">mizan.car.work.procedure.master</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">yousentech_car_maintain.work_order_report_view</field>
        <field name="report_file">yousentech_car_maintain.work_order_report_view</field>
        <field name="paperformat_id" ref="yousentech_car_maintain.formate_pdf_report" />
    </record>
</odoo>