<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="action_report_workshop_order" model="ir.actions.report">
  <field name="name">تقرير أمر العمل</field>
  <field name="model">yt.reception.order</field>
  <field name="report_type">qweb-pdf</field>
  <field name="report_name">yousentech_car_maintain.report_workshop_order_document</field>
  <field name="report_file">yousentech_car_maintain.report_workshop_order_document</field>
  <field name="print_report_name">'أمر العمل - %s' % (object.name or '')</field>
  <field name="binding_model_id" ref="model_yt_reception_order"/>
  <field name="binding_type">report</field>
 </record>
 <template id="report_workshop_order_document">
  <t t-call="web.html_container">
   <t t-foreach="docs" t-as="o">
    <t t-call="web.external_layout">
     <div class="page yt-print-workshop" dir="rtl" style="font-family:inherit;direction:rtl;color:#223b60;">
      <style>
       /* Inspection-inspired, compact print layout. Keep item fonts readable. */
       .yt-print-workshop {font-family:inherit !important;font-size:12px;line-height:1.45;color:#223b60;}
       .yt-print-workshop table {width:100%;table-layout:fixed;border-collapse:collapse;}
       .yt-print-workshop td,.yt-print-workshop th {vertical-align:middle;word-wrap:break-word;overflow-wrap:break-word;}
       .yt-print-workshop .wo-heading {margin:3px 0 11px;border-bottom:2px solid #a9c7e8;padding:7px 0 11px;}
       .yt-print-workshop .wo-heading h2 {font-size:22px;color:#153b72;margin:0;font-weight:bold;line-height:1.3;}
       .yt-print-workshop .wo-subtitle {font-size:11px;color:#68809c;margin-top:4px;}
       .yt-print-workshop .wo-number {font-size:15px;font-weight:bold;color:#153b72;}
       .yt-print-workshop .wo-status {display:inline-block;background:#e2f3e9;color:#207349;font-weight:bold;padding:3px 11px;border-radius:10px;}
       .yt-print-workshop .wo-section-title {font-size:14px;font-weight:bold;color:#184a88;background:#edf4fc;border:1px solid #d4e2f4;padding:7px 10px;}
       .yt-print-workshop .wo-info-table {border:1px solid #d4e2f4;margin:0 0 9px;}
       .yt-print-workshop .wo-info-table td {padding:6px 9px;border-bottom:1px solid #e4edf6;}
       .yt-print-workshop .wo-info-label {color:#657d9a;font-size:10px;margin-left:7px;}
       .yt-print-workshop .wo-info-value {font-weight:600;color:#213e66;}
       .yt-print-workshop .wo-metrics {background:#eaf2fd;border:1px solid #c7dbf3;margin:1px 0 13px;}
       .yt-print-workshop .wo-metrics td {padding:8px;text-align:center;border-left:1px solid #d0e0f1;}
       .yt-print-workshop .wo-metrics td:last-child {border-left:0;}
       .yt-print-workshop .wo-metrics .wo-info-label {display:block;margin:0 0 3px;}
       .yt-print-workshop .wo-lines-title {font-size:14px;font-weight:bold;color:#184a88;background:#edf4fc;border:1px solid #d4e2f4;border-bottom:0;padding:8px 10px;margin:11px 0 0;}
       .yt-print-workshop .wo-parts-title {color:#4d54b6;}
       .yt-print-workshop .wo-lines {table-layout:fixed;border:1px solid #d4e2f4;margin:0 0 12px;page-break-inside:auto;}
       .yt-print-workshop .wo-lines thead {display:table-header-group;}
       .yt-print-workshop .wo-lines tbody {display:table-row-group;}
       .yt-print-workshop .wo-lines tr {page-break-inside:avoid;page-break-after:auto;}
       .yt-print-workshop .wo-lines th {font-size:11px;color:#111827 !important;-webkit-text-fill-color:#111827 !important;background:#eaf5fd !important;border:1px solid #d4e2f4;padding:7px 5px;text-align:center;font-weight:700;}
       .yt-print-workshop .wo-parts th {background:#f0e9f9 !important;border-color:#ded4ee;}
       .yt-print-workshop .wo-lines td {font-size:11px;line-height:1.35;padding:5px 7px;border:1px solid #dce5f0;}
       .yt-print-workshop .wo-lines tbody tr:nth-child(even) {background:#f2f7fd;}
       .yt-print-workshop .wo-parts tbody tr:nth-child(even) {background:#f5f5fd;}
       .yt-print-workshop .wo-line-name {font-weight:600;color:#274466;}
       .yt-print-workshop .wo-line-note {font-size:9.5px;line-height:1.3;color:#667b96;}
       .yt-print-workshop .wo-bottom {margin-top:10px;page-break-inside:avoid;}
       .yt-print-workshop .wo-bottom > tbody > tr > td {vertical-align:top;}
       .yt-print-workshop .wo-notes {border:1px solid #d4e2f4;background:#fff;padding:9px;min-height:35px;white-space:pre-wrap;}
       .yt-print-workshop .wo-totals {border:1px solid #d4e2f4;}
       .yt-print-workshop .wo-totals td {padding:5px 9px;border-bottom:1px solid #e4edf6;}
       .yt-print-workshop .wo-totals tr:nth-child(even) {background:#f2f7fd;}
       .yt-print-workshop .wo-totals .wo-final td {background:#dceeff;color:#111827 !important;font-weight:bold;font-size:13px;padding:9px;}
       .yt-print-workshop .wo-totals .wo-final span {color:#111827 !important;}
       .yt-print-workshop .wo-icon {font-family:FontAwesome;display:inline-block;margin-left:7px;font-size:13px;vertical-align:middle;}
       .yt-print-workshop .wo-panel {border:1px solid #d4e2f4;background:#fff;}
       .yt-print-workshop .wo-company {font-size:15px;font-weight:bold;color:#173b65;}
       .yt-print-workshop .wo-contact {font-size:10px;color:#425e7e;}
       .yt-print-workshop .wo-order-box {background:#eaf5fd;border:1px solid #d4e2f4;text-align:center;padding:5px;margin-top:6px;}
       .yt-print-workshop .wo-status-strip {margin-bottom:12px;border:1px solid #d4e2f4;}
       .yt-print-workshop .wo-status-strip td {width:33%;text-align:center;background:#f5f9fd;padding:6px;border-left:1px solid #d4e2f4;}
       .yt-print-workshop .wo-cards {margin-bottom:12px;}
       .yt-print-workshop .wo-cards .wo-info-table {margin:0;}
       .yt-print-workshop .wo-cards .wo-info-table td {padding:6px 8px;}
       .yt-print-workshop .wo-card-label {width:40%;font-size:10.5px;color:#345d88;}
       .yt-print-workshop .wo-card-value {font-size:11px;color:#111827;font-weight:600;}
       .yt-print-workshop .wo-client-title {background:#fff5e9;}
       .yt-print-workshop .wo-vehicle-title {background:#eaf5fd;}
       .yt-print-workshop .wo-signatures {margin-top:12px;page-break-inside:avoid;}
       .yt-print-workshop .wo-signature {border:1px solid #d4e2f4;min-height:48px;padding:7px 10px;font-weight:bold;color:#173b65;}
       .yt-print-workshop .wo-sign-line {text-align:center;margin-top:13px;color:#667b96;font-weight:normal;}
       .yt-print-workshop .wo-disclaimer {border-top:1px solid #d4e2f4;color:#7185a0;font-size:9px;margin-top:12px;padding-top:7px;}
      </style>

      <table class="wo-heading"><tr>
       <td style="width:52%;text-align:right;vertical-align:top;">
        <h2><span class="wo-icon">&#xf0ad;</span>أمر عمل صيانة</h2>
        <div class="wo-subtitle">WORK ORDER</div>
        <div class="wo-order-box"><span class="wo-info-label">رقم أمر العمل</span><div class="wo-number" t-esc="o.name"/></div>
       </td>
       <td style="width:48%;text-align:left;vertical-align:top;">
        <div class="wo-company" t-esc="o.company_id.name or ''"/>
        <div class="wo-subtitle">خدمات صيانة السيارات</div>
        <div class="wo-contact" t-if="o.company_id.phone" t-esc="o.company_id.phone"/>
        <div class="wo-contact" t-if="o.company_id.email" t-esc="o.company_id.email"/>
       </td>
      </tr></table>
      <table class="wo-status-strip"><tr>
       <td><span class="wo-info-label">الحالة</span><div class="wo-status" t-esc="dict(o._fields['state'].selection).get(o.state, '')"/></td>
       <td><span class="wo-info-label">تاريخ الدخول</span><div><strong t-field="o.arrival_at" t-options="{'widget':'date'}"/></div></td>
       <td><span class="wo-info-label">وقت الدخول</span><div><strong t-esc="context_timestamp(o.arrival_at).strftime('%H:%M') if o.arrival_at else '-'"/></div></td>
      </tr></table>
      <table class="wo-cards"><tr>
       <td style="width:50%;padding-left:5px;vertical-align:top;">
        <div class="wo-section-title wo-client-title"><span class="wo-icon">&#xf007;</span>بيانات العميل</div>
        <table class="wo-info-table">
         <tr><td class="wo-card-label">اسم العميل</td><td class="wo-card-value" t-esc="o.partner_id.name or '-'"/></tr>
         <tr><td class="wo-card-label">رقم الجوال</td><td class="wo-card-value" t-esc="o.partner_mobile or '-'"/></tr>
         <tr><td class="wo-card-label">المستشار</td><td class="wo-card-value" t-esc="o.advisor_id.name or '-'"/></tr>
        </table>
       </td>
       <td style="width:50%;padding-right:5px;vertical-align:top;">
        <div class="wo-section-title wo-vehicle-title"><span class="wo-icon">&#xf1b9;</span>بيانات السيارة</div>
        <table class="wo-info-table">
         <tr><td class="wo-card-label">النوع / الموديل</td><td class="wo-card-value"><span t-esc="o.vehicle_make_id.name or '-'"/> / <span t-esc="o.vehicle_model_id.name or '-'"/></td></tr>
         <tr><td class="wo-card-label">اللوحة</td><td class="wo-card-value" t-esc="o.vehicle_id.plate or '-'"/></tr>
         <tr><td class="wo-card-label">سنة الصنع</td><td class="wo-card-value" t-esc="o.vehicle_year or '-'"/></tr>
         <tr><td class="wo-card-label">رقم الهيكل</td><td class="wo-card-value" t-esc="o.vehicle_vin or '-'"/></tr>
         <tr><td class="wo-card-label">عداد الدخول</td><td class="wo-card-value" t-esc="o.odometer_in or 0"/></tr>
         <tr><td class="wo-card-label">عداد الخروج</td><td class="wo-card-value" t-esc="o.odometer_out or 0"/></tr>
        </table>
       </td>
      </tr></table>

      <div class="wo-lines-title"><span class="wo-icon">&#xf0ad;</span>الخدمات</div>
      <table class="wo-lines wo-services">
       <thead><tr>
        <th style="width:6%;">#</th><th style="width:41%;">الصنف / الوصف</th><th style="width:21%;">الفنيون</th>
        <th style="width:9%;">الكمية</th><th style="width:11%;">السعر</th><th style="width:12%;">الإجمالي</th>
       </tr></thead>
       <tbody>
        <t t-foreach="o.service_line_ids" t-as="line">
         <tr>
          <td style="text-align:center;" t-esc="line_index + 1"/>
          <td><div class="wo-line-name" t-esc="line.product_id.display_name"/><div class="wo-line-note" t-if="line.name and line.name != line.product_id.display_name" t-esc="line.name"/></td>
          <td t-esc="', '.join(line.technician_ids.mapped('name')) or '-'"/>
          <td style="text-align:center;" t-esc="'%g' % line.product_uom_qty"/>
          <td style="text-align:center;" t-esc="'%.2f' % line.price_unit"/>
          <td style="text-align:center;font-weight:bold;" t-esc="'%.2f' % line.line_subtotal"/>
         </tr>
        </t>
        <tr t-if="not o.service_line_ids"><td colspan="6" style="text-align:center;color:#7b8ca5;padding:9px;">لا توجد خدمات</td></tr>
       </tbody>
      </table>

      <div class="wo-lines-title wo-parts-title"><span class="wo-icon">&#xf085;</span>قطع الغيار</div>
      <table class="wo-lines wo-parts">
       <thead><tr>
        <th style="width:6%;">#</th><th style="width:51%;">الصنف / الوصف</th>
        <th style="width:13%;">الكمية</th><th style="width:14%;">السعر</th><th style="width:16%;">الإجمالي</th>
       </tr></thead>
       <tbody>
        <t t-foreach="o.part_line_ids" t-as="line">
         <tr>
          <td style="text-align:center;" t-esc="line_index + 1"/>
          <td><div class="wo-line-name" t-esc="line.product_id.display_name"/><div class="wo-line-note" t-if="line.name and line.name != line.product_id.display_name" t-esc="line.name"/></td>
          <td style="text-align:center;" t-esc="'%g' % line.product_uom_qty"/>
          <td style="text-align:center;" t-esc="'%.2f' % line.price_unit"/>
          <td style="text-align:center;font-weight:bold;" t-esc="'%.2f' % line.line_subtotal"/>
         </tr>
        </t>
        <tr t-if="not o.part_line_ids"><td colspan="5" style="text-align:center;color:#7b8ca5;padding:9px;">لا توجد قطع غيار</td></tr>
       </tbody>
      </table>

      <table class="wo-bottom"><tr>
       <td style="width:48%;padding-left:5px;">
        <div class="wo-section-title"><span class="wo-icon">&#xf0f6;</span>ملاحظات الاستقبال</div>
        <div class="wo-notes wo-panel" t-esc="o.reception_notes or 'لا توجد ملاحظات'"/>
       </td>
       <td style="width:52%;padding-right:5px;">
        <div class="wo-section-title"><span class="wo-icon">&#xf1ec;</span>ملخص الإجماليات</div>
        <table class="wo-totals">
         <tr><td>قيمة الخدمات</td><td style="text-align:left;"><span t-field="o.service_amount" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></td></tr>
         <tr><td>قيمة قطع الغيار</td><td style="text-align:left;"><span t-field="o.parts_amount" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></td></tr>
         <tr><td>الإجمالي قبل الخصم</td><td style="text-align:left;"><span t-field="o.amount_before_discount" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></td></tr>
         <tr><td>الخصم</td><td style="text-align:left;"><span t-field="o.discount_amount" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></td></tr>
         <tr><td>الضريبة</td><td style="text-align:left;"><span t-field="o.amount_tax" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></td></tr>
         <tr class="wo-final"><td>الإجمالي النهائي</td><td style="text-align:left;"><span t-field="o.amount_total" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></td></tr>
        </table>
       </td>
      </tr></table>
      <table class="wo-signatures"><tr><td style="width:50%;padding-left:5px;"><div class="wo-signature">توقيع العميل<div class="wo-sign-line">.......................................</div></div></td><td style="width:50%;padding-right:5px;"><div class="wo-signature">توقيع المستلم<div class="wo-sign-line">.......................................</div></div></td></tr></table>
      <div class="wo-disclaimer">هذا التقرير يوضح بيانات أمر العمل، ولا يُعد فاتورة ضريبية أو إيصال دفع.</div>
     </div>
    </t>
   </t>
  </t>
 </template>
</odoo>
