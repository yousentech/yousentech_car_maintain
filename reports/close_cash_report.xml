<?xml version="1.0" encoding="UTF-8"?>
<odoo>


	<report id="print_close_cash_report"
				model="cash.close.closed"
				string=" تقرير اقفال الصندوق"
				report_type="qweb-pdf"
				name="qimamhd_mizan_car_13.cash_close_report_view"
				file="qimamhd_mizan_car_13.cash_close_report_view"
				menu="True"

				/>

		<template id="cash_close_report_view">
		    <t t-if="o and 'company_id' in o">
                <t t-set="company" t-value="o.company_id"></t>
            </t>
            <t t-if="not o or not 'company_id' in o">
                <t t-set="company" t-value="res_company"></t>
            </t>

			<div class="header">
                <div class="row mt32 mb32">
                    <div class="col-6">
						<t t-if="not user_id.company_id.no_header_report_account">
							<t t-if="user_id.company_id.branch_header">
								<img t-if="user_id.company_id" t-att-src="'data:image/png;base64,%s' % to_text(user_id.company_id.branch_header)"
									style="max-height: 200px;"/>
							</t>
							<t t-else="">
								<t t-if="company.header_image">
									<img t-if="company.header_image" t-att-src="'data:image/png;base64,%s' % to_text(company.header_image)"
										style="max-height: 200px;"/>
								</t>
						    </t>
						</t>
                    </div>
                </div>
            </div>
            <div class="footer">
                <div class="row mt32 mb32">
                    <div class="col-12">
						<t t-if="not user_id.company_id.no_header_report_account">
							<t t-if="user_id.company_id.branch_footer">
 								<img t-if="user_id.company_id" t-att-src="'data:image/png;base64,%s' % to_text(user_id.company_id.branch_footer)"
									style="max-height: 200px;"/>
									<!--<img src="/sale/static/img/lumar_cond.png" style="max-height:200px;"/>-->
									<br />
							</t>
							<t t-else="">
								<t t-if="company.footer_image">
									<img t-if="company.footer_image" t-att-src="'data:image/png;base64,%s' % to_text(company.footer_image)"
										style="max-height: 200px;"/>
										<!--<img src="/sale/static/img/lumar_cond.png" style="max-height:200px;"/>-->
										<br />
								</t>
							</t>
						</t>
                    </div>
                </div>
            </div>

			<t t-call ="web.html_container">

				<t t-call="web.external_layout">

