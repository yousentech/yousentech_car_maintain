<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="action_report_vehicle_inspection" model="ir.actions.report">
  <field name="name">تقرير فحص السيارة</field>
  <field name="model">yt.reception.order</field>
  <field name="report_type">qweb-pdf</field>
  <field name="report_name">yousentech_car_maintain.report_vehicle_inspection_document</field>
  <field name="report_file">yousentech_car_maintain.report_vehicle_inspection_document</field>
  <field name="binding_model_id" ref="model_yt_reception_order"/><field name="binding_type">report</field><field name="print_report_name">'فحص السيارة - %s' % (object.name or '')</field>
 </record>
 <template id="report_vehicle_inspection_document">
  <t t-call="web.html_container">
   <t t-foreach="docs" t-as="o">
    <t t-call="web.external_layout">
     <div class="page yt-print-inspection" dir="rtl" style="font-family:inherit;direction:rtl;color:#22375c;font-size:12px;">

      <style>
       /* Print-safe RTL layout. Table rows flow across pages; headers repeat. */
       .yt-print-inspection {font-family:inherit !important;font-size:12px !important;line-height:1.6;color:#223b60;}
       .yt-print-inspection h2 {font-size:22px !important;color:#153b72;font-weight:bold;margin:6px 0 16px;text-align:center;}
       .yt-print-inspection h4 {font-size:15px !important;color:#184a88;font-weight:bold;margin:16px 0 8px;padding:8px 11px;background:#edf4fc;border:1px solid #d4e2f4;}
       .yt-print-inspection table {width:100%;border-collapse:collapse;table-layout:fixed;}
       .yt-print-inspection td,.yt-print-inspection th {vertical-align:middle;line-height:1.5;word-wrap:break-word;}
       .yt-print-inspection table thead {display:table-header-group;}
       .yt-print-inspection table tbody {display:table-row-group;}
       .yt-print-inspection table tr {page-break-inside:avoid;}
       .yt-print-inspection .yt-inspection-results {page-break-inside:auto;}
       .yt-print-inspection .yt-inspection-results tbody tr {page-break-inside:avoid;}
       .yt-print-inspection .yt-inspection-results thead tr th {background-color:#24568d !important;color:#ffffff !important;-webkit-text-fill-color:#ffffff !important;font-weight:700;padding:11px 8px !important;border:1px solid #24568d;}
       .yt-print-inspection .yt-inspection-results td {padding:9px 7px !important;border:1px solid #dce5f0;}
       .yt-print-inspection .yt-inspection-results tbody tr:nth-child(even) {background:#f2f7fd;}
       .yt-print-inspection .yt-inspection-results tbody tr:nth-child(odd) {background:#ffffff;}
       .yt-print-inspection .yt-inspection-results td {font-size:12px;color:#274466;}
       .yt-print-inspection .yt-inspection-results tbody tr {page-break-inside:avoid;}
       .yt-print-inspection .yt-inspection-result-summary {background:#eef4fc;border:1px solid #d4e2f4;padding:12px 14px;line-height:1.8;page-break-inside:avoid;}
       .yt-print-inspection .yt-inspection-meta {background:#eaf2fd;border:1px solid #c7dbf3;padding:13px;margin-bottom:14px;}
       .yt-print-inspection .yt-inspection-meta td {padding:6px 8px;text-align:center;}
       .yt-print-inspection .yt-inspection-info td {padding:10px !important;border:1px solid #d4e2f4 !important;}
       .yt-print-inspection .yt-inspection-info strong {color:#284e7c;}
       .yt-print-inspection .yt-inspection-note {border:1px solid #d4e2f4;padding:13px;min-height:32px;white-space:pre-wrap;word-wrap:break-word;}
      </style>
      
      <h2 style="text-align:center;color:#153b72;border-bottom:2px solid #a9c7e8;padding-bottom:13px;">تقرير فحص السيارة</h2>
      <div class="yt-inspection-meta">
       <table style="width:100%;"><tr>
        <td><strong>أمر العمل:</strong> <span t-esc="o.name"/></td>
        <td><strong>الشركة:</strong> <span t-esc="o.company_id.name"/></td>
        <td><strong>حالة الفحص:</strong> <span t-esc="dict(o._fields['inspection_state'].selection).get(o.inspection_state, '')"/></td>
       </tr></table>
      </div>
      <h4 style="color:#184a88;">بيانات العميل والسيارة</h4>
      <table class="yt-inspection-info" style="width:100%;border-collapse:collapse;margin-bottom:15px;">
       <tr><td style="padding:12px;border:1px solid #d5dfee;"><strong>العميل:</strong> <span t-esc="o.partner_id.name"/></td><td style="padding:10px;border:1px solid #d5dfee;"><strong>الجوال:</strong> <span t-esc="o.partner_mobile or '-'"/></td></tr>
       <tr><td style="padding:8px;border:1px solid #d5dfee;"><strong>السيارة:</strong> <span t-esc="o.vehicle_id.plate"/></td><td style="padding:8px;border:1px solid #d5dfee;"><strong>النوع / الموديل:</strong> <span t-esc="o.vehicle_make_id.name or '-'"/> / <span t-esc="o.vehicle_model_id.name or '-'"/></td></tr>
       <tr><td style="padding:8px;border:1px solid #d5dfee;"><strong>فني الفحص:</strong> <span t-esc="o.inspection_employee_id.name or '-'"/></td><td style="padding:8px;border:1px solid #d5dfee;"><strong>تاريخ الفحص:</strong> <span t-field="o.inspection_at"/></td></tr>
      </table>
      <h4 style="color:#4d54b6;">نتائج فحص المكونات</h4>
      <table class="yt-inspection-results" style="width:100%;border-collapse:collapse;text-align:center;">
       <thead><tr style="background-color:#24568d;"><th style="width:28%;background-color:#24568d;color:#ffffff !important;border:1px solid #24568d;padding:11px 8px;">المكون</th><th style="width:20%;background-color:#24568d;color:#ffffff !important;border:1px solid #24568d;padding:11px 8px;">التصنيف</th><th style="width:18%;background-color:#24568d;color:#ffffff !important;border:1px solid #24568d;padding:11px 8px;">النتيجة</th><th style="width:34%;background-color:#24568d;color:#ffffff !important;border:1px solid #24568d;padding:11px 8px;">الملاحظات</th></tr></thead>
       <tbody>
        <t t-foreach="o.inspection_line_ids" t-as="line">
         <tr>
          <td style="border:1px solid #d5dfee;padding:11px;"><span t-esc="line.component_name or line.component_id.name"/></td>
          <td style="border:1px solid #d5dfee;padding:8px;"><span t-esc="line.category_id.name"/></td>
          <td t-att-style="'border:1px solid #d5dfee;padding:8px;font-weight:bold;color:%s;' % ({'good':'#16864a','follow_up':'#c87905','bad':'#c33243','not_checked':'#64748b'}.get(line.condition,'#64748b'))"><span t-esc="dict(line._fields['condition'].selection).get(line.condition, '')"/></td>
          <td style="border:1px solid #d5dfee;padding:8px;"><span t-esc="line.notes or '-'"/></td>
         </tr>
        </t>
       </tbody>
      </table>
      <p class="yt-inspection-result-summary" style="margin-top:16px;"><strong>ملخص النتائج:</strong>
       سليم: <span t-esc="len(o.inspection_line_ids.filtered(lambda l: l.condition == 'good'))"/> |
       يحتاج متابعة: <span t-esc="len(o.inspection_line_ids.filtered(lambda l: l.condition == 'follow_up'))"/> |
       غير سليم: <span t-esc="len(o.inspection_line_ids.filtered(lambda l: l.condition == 'bad'))"/> |
       لم يُفحص: <span t-esc="len(o.inspection_line_ids.filtered(lambda l: l.condition == 'not_checked'))"/>
      </p>
      <h4 style="color:#4d54b6;">ملاحظات الفحص</h4>
      <p class="yt-inspection-note" t-esc="o.inspection_general_notes or 'لا توجد ملاحظات إضافية'"/>
      <h4 style="color:#4d54b6;">حالة الهيكل الخارجي</h4>
      <p class="yt-inspection-note" t-esc="o.inspection_exterior_notes or 'لا توجد ملاحظات'"/>
      <p style="font-size:10px;color:#64748b;margin-top:16px;">هذا التقرير يوثّق حالة الفحص ولا يُعد فاتورة أو موافقة على أعمال الصيانة.</p>
     </div>
    </t>
   </t>
  </t>
 </template>
</odoo>