<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="seq_reception_order" model="ir.sequence">
  <field name="name">Workshop Reception</field><field name="code">yt.reception.order</field><field name="prefix">WO2/%(year)s/</field><field name="padding">5</field>
 </record>
 <record id="view_reception_make_form" model="ir.ui.view">
  <field name="name">yt.reception.make.form</field><field name="model">yt.reception.make</field>
  <field name="arch" type="xml"><form string="الشركة المصنعة"><sheet><group><field name="name"/><field name="active"/></group></sheet></form></field>
 </record>
 <record id="view_reception_model_form" model="ir.ui.view">
  <field name="name">yt.reception.model.form</field><field name="model">yt.reception.model</field>
  <field name="arch" type="xml"><form string="موديل السيارة"><sheet><group><field name="name"/><field name="make_id" string="الشركة المصنعة" placeholder="ابحث عن الشركة المصنعة أو أنشئ شركة"/><field name="active"/></group></sheet></form></field>
 </record>
 <record id="view_reception_vehicle_form" model="ir.ui.view">
  <field name="name">yt.reception.vehicle.form</field><field name="model">yt.reception.vehicle</field>
  <field name="arch" type="xml">
   <form string="تسجيل سيارة">
    <sheet>
     <group>
      <group string="العميل واللوحة">
       <field name="company_id" string="الشركة" groups="base.group_multi_company"/>
       <field name="partner_id" string="العميل"/>
       <field name="plate" string="رقم اللوحة"/>
       <field name="plate_country" string="دولة اللوحة"/>
       <field name="plate_type" string="نوع اللوحة"/>
       <field name="plate_condition" string="حالة اللوحة"/>
      </group>
      <group string="بيانات السيارة">
       <field name="make_id" string="الشركة المصنعة"/>
       <field name="model_id" string="الموديل" placeholder="اختر الموديل أو أنشئ موديلًا" domain="[('make_id','=',make_id)]" context="{'default_make_id': make_id}"/>
       <field name="year" string="سنة الصنع"/>
       <field name="gear" string="ناقل الحركة"/>
       <field name="vin" string="رقم الشاصي (VIN)"/>
       <field name="engine_number" string="رقم المحرك"/>
       <field name="color" string="اللون"/>
       <field name="odometer" string="قراءة العداد"/>
      </group>
     </group>
    </sheet>
   </form>
  </field>
 </record>
 <record id="view_reception_order_form" model="ir.ui.view">
  <field name="name">yt.reception.order.native.form</field>
  <field name="model">yt.reception.order</field>
  <field name="arch" type="xml">
   <form string="أمر العمل - قبل البدء" class="yt-native-reception">
    <header>
     <button name="action_open_workshop" type="object" string="الانتقال إلى أمر العمل" class="btn-secondary" invisible="not id"/>
     
     <button name="action_cancel" type="object" string="إلغاء أمر العمل" invisible="state != 'draft'" confirm="هل تريد إلغاء أمر العمل؟"/>
     <field name="state" widget="statusbar" statusbar_visible="draft,cancelled"/>
    </header>
    <sheet>
     <div class="oe_title"><h1><field name="name" readonly="1" invisible="not name or name == '/'"/><span class="yt-rec-new-title" invisible="name and name != '/'">أمر عمل جديد</span></h1></div>
     <field name="company_id" string="الشركة" invisible="1"/>
     <div class="yt-rec-content-frame">
     <div class="yt-rec-native-grid yt-rec-two-card-grid">
      <div class="yt-rec-native-col yt-rec-col-customer-intake">
       <div class="yt-rec-native-card yt-rec-card-customer">
        <h3><i class="fa fa-user" aria-hidden="true"/> معلومات العميل</h3>
        <div class="yt-rec-form-rows yt-rec-customer-fields"><div class="yt-rec-field-row"><label for="partner_id" string="العميل"/><field name="partner_id" nolabel="1" placeholder="ابحث عن عميل أو أنشئ عميلاً جديدًا"/></div><div class="yt-rec-field-row"><label for="partner_mobile" string="جوال العميل"/><field name="partner_mobile" nolabel="1" placeholder="رقم الجوال" widget="phone"/></div><div class="yt-rec-field-row"><label for="customer_source" string="مصدر العميل"/><field name="customer_source" nolabel="1" placeholder="كيف تعرف العميل علينا؟"/></div></div>
       </div>
       <div class="yt-rec-native-card yt-rec-card-intake">
        <h3><i class="fa fa-calendar-check-o" aria-hidden="true"/> معلومات الاستقبال</h3>
        <div class="yt-rec-intake-fields yt-rec-form-rows">
         <div class="yt-rec-field-pair">
          <div class="yt-rec-field-row"><label for="arrival_at" string="تاريخ ووقت الدخول"/><field name="arrival_at" nolabel="1"/></div>
          <div class="yt-rec-field-row"><label for="intake_method" string="طريقة الاستلام"/><field name="intake_method" nolabel="1"/></div>
         </div>
         <div class="yt-rec-field-pair">
          <div class="yt-rec-field-row"><label for="odometer_in" string="عداد الدخول"/><field name="odometer_in" nolabel="1"/></div>
          <div class="yt-rec-field-row"><label for="odometer_out" string="عداد الخروج"/><field name="odometer_out" nolabel="1"/></div>
         </div>
        </div>
       </div>
      </div>
      <div class="yt-rec-native-col yt-rec-col-vehicle">
       <div class="yt-rec-native-card yt-rec-card-vehicle">
        <h3><i class="fa fa-car" aria-hidden="true"/> معلومات السيارة</h3>
        <div class="yt-rec-form-rows yt-rec-primary-fields"><div class="yt-rec-field-row"><label for="vehicle_id" string="السيارة"/><field name="vehicle_id" nolabel="1" placeholder="اختر سيارة أو أنشئ سيارة جديدة" domain="[('partner_id','=',partner_id),('company_id','=',company_id)]" context="{'default_partner_id':partner_id,'default_company_id':company_id}" options="{'no_open': False}"/></div></div>
        <div class="yt-rec-vehicle-details">
         <div class="yt-rec-detail-heading"><i class="fa fa-id-card-o" aria-hidden="true"/> بيانات السيارة المختارة</div>
         <div class="yt-rec-vehicle-summary"><div class="yt-rec-summary-cell"><label for="vehicle_make_id" string="الشركة المصنعة"/><field name="vehicle_make_id" nolabel="1" readonly="1"/></div><div class="yt-rec-summary-cell"><label for="vehicle_model_id" string="الموديل"/><field name="vehicle_model_id" nolabel="1" readonly="1"/></div><div class="yt-rec-summary-cell"><label for="vehicle_year" string="سنة الصنع"/><field name="vehicle_year" nolabel="1" readonly="1"/></div><div class="yt-rec-summary-cell"><label for="vehicle_color" string="اللون"/><field name="vehicle_color" nolabel="1" readonly="1"/></div><div class="yt-rec-summary-cell"><label for="vehicle_vin" string="رقم الشاصي"/><field name="vehicle_vin" nolabel="1" readonly="1"/></div><div class="yt-rec-summary-cell"><label for="vehicle_plate_country" string="دولة اللوحة"/><field name="vehicle_plate_country" nolabel="1" readonly="1"/></div></div>
         <div class="yt-rec-vehicle-hint"><i class="fa fa-info-circle" aria-hidden="true"/> لإضافة سيارة استخدم «إنشاء وتحرير» من حقل السيارة.</div>
        </div>
       </div>
      </div>
     </div>
     <div class="yt-rec-notes-full">
       <div class="yt-rec-native-card yt-rec-customer-notes-card">
        <h3><i class="fa fa-comment-o" aria-hidden="true"/> ملاحظات الاستقبال</h3>
        <div class="yt-rec-textarea-block"><field name="reception_notes" nolabel="1" placeholder="ملاحظات الاستقبال..."/></div>
       </div>
     </div>
     <div class="yt-rec-native-bottom">
      <details class="yt-rec-native-card yt-rec-card-complaints"><summary><i class="fa fa-comments-o" aria-hidden="true"/> شكاوى العميل (اختياري)<i class="fa fa-chevron-down yt-rec-toggle-icon" title="توسيع أو طي القسم" aria-hidden="true"/></summary>
       <field name="complaint_ids" nolabel="1">
        <tree editable="bottom"><field name="name" string="الشكوى" required="1"/></tree>
       </field>
      </details>
      <details class="yt-rec-native-card yt-rec-card-services"><summary><i class="fa fa-list-ul" aria-hidden="true"/> خدمات إضافية مطلوبة (اختياري)<i class="fa fa-chevron-down yt-rec-toggle-icon" title="توسيع أو طي القسم" aria-hidden="true"/></summary>
       <field name="request_ids" nolabel="1">
        <tree editable="bottom"><field name="name" string="الخدمة" required="1"/></tree>
       </field>
       <group><field name="no_parts_needed" string="أمر العمل لا يحتاج قطع"/></group>
      </details>
      <details class="yt-rec-native-card yt-rec-other-card">
        <summary><i class="fa fa-sliders" aria-hidden="true"/> بيانات أخرى<i class="fa fa-chevron-down yt-rec-toggle-icon" title="توسيع أو طي القسم" aria-hidden="true"/></summary>
        <div class="yt-rec-form-rows">
         <div class="yt-rec-field-pair">
          <div class="yt-rec-field-row"><label for="branch_id" string="الفرع"/><field name="branch_id" nolabel="1" readonly="1"/></div>
          <div class="yt-rec-field-row"><label for="advisor_id" string="المستخدم"/><field name="advisor_id" nolabel="1" readonly="1"/></div>
         </div>
        </div>
        <div class="yt-rec-textarea-block"><label for="internal_notes" string="ملاحظات داخلية"/><field name="internal_notes" nolabel="1" placeholder="ملاحظات داخلية خاصة بالموظفين..." groups="base.group_user"/></div>
       </details>

     </div>
     </div>
    </sheet>
    <div class="oe_chatter"><field name="message_follower_ids"/><field name="message_ids"/></div>
   </form>
  </field>
 </record>
 <record id="view_reception_order_tree" model="ir.ui.view">
  <field name="name">yt.reception.order.tree</field><field name="model">yt.reception.order</field>
  <field name="arch" type="xml">
   <tree string="أوامر العمل" default_order="id desc">
    <field name="name"/><field name="arrival_at" string="تاريخ ووقت الدخول"/><field name="partner_id" string="العميل"/><field name="vehicle_id" string="السيارة"/><field name="state"/>
   </tree>
  </field>
 </record>
 <record id="action_reception_native" model="ir.actions.act_window">
  <field name="name">الاستقبال وأوامر العمل</field>
  <field name="res_model">yt.reception.order</field>
  <field name="view_mode">tree,form</field>
  <field name="views" eval="[(ref('view_reception_order_tree'),'tree'),(ref('view_reception_order_form'),'form')]"/>
  <field name="context">{'default_state':'draft'}</field>
 </record>
 <menuitem id="menu_workshop_root" name="ورشة السيارات" sequence="30"/>
 <menuitem id="menu_workshop_reception" name="أوامر العمل" parent="menu_workshop_root" action="action_reception_native" sequence="10"/>
 <record id="view_inspection_category_tree" model="ir.ui.view"><field name="name">yt.inspection.category.tree</field><field name="model">yt.inspection.category</field><field name="arch" type="xml"><tree string="تصنيفات الفحص" default_order="sequence,id"><field name="sequence" widget="handle"/><field name="name" string="التصنيف"/><field name="service_product_id" string="الصنف الخدمي"/><field name="service_price" string="سعر الخدمة"/><field name="component_count" string="عدد المكونات"/><field name="active" string="نشط"/></tree></field></record>
 <record id="view_inspection_category_form" model="ir.ui.view">
  <field name="name">yt.inspection.category.form</field>
  <field name="model">yt.inspection.category</field>
  <field name="arch" type="xml">
   <form string="تصنيف ومكونات الفحص" class="yt-inspection-settings">
    <sheet>
     <div class="yt-inspection-settings-header">
      <h2>إعداد تصنيف الفحص</h2>
      <p>عرّف التصنيف وأضف مكوناته في مكان واحد. ستظهر المكونات في فحص السيارة عند اختيار التصنيف.</p>
     </div>
     <div class="yt-inspection-settings-card yt-inspection-settings-category">
      <div class="yt-inspection-settings-title"><i class="fa fa-folder-open" title="التصنيف"/> بيانات التصنيف</div>
      <group col="4">
       <field name="name" string="اسم التصنيف" placeholder="مثال: المحرك" colspan="2"/>
       <field name="sequence" string="الترتيب"/>
       <field name="active" string="نشط"/>
       <field name="service_price" string="سعر خدمة الفحص"/><field name="service_product_id" string="الصنف الخدمي" domain="[('detailed_type','=','service')]" options="{'no_create': True}"/>
       <button name="action_create_service_product" type="object" string="إنشاء صنف خدمي" icon="fa-plus" class="btn-secondary" invisible="service_product_id"/>
      </group>
     </div>
     <div class="yt-inspection-settings-card yt-inspection-settings-components">
      <div class="yt-inspection-settings-title"><i class="fa fa-check-square-o" title="المكونات"/> مكونات التصنيف</div>
      <p class="yt-inspection-settings-hint">أضف مكونات الفحص، وحدد الإلزامي منها. يمكنك سحب الصفوف لتغيير ترتيب العرض.</p>
      <field name="component_ids" nolabel="1" context="{'default_category_id': id}">
       <tree editable="bottom" string="مكونات الفحص">
        <field name="sequence" widget="handle"/>
        <field name="name" string="اسم المكون" required="1" placeholder="مثال: مستوى زيت المحرك"/>
        <field name="required" string="فحص إلزامي"/>
        <field name="active" string="نشط"/>
       </tree>
      </field>
     </div>
    </sheet>
   </form>
  </field>
 </record>
 <record id="view_inspection_component_tree" model="ir.ui.view"><field name="name">yt.inspection.component.tree</field><field name="model">yt.inspection.component</field><field name="arch" type="xml"><tree editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="category_id"/><field name="required"/><field name="active"/></tree></field></record>
 <record id="action_inspection_categories" model="ir.actions.act_window"><field name="name">تصنيفات ومكونات الفحص</field><field name="res_model">yt.inspection.category</field><field name="view_mode">tree,form</field><field name="views" eval="[(ref('view_inspection_category_tree'),'tree'),(ref('view_inspection_category_form'),'form')]"/></record>
 <record id="action_inspection_components" model="ir.actions.act_window"><field name="name">مكونات الفحص</field><field name="res_model">yt.inspection.component</field><field name="view_mode">tree,form</field></record>
 <menuitem id="menu_inspection_config" name="التهيئة" parent="menu_workshop_root" sequence="90" groups="base.group_system"/>
 <menuitem id="menu_inspection_categories" name="تهيئة التصنيفات" parent="menu_inspection_config" action="action_inspection_categories" sequence="10"/>

 <record id="view_reception_inspection_form" model="ir.ui.view">
  <field name="name">yt.reception.order.inspection.form</field><field name="model">yt.reception.order</field>
  <field name="arch" type="xml">
   <form string="فحص السيارة" class="yt-native-reception yt-inspection-form">
    <field name="company_id" invisible="1"/>
    <header>
     <button name="action_finish_inspection" type="object" string="اعتماد الفحص والمتابعة" class="btn-primary" invisible="inspection_state == 'done' or state != 'draft'"/>
     <button name="action_print_inspection" type="object" string="طباعة تقرير الفحص" icon="fa-print" class="btn-secondary"/>
     <button name="action_open_workshop" type="object" string="العودة إلى أمر العمل" class="btn-secondary" icon="fa-arrow-right"/>
     <button name="action_reopen_inspection" type="object" string="إعادة فتح الفحص" groups="base.group_system" invisible="inspection_state != 'done'"/>
     <field name="inspection_state" widget="statusbar" statusbar_visible="draft,done"/>
    </header>
    <sheet>
     <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
     <field name="state" invisible="1"/>
     <div class="yt-rec-content-frame">
      <div class="yt-rec-native-grid yt-rec-two-card-grid yt-inspection-top">
       <div class="yt-rec-native-card yt-rec-card-intake">
        <h3><i class="fa fa-wrench" aria-hidden="true"/> معلومات الفحص</h3>
        <div class="yt-rec-form-rows">
         <div class="yt-rec-field-pair">
          <div class="yt-rec-field-row"><label for="inspection_employee_id" string="فني الفحص"/><field name="inspection_employee_id" nolabel="1" domain="[('is_workshop_technician','=',True),('company_id','=',company_id)]" options="{'no_create': True, 'no_create_edit': True}" readonly="inspection_state == 'done'"/></div>
          <div class="yt-rec-field-row"><label for="inspection_at" string="تاريخ ووقت الفحص"/><field name="inspection_at" nolabel="1" readonly="inspection_state == 'done'"/></div>
         </div>
         <div class="yt-rec-field-row"><label for="inspection_location" string="مكان الفحص"/><field name="inspection_location" nolabel="1" readonly="inspection_state == 'done'"/></div>
        </div>
       </div>
       <div class="yt-rec-native-card yt-rec-card-customer">
        <h3><i class="fa fa-car" aria-hidden="true"/> السيارة والعميل</h3>
        <div class="yt-rec-form-rows yt-inspection-customer-grid">
          <div class="yt-rec-field-row"><label for="partner_id" string="العميل"/><field name="partner_id" nolabel="1" readonly="1"/></div>
          <div class="yt-rec-field-row"><label for="partner_mobile" string="جوال العميل"/><field name="partner_mobile" nolabel="1" readonly="1"/></div>
          <div class="yt-rec-field-row"><label for="vehicle_id" string="السيارة"/><field name="vehicle_id" nolabel="1" readonly="1"/></div>
          <div class="yt-rec-field-row"><label for="vehicle_make_id" string="نوع السيارة"/><field name="vehicle_make_id" nolabel="1" readonly="1"/></div>
          <div class="yt-rec-field-row"><label for="vehicle_model_id" string="الموديل"/><field name="vehicle_model_id" nolabel="1" readonly="1"/></div>
          <div class="yt-rec-field-row"><label for="odometer_in" string="عداد الدخول"/><field name="odometer_in" nolabel="1" readonly="1"/></div>
        </div>
       </div>
      </div>
            <div class="yt-rec-native-card yt-rec-card-vehicle">
       <h3><i class="fa fa-check-square-o" aria-hidden="true"/> فحص مكونات السيارة</h3>
       <div class="yt-inspection-category-picker">
        <div class="yt-inspection-picker-row">
         <div class="yt-inspection-picker-heading"><i class="fa fa-tags" title="تصنيفات الفحص"/> <span>تصنيفات الفحص</span></div>
         <field name="inspection_category_ids" nolabel="1" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True}" readonly="inspection_state == 'done'"/>
        </div>
        
       </div>
       
       <field name="inspection_line_ids" nolabel="1" readonly="inspection_state == 'done' or state != 'draft'">
        <tree editable="bottom" default_order="sequence,id" decoration-success="condition == 'good'" decoration-warning="condition == 'follow_up'" decoration-danger="condition == 'bad'">
         <field name="component_id" string="مكون الفحص" readonly="1" force_save="1"/>
         <field name="category_id" string="التصنيف" readonly="1"/>
         <field name="condition" string="نتيجة الفحص" widget="selection_badge" required="1"/>
         <field name="notes" string="ملاحظات المكون" placeholder="أضف ملاحظة عند الحاجة..."/>
        </tree>
       </field>
      </div>
      <div class="yt-rec-native-grid yt-rec-two-card-grid">
       <div class="yt-rec-native-card yt-rec-card-vehicle">
        <h3><i class="fa fa-car" aria-hidden="true"/> حالة الهيكل الخارجي</h3>
        <field name="inspection_exterior_notes" nolabel="1" placeholder="سجّل مواضع الخدوش والصدمات وحالة الهيكل..." readonly="inspection_state == 'done'"/>
       </div>
       <div class="yt-rec-native-card yt-rec-card-intake">
        <h3><i class="fa fa-file-text-o" aria-hidden="true"/> ملاحظات الفحص</h3>
        <field name="inspection_general_notes" nolabel="1" placeholder="ملاحظات فنية إضافية..." readonly="inspection_state == 'done'"/>
       </div>
      </div>
     </div>
    </sheet>
   </form>
  </field>
 </record>
 <record id="view_workshop_employee_form" model="ir.ui.view">
  <field name="name">hr.employee.workshop.settings.form</field>
  <field name="model">hr.employee</field>
  <field name="inherit_id" ref="hr.view_employee_form"/>
  <field name="arch" type="xml">
   <xpath expr="//notebook" position="inside">
    <page string="إعدادات الورشة" name="workshop_settings">
     <group string="مهام الورشة">
      <field name="is_workshop_technician" string="فني ورشة"/>
     </group>
    </page>
   </xpath>
  </field>
 </record>
</odoo>
