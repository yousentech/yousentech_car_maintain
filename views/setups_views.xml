            <field name="arch" type="xml">
                <tree>

                    <field name="name" />
                    <field name="desc_ar" />
                    <field name="desc_en" />
                    <field name="active_code" />
                    <field name="notes" />
                    <field name="company_id" string="الشركة" options="{'no_create': True}"
