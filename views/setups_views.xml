        <menuitem id="mizan_car_types_menu" name="انواع السيارات" parent="mizan_car_setup_menu"
            action="action_mizan_car_types_view" />

        <record model="ir.ui.view" id="mizan_car_size_view">
            <field name="name">mizan.car.size.view</field>
            <field name="model">mizan.car.size</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name" />
                            <field name="body_image" widget="image"
                                options="{'image_preview': 'image_128'}" />

                            <field name="company_id" string="الشركة" options="{'no_create': True}"
                                groups="base.group_multi_company" />

                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="mizan_car_size_tree_view" model="ir.ui.view">
            <field name="name">mizan.car.size.tree</field>
