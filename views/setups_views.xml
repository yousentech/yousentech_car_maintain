        <record model="ir.ui.view" id="mizan_computers_codes_view">
            <field name="name">mizan.computers.codes.view</field>
            <field name="model">mizan.computers.codes</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" />
                                <field name="desc_ar" />
                                <field name="active_code" />

                            </group>
                            <group>
                                <field name="desc_en" />
                                <field name="notes" />
                                <field name="company_id" string="الشركة"
                                    options="{'no_create': True}" groups="base.group_multi_company" />

                            </group>


                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="mizan_computers_codes_tree_view" model="ir.ui.view">
            <field name="name">mizan.computers.codes.tree</field>
