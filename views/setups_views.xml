<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <menuitem id="mizan_car_system_menu" name="نظام الصيانة"
        />
        <menuitem id="mizan_car_setup_menu" name="تهيئة نظام الصيانة" sequence="4"
            parent="mizan_car_system_menu" />
        <menuitem id="mizan_report_menu" name="التقارير" parent="mizan_car_system_menu" sequence="4" />


        <record model="ir.ui.view" id="mizan_parts_result_view">
            <field name="name">mizan.parts.results.view</field>
            <field name="model">mizan.parts.results</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="انواع الفحص">
                    <sheet>
                        <group>
                            <field name="name" />
                            <field name="en_name" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="mizan_parts_result_tree_view" model="ir.ui.view">
            <field name="name">mizan.parts.result.tree</field>
            <field name="model">mizan.parts.results</field>
            <field name="arch" type="xml">
                <tree string="نتائج الفحص">
                    <field name="name" />
                    <field name="en_name" />
                </tree>
            </field>
        </record>

        <record id="action_mizan_parts_result_view" model="ir.actions.act_window">
            <field name="name">انواع الفحص</field>
            <field name="res_model">mizan.parts.results</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="mizan_parts_result_tree_view" />
            <field name="target">current</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Click to create new service Type
                </p>
            </field>
        </record>

        <menuitem id="mizan_parts_result_lines_menu" name="نتائج الفحص"
            parent="mizan_car_setup_menu" sequence="4"
            action="action_mizan_parts_result_view" />

        <record model="ir.ui.view" id="mizan_services_types_view">
            <field name="name">services.types.view</field>
            <field name="model">mizan.services.types</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="انواع الخدمات">
                    <sheet>
                        <group>
                            <field name="name" />
                            <field name="en_name" />
                            <field name="product_id" />
                            <field name="price" />

                            <field name="company_id" string="الشركة" options="{'no_create': True}"
                                groups="base.group_multi_company" />
                        </group>

                    </sheet>
                </form>
            </field>
        </record>

        <record id="mizan_services_types_tree_view" model="ir.ui.view">
            <field name="name">services.types.tree</field>
            <field name="model">mizan.services.types</field>
            <field name="arch" type="xml">
                <tree string="انواع الخدمات">
                    <field name="name" />
                    <field name="en_name" />
                    <field name="product_id" />
                    <field name="company_id" string="الشركة" options="{'no_create': True}"
                        groups="base.group_multi_company" />
                </tree>
            </field>
        </record>

        <record id="action_mizan_services_types_view" model="ir.actions.act_window">
            <field name="name">انواع الخدمات</field>
            <field name="res_model">mizan.services.types</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="mizan_services_types_tree_view" />
            <field name="target">current</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Click to create new service Type
                </p>
            </field>
        </record>


        <menuitem id="mizan_services_types_menu" name="انواع الخدمات" parent="mizan_car_setup_menu"
            sequence="0"
            action="action_mizan_services_types_view" />

        <record model="ir.ui.view" id="mizan_car_manufactory_view">
            <field name="name">mizan.car.manufactory.view</field>
            <field name="model">mizan.car.manufactory</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name" />
                            <field name="company_id" string="الشركة" options="{'no_create': True}"
                                groups="base.group_multi_company" />

                        </group>
                        <notebook>
                            <page string="انواع السيارات المرتبطة">
                                <field name="car_types_lines">
                                    <tree editable="bottom" limit="100">
                                        <field name="id" widget="handle" />
                                        <field name="name" />
                                        <field name="header_id" invisible="1" />
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="mizan_car_manufactory_tree_view" model="ir.ui.view">
            <field name="name">mizan.car.manufactory.tree</field>
            <field name="model">mizan.car.manufactory</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name" />
                </tree>
            </field>
        </record>

        <record id="action_mizan_car_manufactory_view" model="ir.actions.act_window">
            <field name="name">الشركة المصنعة للسيارات</field>
            <field name="res_model">mizan.car.manufactory</field>
            <field name="type">ir.actions.act_window</field>
