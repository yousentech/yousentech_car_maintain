<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="mizan_register_payment_view" model="ir.ui.view">
            <field name="name">mizan_register_payment_view</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='journal_id']" position="after">
                    <field name="entry_card_id" />
                    <field name="checkup_id" />
                    <field name="maint_wo_id" />
                </xpath>
            </field>
        </record>

        <record id="mizan_payment_view" model="ir.ui.view">
            <field name="name">mizan.payment.view</field>
            <field name="model">mizan.register.payment</field>
            <field name="arch" type="xml">
                <form sring="بيانات الدفع">
                    <header>
                        <button name="create_payment" string="اعتماد" type="object"
                            class="oe_highlight"
                            invisible="state == 'posted'"
                            confirm="تاكيد .. هل انت متاكد من عملية الدفع وترحيلها للحسابات"
                        />
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="id" readonly="1" string="رقم الدفع" />
                                <field name="pay_date" readonly="state == 'posted'"
                                    string="تاريخ الدفع" />
                                <field name="journal_id" readonly="state == 'posted'"
                                    string="طريقة الدفع"
                                    options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}" />

                                <field name="payment_amount" readonly="state == 'posted'"
                                    required="1" string="المبلغ المدفرع" />
                                <field name="payment_note" readonly="state == 'posted'"
                                    string="البيانات" />
                                <field name="company_id" readonly="1" string="الفرع"
                                    options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}" />

                            </group>
                            <group>
                                <field name="state" readonly="1" string="الحالة" />
                                <field name="invoice_amount" string="مبلغ الفاتورة" />
                                <field name="advanced_amount" string="المبلغ المدفوع تراكمي" />
                                <field name="remaining_amount" string="المتبقي" />
                                <field name="header_id" readonly="1" />
                                <field name="checkup_id" readonly="1" />
                                <field name="maint_wo_id" readonly="1" />

                            </group>
                        </group>
                    </sheet>

                </form>
            </field>
        </record>

        <record id="mizan_payment_view_tree_view" model="ir.ui.view">
            <field name="name">تسجيل دفعة نقدية</field>
            <field name="model">mizan.register.payment</field>
            <field name="arch" type="xml">
                <tree string="Make Products History Tree">
                    <field name="id" readonly="1" string="رقم الدفع" />
                    <field name="pay_date" string="تاريخ الدفع" />
                    <field name="payment_amount" string="المبلغ المدفرع" />
                    <field name="header_id" readonly="1" />
                    <field name="checkup_id" readonly="1" />
                    <field name="maint_wo_id" readonly="1" />
                    <field name="payment_note" string="البيانات" />
                    <field name="state" string="الحالة" />

                </tree>
            </field>
        </record>

        <record id="mizan_payment_search_view" model="ir.ui.view">
            <field name="name">البحث في </field>
            <field name="model">mizan.register.payment</field>
            <field name="arch" type="xml">
                <search string=" البحث في ">
                    <field name="id" readonly="1" string="رقم الدفع" />
                    <field name="pay_date" string="تاريخ الدفع" />
                    <field name="payment_amount" string="المبلغ المدفرع" />
                    <field name="invoice_amount" string="مبلغ الفاتورة" />
                    <field name="advanced_amount" string="المبلغ المقدم" />
                    <field name="remaining_amount" string="الملاحظات" />
                    <field name="header_id" readonly="1" />
                    <field name="checkup_id" readonly="1" />
                    <field name="maint_wo_id" readonly="1" />
                    <field name="payment_note" string="البيانات" />

                </search>
            </field>
        </record>

        <record id="action_mizan_payment_view" model="ir.actions.act_window">
            <field name="name">تسجيل دفعة</field>
            <field name="res_model">mizan.register.payment</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="mizan_payment_view_tree_view" />
            <field name="target">current</field>
        </record>
    </data>
</odoo>