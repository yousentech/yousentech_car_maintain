<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
         <record id="checkup_procedure_form_view" model="ir.ui.view">
            <field name="name">mizan.car.checkup.procedure.master</field>
            <field name="model">mizan.car.checkup.procedure.master</field>
            <field name="arch" type="xml">
                <form string="اجراء الفحص" create="0">
                    <header>
                        <button name="create_invoice_mannually" string="انشاء فاتورة مبيعات" type="object" class="oe_highlight"
                                    attrs="{'invisible':['|',('create_invoice_manually_id','!=', False),('state','in',['cancel_order'])]}"
                                    groups="qimamhd_mizan_car_13.group_sales_man_priv"
                        />
                          <button name="create_work_order_procedure" string="انشاء امر العمل" type="object" class="oe_highlight"
                                    attrs="{'invisible':['|',('work_order_id','!=', False),('state','in',['cancel_order'])]}"
                                    groups="qimamhd_mizan_car_13.group_sales_man_priv"
                        />

                          <button name="register_payment" string="تسجيل دفعة" type="object" class="oe_highlight"
                                    attrs="{'invisible':[('state','in',['cancel_order'])]}"
                                    groups="qimamhd_mizan_car_13.group_sales_man_priv"
                        />

                        <field name="state" widget="statusbar" statusbar_visible="draft,confirm,execute_started,work_order_started,execute_completed,not_checkup_car,cancel_order"/>

                    </header>

                    <sheet>
                        <div class="oe_button_box" name="button_box">

                               <button type="object"
                                    name="call_wo_procedure"
                                    class="oe_stat_button"
                                     string="امر العمل"
                                    attrs="{'invisible':[('work_order_id','=', False)]}"

                                       icon="fa-pencil-square-o"
                                />
                                <button type="object"
                                    name="call_invoice"
                                    class="oe_stat_button"
                                     string="فاتورة المبيعات"
                                    attrs="{'invisible':[('create_invoice_manually_id','=', False)]}"

                                       icon="fa-pencil-square-o"
                                />
                            <button type="object"
                                    name="action_register_payment"
                                    class="oe_stat_button"
                                    string="الدفعات المقدمة"
                                     icon="fa-history" >

<!--                                <field name="payment_count"  widget="statinfo"/>-->
                            </button>

                         </div>
                        <h1>
                              <strong>اجراء الفحص </strong>

                          </h1>
                          <br></br>
                            <group>
                                 <group readonly="1" >
                                    <field name="work_order_id" invisible="1"  />
                                     <field name="is_user_technical"  invisible="1"/>
                                        <field name="is_user_supervisor"  invisible="1"/>
                                        <field name="use_pricelist"  invisible="1"/>

                                        <field name="is_user_sale_man"  invisible="1"/>
                                      <field name="partner_id"  readonly="1" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"   />
                                      <field name="create_date"   readonly="1" />
                                      <field name="car_panel_no"  readonly="1"  />
                                      <field name="partner_mobile"  readonly="1"  />
                                      <field name="car_size_id"  readonly="1"   options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"  />
                                      <field name="sale_man_id"  readonly="1"  options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"  />

                                      <field name="entry_card_id" readonly="1" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"  />
                                      <field name="work_order_id" readonly="1" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"/>
                                </group>
                                <group>
<!--                                      <field name="state"  readonly="1" />-->
                                      <field name="end_date"  attrs="{'readonly':['|','|', ('is_user_sale_man', '=', False),('state','in',['execute_request','execute_completed','cancel_order','work_order_started'])]}"/>
                                      <field name="car_model" readonly="1"  />
                                      <field name="car_type_id" readonly="1"  options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"  />
                                      <field name="vin_no" readonly="1"  />

                                      <field name="service_type_id"  attrs="{'readonly':['|','|','|',('create_invoice_manually_id','!=', False), ('is_user_sale_man', '=', False),('state','in',['execute_request','execute_completed','cancel_order'])]}" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"  />
                                      <field name="service_type_price" attrs="{'readonly':['|','|','|',('create_invoice_manually_id','!=', False), ('is_user_sale_man', '=', False),('state','in',['execute_request','execute_completed','cancel_order'])]}" />

                                      <field name="pay_type" attrs="{'readonly':['|','|','|',('create_invoice_manually_id','!=', False), ('is_user_sale_man', '=', False),('state','in',['execute_request','execute_completed','cancel_order','work_order_started'])]}" />
                                        <field name="advance_amount" readonly="1"  />

                                    <field name="create_invoice_manually_id" invisible="1" />

                                </group>


                            </group>

                            <notebook>
                                <page string="ادخال النتائج" >
                                     <button name="%(qimamhd_mizan_car_13.multi_mizan_product_wizard_action)d" type="action" string="Add Multi Products"
                                            attrs="{'readonly':['|','|','|',('create_invoice_manually_id','!=', False), ('is_user_sale_man', '=', False),('state','in',['execute_request','execute_completed','cancel_order','work_order_started'])]}" class="oe_highlight" />


                                    <field name="result_lines" attrs="{'readonly':['|','|','|',('create_invoice_manually_id','!=', False), ('is_user_sale_man', '=', False),('state','in',['execute_request','execute_completed','cancel_order','work_order_started'])]}">

                                        <tree editable="bottom"  limit="100">
                                            <field name="sequence"  widget="handle" />

<!--                                         <control>-->
<!--&lt;!&ndash;                                            <create name="add_line_control" string="Add a line"/>&ndash;&gt;-->
<!--                                             <create name="add_note_control" string="Add a note" context="{'default_display_type': 'line_note'}"/>-->
<!--                                         </control>-->
                                            <field name="selected" nolabel="1"/>

                                            <field name="checkup_part_id"   options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"/>
                                              <field name="product_tmpl_id" invisible="1"/>
                                             <field name="branch_id" invisible="1"  />

                                             <field name="checkup_part_result_id" widget="many2many_tags"   options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"/>

                                            <field name="technical_name" widget="many2many_tags"  options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"/>
                                            <field name="name" />

                                            <field name="notes" />

                                            <field name="header_id" invisible="1"/>

                                        </tree>

                                    </field>
                                 </page>
                                <page string="فحص الكمبيوتر">
                                     <group >
                                        <field name="lines_computer" attrs="{'readonly':['|','|','|',('create_invoice_manually_id','!=', False), ('is_user_sale_man', '=', False),('state','in',['execute_request','execute_completed','cancel_order','work_order_started'])]}"  nolabel="1">
                                            <tree editable="bottom" >
                                                 <field name="sequence"  widget="handle" />

                                                 <field name="computer_code" options="{'no_quick_create':True ,'no_open': True}" />
                                                 <field name="desc_ar" />
                                                 <field name="desc_en"/>
                                                <field name="notes" optional="hide" />

                                                <field name="header_id" invisible="1"/>
                                            </tree>
                                        </field>
                                     </group>

                                  </page>


                            </notebook>
<!--                            <group>-->
<!--                                    <group>-->
<!--                                         <field name="service_type_price"  options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"  attrs="{'readonly':['|', ('is_user_sale_man', '=', False),('state','in',['execute_started','execute_completed','complete_work','sale_order'])]}"/>-->

<!--                                     </group>-->
<!--                                    <group>-->
<!--                                          <field name="discount_type"  attrs="{'readonly':['|', ('is_user_sale_man', '=', False), ('sale_order_id','!=', False)]}"/>-->
<!--                                        <field name="service_discount"  attrs="{'readonly':['|', ('is_user_sale_man', '=', False), ('sale_order_id','!=', False)]}"/>-->

<!--                                    </group>-->
<!--                          </group>-->
<!--                          <group string="الاجمالي">-->
<!--                             <group>-->
<!--                                    <field name="services_price"/>-->
<!--                                    <field name="services_price_with_tax"/>-->

<!--                             </group>-->
<!--                             <group>-->

<!--                              <field name="services_price_after_discount"/>-->
<!--                             </group>-->
<!--                          </group>-->
<!--                                 <button name="add_new_checkup" string="اضافة نتائج فحص جديدة" type="object"-->

<!--                                        class="oe_highlight"-->
<!--                                        />-->

<!--                              <button string="خروج" special="cancel"/>-->

                       </sheet>
                   </form>
            </field>
        </record>
      <!--make products Tree View-->
        <record id="car_checkup_procedure_tree_view" model="ir.ui.view">
            <field name="name">mizan.car.checkup.procedure.master.tree</field>
            <field name="model">mizan.car.checkup.procedure.master</field>
            <field name="arch" type="xml">
                <tree>


                                      <field name="partner_id"  />
                                      <field name="create_date"  />
                                      <field name="car_panel_no"  />
                                      <field name="partner_mobile"  />
                                      <field name="car_size_id"  />
                                      <field name="entry_card_id"  />
                                      <field name="work_order_id"  />


                                      <field name="state"  readonly="1" />
                                      <field name="end_date" />
                                      <field name="car_model" />
                                      <field name="car_type_id" />
                                      <field name="service_type_id" />

                                      <field name="service_type_price" />
                                      <field name="create_invoice_manually_id" invisible="1" />



                </tree>
            </field>
        </record>

       <record id="action_car_checkup_procedure_view" model="ir.actions.act_window">
            <field name="name">اجراء الفحص</field>
            <field name="res_model">mizan.car.checkup.procedure.master</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="car_checkup_procedure_tree_view"/>
            <field name="target">current</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Click to create new
                </p>
            </field>
        </record>
    </data>

</odoo>