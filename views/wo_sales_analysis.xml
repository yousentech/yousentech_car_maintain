<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
<!--sales man-->
       <record id="wo_sales_analysis_tree_view" model="ir.ui.view">
            <field name="name">wo_sales_analysis_tree_view</field>
            <field name="model">wo.sales.analysis</field>
            <field name="arch" type="xml">
                <tree create="0" default_order="header_id desc">
                    <field name="id"  widget="handle" />
                     <field name="header_id"   options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"/>
                    <field name="partner_id"   options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"/>
                    <field name="supervisor_name_id"   options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"/>
                    <field name="technical_1"  readonly="1" />
                    <field name="technical_2"  readonly="1" />
                    <field name="technical_3"  readonly="1" />
                    <field name="technical_4"  readonly="1" />
                    <field name="car_panel_no"  readonly="1" />
                    <field name="partner_mobile"  readonly="1" />
                    <field name="state"  readonly="1" />
                    <field name="invoice_no"  readonly="1" />
                    <field name="branch_name"  readonly="1" />
                  
                    <field name="unit_price"  readonly="1" />
                    <field name="qty"  readonly="1" />
                    <field name="total"  readonly="1" />
                    <field name="untaxed_amount"  readonly="1" />
                    <field name="discount"  readonly="1" />
                  <field name="amount_tax"  readonly="1" />
                    <field name="amount_with_tax"  readonly="1" />
                      <field name="invoice_with_tax"  readonly="1" />
                    <field name="create_date"  readonly="1" />
                    <field name="name"  readonly="1" />
                    <field name="product_id"   options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"/>
                      <field name="type"  readonly="1"/>
                    <field name="product_categ_id"   options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"/>
                  </tree>
            </field>
      </record>
      <record id="wo_sales_analysis_search_view" model="ir.ui.view">
        <field name="name">البحث في </field>
        <field name="model">wo.sales.analysis</field>
          

        <field name="arch" type="xml">
             <search string=" البحث في ">
              <field name="header_id"   options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"/>

            
              <field name="header_id"   options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"/>
             <field name="partner_id"   options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"/>
             <field name="supervisor_name_id"   options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"/>
             <field name="technical_1"  readonly="1" />
             <field name="technical_2"  readonly="1" />
             <field name="technical_3"  readonly="1" />
             <field name="technical_4"  readonly="1" />
             <field name="car_panel_no"  readonly="1" />
             <field name="partner_mobile"  readonly="1" />
             <field name="state"  readonly="1" />
             <field name="invoice_no"  readonly="1" />
             <field name="branch_name"  readonly="1" />
             <field name="branch_name"  readonly="1" />
             <field name="unit_price"  readonly="1" />
             <field name="qty"  readonly="1" />
             <field name="total"  readonly="1" />
             <field name="untaxed_amount"  readonly="1" />
             <field name="discount"  readonly="1" />
             <field name="amount_tax"  readonly="1" />
             <field name="amount_with_tax"  readonly="1" />
                <field name="invoice_with_tax"  readonly="1" />
             <field name="create_date"  readonly="1" />
             <field name="name"  readonly="1" />
             <field name="product_id"   options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"/>
               <field name="type"  readonly="1"/>
             <field name="product_categ_id"   options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"/>
       
            

                </search>
            </field>
        </record>
      <record id="action_wo_sales_analysis_view" model="ir.actions.act_window">
            <field name="name">تحليل مبيعات الخدمات وقطع الغيار </field>
            <field name="res_model">wo.sales.analysis</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="wo_sales_analysis_tree_view"/>
     
            <field name="target">current</field>
        </record>

      <menuitem id="menu_wo_sales_analysis_view" name="تحليل مبيعات الخدمات وقطع الغيار"  parent="mizan_report_menu" sequence="80"
              action="action_wo_sales_analysis_view"
          />
    </data>
</odoo>
