<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_stock_picking_mizan" model="ir.ui.view">
            <field name="name">stock.picking.mizan</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form" />
            <field name="arch" type="xml">
                <field name="location_dest_id" position="after">
                    <field name="manual_ref_no" />
                </field>
                <field name="picking_type_id" position="before">
                    <field name="workstation_id"
                        options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}" />
                </field>
                <field name="picking_type_id" position="after">
                    <field name="send_done_wo" />
                </field>
                <field name="origin" position="after">
                    <field name="work_order_flag" />
                    <field name="work_order_id"
                        options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}" />
                    <field name="work_order_id1" readonly="1" force_save="1" />
                    <field name="partner_mobile" />
                    <field name="car_panel_no" />
                    <field name="car_size_id" />
                    <field name="car_model" />
                    <field name="car_type_id" />


                </field>
                <xpath expr="//button[@name='button_validate']" position="after">
                    <button string="ارسال الى امر العمل" name="send_products_to_wo" type="object"
                        class="oe_highlight"
                        invisible="[('state', 'not in', ['done'])]" />

                </xpath>
                <xpath expr="//button[@name='button_validate']" position="after">
                    <button string="ازالة الشحنة من امر العمل" name="delete_products_from_wo"
                        type="object" class="oe_highlight"
                        invisible="state not in ['done']" />

                </xpath>
                <xpath
                    expr="//field[@name = 'move_ids_without_package']/tree/field[@name = 'product_uom']"
                    position="after">

                    <field name="aval_qty" optional="hide" />
                    <field name="unit_cost" optional="hide" />
                    <field name="unit_price" />
                    <field name="total" />

                </xpath>

                <field name="group_id" position="after">
                    <field name="scheduled_date" />
                    <field name="origin" />
                    <field name="company_id"
                        options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}" />


                </field>
                <xpath expr="//notebook" position="after">
                    <h2>
                        <group>
                            <field name="total_all" />

                        </group>

                    </h2>
                </xpath>
            </field>
        </record>

        <record id="view_stock_picking_tree_mizan" model="ir.ui.view">
            <field name="name">stock.picking.tree.mizan</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.vpicktree" />
            <field name="arch" type="xml">
                <field name="origin" position="after">
                    <field name="work_order_flag" />
                    <field name="work_order_id1"
                        options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}" />
                    <field name="manual_ref_no" />
                    <field name="workstation_id" />
                    <field name="send_done_wo" />
                    <field name="partner_mobile" />
                    <field name="car_panel_no" />
                    <field name="car_size_id" />
                    <field name="car_model" />
                    <field name="car_type_id" />
                </field>
            </field>
        </record>

        <record id="view_stock_picking_search_mizan" model="ir.ui.view">
            <field name="name">stock.picking.mizan</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_internal_search" />
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <field name="work_order_id1" />
                    <field name="car_panel_no" />
                    <field name="partner_mobile" />
                    <field name="car_type_id" />
                    <field name="work_order_flag" />
                    <field name="workstation_id" />
                    <field name="manual_ref_no" />
                    <field name="car_size_id" />
                    <field name="car_model" />
                    <filter string="الصرف لاوامر العمل" name="wo_filter"
                        domain="[('work_order_flag', '!=', False)]" />
                </xpath>
            </field>
        </record>

        <record id="action_mizan_stock_picking_view" model="ir.actions.act_window">
            <field name="name">الصرف المخزني</field>
            <field name="res_model">stock.picking</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="stock.vpicktree" />
            <field name="context">{'default_work_order_flag': True,'search_default_wo_filter': 1} </field>

            <field name="target">current</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Click to create new service Type
                </p>
            </field>
        </record>
        
        <menuitem id="mizan_stock_picking_menu" name="الصرف المخزني" sequence="3"
            parent="mizan_car_system_menu"
            action="action_mizan_stock_picking_view" />

    </data>
</odoo>