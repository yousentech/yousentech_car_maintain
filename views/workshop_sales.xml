<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="view_reception_workshop_form" model="ir.ui.view">
  <field name="name">yt.reception.order.workshop.form</field>
  <field name="model">yt.reception.order</field>
  <field name="arch" type="xml">
   <form string="أمر العمل" class="yt-native-reception yt-workshop-finance-form">
    <header>
     <button name="action_create_sale_and_invoice" type="object" string="إنشاء أمر بيع وفاتورة" class="btn-primary" invisible="sale_order_id or state == 'cancelled' or not workshop_approved"/>
     <button name="action_approve_workshop" type="object" string="اعتماد أمر العمل" class="btn-secondary" invisible="workshop_approved or state == 'cancelled'"/>
     <button name="action_register_workshop_advance" type="object" string="تسجيل دفعة" invisible="state == 'cancelled' or workshop_collection_complete"/>
     <button name="action_open_inspection" type="object" string="إنشاء فحص" icon="fa-stethoscope" invisible="inspection_state == 'done' or state == 'cancelled'"/>
     <button name="action_cancel" type="object" string="إلغاء أمر العمل" invisible="state == 'cancelled'" confirm="هل تريد إلغاء أمر العمل؟"/>
     <field name="state" widget="statusbar"/>
    </header>
    <sheet>
     <field name="company_id" invisible="1"/>
     <field name="invoice_count" invisible="1"/>
     <field name="payment_count" invisible="1"/>
     <field name="workshop_approved" invisible="1"/>
     <field name="inspection_state" invisible="1"/>
     <field name="currency_id" invisible="1"/>
     <field name="workshop_collection_complete" invisible="1"/>
     <field name="workshop_collection_remaining" invisible="1"/>
     <div class="oe_button_box" name="button_box">
      <button name="action_open_sale_order" type="object" class="oe_stat_button" icon="fa-shopping-cart" invisible="not sale_order_id">
       <div class="o_stat_info"><span class="o_stat_text">أمر البيع</span></div>
      </button>
      <button name="action_open_workshop_invoices" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="not invoice_count">
       <field name="invoice_count" widget="statinfo" string="الفواتير"/>
      </button>
      <button name="action_open_workshop_payments" type="object" class="oe_stat_button" icon="fa-money" invisible="not payment_count">
       <field name="payment_count" widget="statinfo" string="الدفعات"/>
      </button>
      <button name="action_open_inspection" type="object" class="oe_stat_button" icon="fa-stethoscope" invisible="inspection_state != 'done'">
       <div class="o_stat_info"><span class="o_stat_text">الفحص المعتمد</span><span class="o_stat_text">عرض التقرير</span></div>
      </button>
     </div>
     <div class="yt-wo-dashboard" dir="rtl">
      <div class="yt-wo-summary">
       <div class="yt-wo-summary-title"><span class="yt-wo-icon"><i class="fa fa-wrench"/></span><div><small>ملخص أمر العمل</small><h2><field name="name" readonly="1" nolabel="1"/></h2><span>صيانة وخدمات السيارة</span></div></div>
       <div class="yt-wo-kpis yt-wo-kpis-six">
        <div class="yt-wo-kpi yt-wo-blue"><small>قيمة الخدمات</small><field name="service_amount" readonly="1" widget="monetary" options="{'currency_field':'currency_id'}"/></div>
        <div class="yt-wo-kpi yt-wo-teal"><small>قيمة قطع الغيار</small><field name="parts_amount" readonly="1" widget="monetary" options="{'currency_field':'currency_id'}"/></div>
        <div class="yt-wo-kpi yt-wo-neutral"><small>الإجمالي قبل الخصم</small><field name="amount_before_discount" readonly="1" widget="monetary" options="{'currency_field':'currency_id'}"/></div>
        <div class="yt-wo-kpi yt-wo-green"><small>الخصم</small><field name="discount_amount" readonly="1" widget="monetary" options="{'currency_field':'currency_id'}"/></div>
        <div class="yt-wo-kpi yt-wo-orange"><small>الضريبة</small><field name="amount_tax" readonly="1" widget="monetary" options="{'currency_field':'currency_id'}"/></div>
        <div class="yt-wo-kpi yt-wo-purple"><small>الإجمالي النهائي</small><field name="amount_total" readonly="1" widget="monetary" options="{'currency_field':'currency_id'}"/></div>
       </div>
      </div>
      <div class="yt-rec-native-grid yt-rec-two-card-grid">
       <div class="yt-rec-native-col yt-rec-col-customer-intake">
       <div class="yt-rec-native-card yt-rec-card-customer">
        <h3><i class="fa fa-user" aria-hidden="true"/> معلومات العميل</h3>
        <div class="yt-rec-form-rows yt-rec-customer-fields"><div class="yt-rec-field-row"><label for="partner_id" string="العميل"/><field name="partner_id" nolabel="1" placeholder="ابحث عن عميل أو أنشئ عميلاً جديدًا"/></div><div class="yt-rec-field-row"><label for="partner_mobile" string="جوال العميل"/><field name="partner_mobile" nolabel="1" placeholder="رقم الجوال" widget="phone"/></div><div class="yt-rec-field-row"><label for="customer_source" string="مصدر العميل"/><field name="customer_source" nolabel="1" placeholder="كيف تعرف العميل علينا؟"/></div></div>
       </div>
       <div class="yt-rec-native-card yt-rec-card-intake">
        <h3><i class="fa fa-calendar-check-o" aria-hidden="true"/> معلومات الاستقبال</h3>
        <div class="yt-rec-intake-fields yt-rec-form-rows">
         <div class="yt-rec-field-pair">
          <div class="yt-rec-field-row"><label for="arrival_at" string="تاريخ ووقت الدخول"/><field name="arrival_at" nolabel="1"/></div>
          <div class="yt-rec-field-row"><label for="intake_method" string="طريقة الاستلام"/><field name="intake_method" nolabel="1"/></div>
         </div>
         <div class="yt-rec-field-pair">
          <div class="yt-rec-field-row"><label for="odometer_in" string="عداد الدخول"/><field name="odometer_in" nolabel="1"/></div>
          <div class="yt-rec-field-row"><label for="odometer_out" string="عداد الخروج"/><field name="odometer_out" nolabel="1"/></div>
         </div>
        </div>
       </div>

       </div>
       <div class="yt-rec-native-col yt-rec-col-vehicle">
       <div class="yt-rec-native-card yt-rec-card-vehicle">
        <h3><i class="fa fa-car" aria-hidden="true"/> معلومات السيارة</h3>
        <div class="yt-rec-form-rows yt-rec-primary-fields"><div class="yt-rec-field-row"><label for="vehicle_id" string="السيارة"/><field name="vehicle_id" nolabel="1" placeholder="اختر سيارة أو أنشئ سيارة جديدة" domain="[('partner_id','=',partner_id),('company_id','=',company_id)]" context="{'default_partner_id':partner_id,'default_company_id':company_id}" options="{'no_open': False}"/></div></div>
        <div class="yt-rec-vehicle-details">
         <div class="yt-rec-detail-heading"><i class="fa fa-id-card-o" aria-hidden="true"/> بيانات السيارة المختارة</div>
         <div class="yt-rec-vehicle-summary"><div class="yt-rec-summary-cell"><label for="vehicle_make_id" string="الشركة المصنعة"/><field name="vehicle_make_id" nolabel="1" readonly="1"/></div><div class="yt-rec-summary-cell"><label for="vehicle_model_id" string="الموديل"/><field name="vehicle_model_id" nolabel="1" readonly="1"/></div><div class="yt-rec-summary-cell"><label for="vehicle_year" string="سنة الصنع"/><field name="vehicle_year" nolabel="1" readonly="1"/></div><div class="yt-rec-summary-cell"><label for="vehicle_color" string="اللون"/><field name="vehicle_color" nolabel="1" readonly="1"/></div><div class="yt-rec-summary-cell"><label for="vehicle_vin" string="رقم الشاصي"/><field name="vehicle_vin" nolabel="1" readonly="1"/></div><div class="yt-rec-summary-cell"><label for="vehicle_plate_country" string="دولة اللوحة"/><field name="vehicle_plate_country" nolabel="1" readonly="1"/></div></div>
         <div class="yt-rec-vehicle-hint"><i class="fa fa-info-circle" aria-hidden="true"/> لإضافة سيارة استخدم «إنشاء وتحرير» من حقل السيارة.</div>
        </div>
       </div>
       </div>
      </div>
      <div class="yt-wo-service-grid">
       <section class="yt-wo-card yt-wo-lines yt-wo-services">
        <h3><i class="fa fa-wrench"/> الخدمات</h3>
        <div class="yt-wo-table-wrap">
         <field name="service_line_ids" nolabel="1" readonly="sale_order_id">
          <tree editable="bottom">
           <field name="sequence" widget="handle"/>
           <field name="product_id" string="الخدمة" domain="[('type','=','service'),('sale_ok','=',True)]"/>
           <field name="name" string="الوصف"/>
           <field name="product_uom_qty" string="الكمية"/>
           <field name="price_unit" string="السعر"/>
           <field name="line_subtotal" string="الإجمالي" readonly="1"/>
          </tree>
         </field>
        </div>
       </section>
       <section class="yt-wo-card yt-wo-lines yt-wo-parts">
        <h3><i class="fa fa-cogs"/> قطع الغيار</h3>
        <div class="yt-wo-table-wrap">
         <field name="part_line_ids" nolabel="1" readonly="sale_order_id">
          <tree editable="bottom">
           <field name="sequence" widget="handle"/>
           <field name="product_id" string="قطعة الغيار" domain="[('type','in',['product','consu']),('sale_ok','=',True)]"/>
           <field name="name" string="الوصف"/>
           <field name="product_uom_qty" string="الكمية"/>
           <field name="available_qty" string="المتاح" readonly="1"/>
           <field name="price_unit" string="السعر"/>
           <field name="line_subtotal" string="الإجمالي" readonly="1"/>
          </tree>
         </field>
        </div>
       </section>
      </div>
      <div class="yt-wo-bottom-cards">
       <div class="yt-rec-native-card yt-rec-customer-notes-card yt-wo-notes-bottom-card">
        <h3><i class="fa fa-comment-o" aria-hidden="true"/> ملاحظات الاستقبال</h3>
        <div class="yt-rec-textarea-block"><field name="reception_notes" nolabel="1" placeholder="ملاحظات الاستقبال..."/></div>
       </div>
       <details class="yt-wo-card yt-wo-fold yt-wo-discount" open="open">
        <summary><i class="fa fa-percent"/> الخصم <i class="fa fa-chevron-down yt-wo-chevron"/></summary>
        <div class="yt-wo-finance-body">
         <group col="2">
          <field name="discount_type" string="نوع الخصم" readonly="sale_order_id"/>
          <field name="discount_value" string="قيمة الخصم" readonly="sale_order_id"/>
         </group>
         <div class="yt-wo-finance-hint">تظهر قيمة الخصم والضريبة والإجمالي في الملخص العلوي.</div>
        </div>
       </details>
      </div>
      <details class="yt-wo-card yt-wo-finance-tab yt-wo-finance-collapsible">
       <summary class="yt-wo-finance-heading"><i class="fa fa-credit-card"/> الأمور المالية <i class="fa fa-chevron-down yt-wo-finance-main-chevron"/></summary>
       <div class="yt-wo-finance-body">
        <div class="yt-wo-finance-kpis">
         <div class="yt-wo-finance-kpi yt-wo-finance-billed"><small>إجمالي الفواتير</small><field name="finance_invoiced" nolabel="1" readonly="1" widget="monetary" options="{'currency_field':'currency_id'}"/></div>
         <div class="yt-wo-finance-kpi yt-wo-finance-credited"><small>الإشعارات الدائنة</small><field name="finance_credited" nolabel="1" readonly="1" widget="monetary" options="{'currency_field':'currency_id'}"/></div>
         <div class="yt-wo-finance-kpi yt-wo-finance-paid"><small>المبالغ المقبوضة</small><field name="finance_received" nolabel="1" readonly="1" widget="monetary" options="{'currency_field':'currency_id'}"/></div>
         <div class="yt-wo-finance-kpi yt-wo-finance-refunded"><small>المبالغ المردودة</small><field name="finance_refunded" nolabel="1" readonly="1" widget="monetary" options="{'currency_field':'currency_id'}"/></div>
         <div class="yt-wo-finance-kpi yt-wo-finance-due"><small>المتبقي للتحصيل</small><field name="finance_due" nolabel="1" readonly="1" widget="monetary" options="{'currency_field':'currency_id'}"/></div>
         <div class="yt-wo-finance-kpi yt-wo-finance-return"><small>المتبقي للرد</small><field name="finance_to_refund" nolabel="1" readonly="1" widget="monetary" options="{'currency_field':'currency_id'}"/></div>
        </div>
        <details class="yt-wo-finance-section yt-wo-finance-fold">
         <summary><i class="fa fa-file-text-o"/> الفواتير والإشعارات الدائنة <i class="fa fa-chevron-down yt-wo-finance-chevron"/></summary>
         <field name="finance_invoice_ids" nolabel="1" readonly="1">
          <tree create="false" delete="false" edit="false">
           <field name="name" string="رقم المستند"/>
           <field name="move_type" string="نوع المستند"/>
           <field name="state" string="الحالة"/>
           <field name="amount_total" string="الإجمالي"/>
           <field name="amount_residual" string="المتبقي"/>
           <field name="payment_state" string="حالة السداد"/>
          </tree>
         </field>
        </details>
        <div class="yt-wo-finance-section">
         <h4><i class="fa fa-money"/> الدفعات</h4>
         <field name="finance_payment_ids" nolabel="1" readonly="1">
          <tree create="false" delete="false" edit="false">
           <field name="name" string="رقم الدفعة"/>
           <field name="date" string="التاريخ"/>
           <field name="payment_type" string="نوع الدفعة"/>
           <field name="amount" string="المبلغ"/>
           <field name="state" string="الحالة"/>
          </tree>
         </field>
        </div>
        <div class="yt-wo-finance-cancel-reason" invisible="not cancel_reason">
         <label for="cancel_reason" string="سبب الإلغاء"/>
         <field name="cancel_reason" nolabel="1" readonly="1"/>
        </div>
       </div>
      </details>
      <details class="yt-rec-native-card yt-rec-other-card yt-wo-extra-bottom">
       <summary><i class="fa fa-sliders"/> بيانات أخرى <i class="fa fa-chevron-down yt-rec-toggle-icon"/></summary>
       <div class="yt-wo-extra-body">
        <div class="yt-wo-extra-stock-fields">
         <div class="yt-rec-field-row"><label for="location_id" string="موقع قطع الغيار"/><field name="location_id" nolabel="1" options="{'no_create': True}" readonly="sale_order_id"/></div>
         <div class="yt-rec-field-row"><label for="sale_order_id" string="أمر البيع"/><field name="sale_order_id" nolabel="1" readonly="1"/></div>
        </div>
      <div class="yt-rec-native-card yt-rec-other-details">
        <div class="yt-rec-form-rows">
         <div class="yt-rec-field-pair">
          <div class="yt-rec-field-row"><label for="branch_id" string="الفرع"/><field name="branch_id" nolabel="1" readonly="1"/></div>
          <div class="yt-rec-field-row"><label for="advisor_id" string="المستخدم"/><field name="advisor_id" nolabel="1" readonly="1"/></div>
         </div>
        </div>
        <div class="yt-rec-textarea-block"><label for="internal_notes" string="ملاحظات داخلية"/><field name="internal_notes" nolabel="1" placeholder="ملاحظات داخلية خاصة بالموظفين..." groups="base.group_user"/></div>
       </div>
       </div>
      </details>
     </div>
    </sheet>
   </form>
  </field>
 </record>
 <record id="action_reception_native_form_view" model="ir.actions.act_window.view">
  <field name="view_id" ref="view_reception_workshop_form"/>
 </record>
 <record id="action_workshop_orders" model="ir.actions.act_window">
  <field name="name">أوامر العمل</field>
  <field name="res_model">yt.reception.order</field>
  <field name="view_mode">tree,form</field>
  <field name="views" eval="[(ref('view_reception_order_tree'),'tree'),(ref('view_reception_workshop_form'),'form')]"/>
 </record>
 
 <record id="view_workshop_finance_settings_form" model="ir.ui.view">
  <field name="name">yt.workshop.finance.settings.form</field>
  <field name="model">yt.workshop.finance.settings</field>
  <field name="arch" type="xml">
   <form string="إعدادات الورشة">
    <sheet><div class="oe_title"><h1>إعدادات الورشة المالية</h1></div>
     <group><field name="company_id" readonly="1"/><field name="tax_id" options="{'no_create': True}"/></group>
    </sheet>
   </form>
  </field>
 </record>
 <record id="action_workshop_finance_settings" model="ir.actions.server">
  <field name="name">الإعدادات</field>
  <field name="model_id" ref="model_yt_workshop_finance_settings"/>
  <field name="state">code</field>
  <field name="code">action = env['yt.workshop.finance.settings'].action_open_settings()</field>
 </record>
 <menuitem id="menu_workshop_finance_settings" name="الإعدادات المالية" parent="menu_inspection_config" action="action_workshop_finance_settings" sequence="90" groups="base.group_system"/>

 <record id="view_workshop_advance_payment_wizard_form" model="ir.ui.view">
  <field name="name">yt.workshop.advance.payment.wizard.form</field>
  <field name="model">yt.workshop.advance.payment.wizard</field>
  <field name="arch" type="xml">
   <form string="تسجيل دفعة مقدمة" create="false" class="yt-workshop-advance-wizard">
    <field name="company_id" invisible="1"/>
    <field name="currency_id" invisible="1"/>
    <field name="allowed_journal_ids" invisible="1"/>
    <field name="available_payment_method_line_ids" invisible="1"/>
    <div class="yt-advance-header">
     <div class="yt-advance-header-icon"><i class="fa fa-money"/></div>
     <div>
      <h2>تسجيل دفعة مقدمة</h2>
      <p>تحصيل مبلغ من العميل قبل إصدار الفاتورة وربطه بأمر العمل</p>
     </div>
    </div>
    <div class="yt-advance-content">
     <div class="yt-advance-context">
      <div class="yt-advance-context-field"><span>أمر العمل</span><field name="order_id" nolabel="1" readonly="1"/></div>
      <div class="yt-advance-context-field"><span>العميل</span><field name="partner_id" nolabel="1" readonly="1"/></div>
     </div>
     <div class="yt-advance-section-title"><i class="fa fa-credit-card"/> تفاصيل التحصيل</div>
     <div class="yt-advance-fields">
      <div class="yt-advance-field"><label for="journal_id" string="الصندوق / البنك"/><field name="journal_id" nolabel="1" options="{'no_create': True}"/></div>
      <div class="yt-advance-field"><label for="payment_method_line_id" string="طريقة الدفع"/><field name="payment_method_line_id" nolabel="1" options="{'no_create': True, 'no_create_edit': True}"/></div>
      <div class="yt-advance-field yt-advance-amount"><label for="amount" string="المبلغ"/><field name="amount" nolabel="1"/></div>
      <div class="yt-advance-field"><label for="payment_date" string="تاريخ الدفعة"/><field name="payment_date" nolabel="1"/></div>
      <div class="yt-advance-field yt-advance-field-wide"><label for="memo" string="البيان"/><field name="memo" nolabel="1" placeholder="مثال: دفعة مقدمة لصيانة السيارة"/></div>
     </div>
     <div class="yt-advance-hint"><i class="fa fa-info-circle"/> تُسجّل الدفعة على حساب العميل ويمكن تسويتها مع الفاتورة لاحقًا.</div>
    </div>
    <footer>
     <button name="action_confirm_advance" type="object" string="تأكيد الدفعة" class="btn-primary"/>
     <button string="إلغاء" special="cancel" class="btn-secondary"/>
    </footer>
   </form>
  </field>
 </record>
 <record id="view_workshop_cancel_wizard_form" model="ir.ui.view">
  <field name="name">yt.workshop.cancel.wizard.form</field>
  <field name="model">yt.workshop.cancel.wizard</field>
  <field name="arch" type="xml">
   <form string="إلغاء أمر العمل" create="false">
    <group><field name="order_id"/><field name="reason" required="1"/></group>
    <footer>
     <button name="action_confirm_cancel" type="object" string="تأكيد الإلغاء" class="btn-primary"/>
     <button string="رجوع" special="cancel" class="btn-secondary"/>
    </footer>
   </form>
  </field>
 </record>
</odoo>
