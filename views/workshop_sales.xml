<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="view_reception_workshop_form" model="ir.ui.view">
  <field name="name">yt.reception.order.workshop.form</field>
  <field name="model">yt.reception.order</field>
  <field name="arch" type="xml">
   <form string="أمر العمل" class="yt-native-reception yt-workshop-finance-form" delete="true">
    <header>
     <button name="action_create_sale_and_invoice" type="object" string="إنشاء أمر بيع وفاتورة" class="btn-primary" invisible="not can_create_workshop_invoice"/>
     <button name="action_approve_workshop" type="object" string="اعتماد أمر العمل" class="btn-secondary" invisible="state != 'draft'"/>
     <button groups="yousentech_car_maintain.group_workshop_revoke_approval" name="action_revoke_workshop_approval" type="object" string="إلغاء الاعتماد" class="btn-secondary" invisible="state != 'approved'" confirm="هل تريد إلغاء اعتماد أمر العمل وإعادته إلى مسودة؟"/>
      <button name="action_start_workshop_execution" type="object" string="بدء التنفيذ" class="btn-primary" invisible="state != 'approved'"/>
      <button name="action_finish_workshop_execution" type="object" string="اكتمال التنفيذ" class="btn-primary" invisible="state != 'in_progress'"/>
     <button name="action_register_workshop_advance" type="object" string="تسجيل دفعة" invisible="state in ('draft', 'cancelled') or not workshop_approved or workshop_collection_complete"/>
     <button groups="yousentech_car_maintain.group_workshop_inspection" name="action_open_inspection" type="object" string="إنشاء فحص" icon="fa-stethoscope" invisible="inspection_state == 'done' or state in ('cancelled', 'done') or invoice_count &gt; 0"/>
     <button groups="yousentech_car_maintain.group_workshop_cancel_completed" name="action_cancel" type="object" string="إلغاء أمر العمل" invisible="state != 'done'" confirm="هل تريد إلغاء أمر العمل المكتمل؟ يجب تسوية الالتزامات المالية والمخزنية أولاً."/>
     <button name="action_reopen_workshop" type="object" string="إعادة فتح أمر العمل" class="btn-primary" invisible="state != 'cancelled'" confirm="هل تريد إعادة فتح أمر العمل؟"/>
     <button name="%(yousentech_car_maintain.action_report_workshop_order)d" type="action" string="طباعة أمر العمل" icon="fa-file-text-o" class="btn-secondary" invisible="state not in ('approved', 'in_progress', 'done')"/>
     <button name="action_print_inspection" type="object" string="طباعة تقرير الفحص" icon="fa-stethoscope" class="btn-secondary" invisible="not inspection_line_ids"/>
     <field name="state" widget="statusbar" statusbar_visible="draft,approved,in_progress,done,cancelled"/>
    </header>
    <sheet>
      <field name="can_delete_workshop" invisible="1"/>
     <field name="workshop_section_nav_enabled" invisible="1"/>
      <field name="company_id" invisible="1" options="{'no_open': True}"/>
     <field name="invoice_count" invisible="1"/>
     <field name="refund_count" invisible="1"/>
     <field name="payment_count" invisible="1"/>
     <field name="workshop_approved" invisible="1"/>
     <field name="can_create_workshop_invoice" invisible="1"/>
     <field name="inspection_state" invisible="1"/>
     <field name="inspection_line_ids" invisible="1"/>
     <field name="currency_id" invisible="1"/>
     <field name="workshop_collection_complete" invisible="1"/>
     <field name="workshop_collection_remaining" invisible="1"/>
     <div class="oe_button_box" name="button_box">
      <button name="action_open_workshop_invoices" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="not invoice_count">
       <field name="invoice_count" widget="statinfo" string="الفواتير"/>
      </button>
      <button name="action_open_workshop_refunds" type="object" class="oe_stat_button" icon="fa-undo" invisible="not refund_count">
       <field name="refund_count" widget="statinfo" string="المرتجعات"/>
      </button>
      <button name="action_open_workshop_payments" type="object" class="oe_stat_button" icon="fa-money" invisible="not payment_count">
       <field name="payment_count" widget="statinfo" string="الدفعات"/>
      </button>
      <button groups="yousentech_car_maintain.group_workshop_inspection" name="action_open_inspection" type="object" class="oe_stat_button" icon="fa-stethoscope" invisible="inspection_state != 'done'">
       <div class="o_stat_info"><span class="o_stat_text">الفحص المعتمد</span><span class="o_stat_text">عرض التقرير</span></div>
      </button>
     </div>
     <div class="yt-wo-dashboard" dir="rtl">
      <div class="yt-wo-summary">
       <div class="yt-wo-summary-title"><span class="yt-wo-icon"><i class="fa fa-wrench" title="الخدمات"/></span><div><small>ملخص أمر العمل</small><h2 class="yt-wo-order-number"><field name="name" readonly="1" nolabel="1"/></h2><span>صيانة وخدمات السيارة</span></div></div>
       <div class="yt-wo-kpis yt-wo-kpis-six">
        <div class="yt-wo-kpi yt-wo-blue"><small>قيمة الخدمات</small><field name="service_amount" readonly="1" widget="monetary" options="{'currency_field':'currency_id'}"/></div>
        <div class="yt-wo-kpi yt-wo-teal"><small>قيمة قطع الغيار</small><field name="parts_amount" readonly="1" widget="monetary" options="{'currency_field':'currency_id'}"/></div>
        <div class="yt-wo-kpi yt-wo-neutral"><small>الإجمالي قبل الخصم</small><field name="amount_before_discount" readonly="1" widget="monetary" options="{'currency_field':'currency_id'}"/></div>
        <div class="yt-wo-kpi yt-wo-green"><small>الخصم</small><field name="discount_amount" readonly="1" widget="monetary" options="{'currency_field':'currency_id'}"/></div>
        <div class="yt-wo-kpi yt-wo-orange"><small>الضريبة</small><field name="amount_tax" readonly="1" widget="monetary" options="{'currency_field':'currency_id'}"/></div>
        <div class="yt-wo-kpi yt-wo-purple"><small>الإجمالي النهائي</small><field name="amount_total" readonly="1" widget="monetary" options="{'currency_field':'currency_id'}"/></div>
       </div>
      </div>
      <div class="yt-wo-section-layout" dir="rtl"><nav class="yt-wo-section-nav" aria-label="أقسام أمر العمل" invisible="not workshop_section_nav_enabled"><div class="yt-wo-nav-caption"><i class="fa fa-th-large" title="الأقسام"/> أقسام أمر العمل</div><div class="yt-wo-nav-option"><input type="radio" name="yt_wo_nav" value="customer"/><i class="fa fa-user" title="العميل والسيارة"/> <span>العميل والسيارة</span></div>
<div class="yt-wo-nav-option"><input type="radio" name="yt_wo_nav" value="lines" checked="checked"/><i class="fa fa-wrench" title="الخدمات وقطع الغيار"/> <span>الخدمات وقطع الغيار</span></div>
<div class="yt-wo-nav-option"><input type="radio" name="yt_wo_nav" value="extra"/><i class="fa fa-sliders" title="التفاصيل الإضافية"/> <span>التفاصيل الإضافية</span></div>
<div class="yt-wo-nav-option"><input type="radio" name="yt_wo_nav" value="finance"/><i class="fa fa-credit-card" title="الأمور المالية"/> <span>الأمور المالية</span></div>
<div groups="yousentech_car_maintain.group_workshop_inspection"><div class="yt-wo-nav-option"><input type="radio" name="yt_wo_nav" value="inspection"/><i class="fa fa-stethoscope" title="الفحص والمتابعة"/> <span>الفحص والمتابعة</span></div></div>
<div class="yt-wo-nav-option"><input type="radio" name="yt_wo_nav" value="all"/><i class="fa fa-th" title="عرض الكل"/> <span>عرض الكل</span></div></nav><div class="yt-wo-section-content"><div class="yt-wo-section-customer"><div class="yt-rec-native-grid yt-rec-two-card-grid">
       <div class="yt-rec-native-col yt-rec-col-customer-intake">
       <div class="yt-rec-native-card yt-rec-card-customer">
        <h3><i class="fa fa-user" aria-hidden="true" title="العميل"/> معلومات العميل</h3>
        <div class="yt-rec-form-rows yt-rec-customer-fields"><div class="yt-rec-field-row"><label for="partner_id" string="العميل"/><field name="partner_id" nolabel="1" placeholder="ابحث عن عميل أو أنشئ عميلاً جديدًا" readonly="state != 'draft'" options="{'no_open': True}"/></div><div class="yt-rec-field-row"><label for="partner_mobile" string="جوال العميل"/><field name="partner_mobile" nolabel="1" placeholder="رقم الجوال" widget="phone" readonly="state != 'draft'"/></div><div class="yt-rec-field-row"><label for="customer_source" string="مصدر العميل"/><field name="customer_source" nolabel="1" placeholder="كيف تعرف العميل علينا؟" readonly="state != 'draft'"/></div></div>
       </div>
       <div class="yt-rec-native-card yt-rec-card-intake">
        <h3><i class="fa fa-calendar-check-o" aria-hidden="true" title="الموعد"/> معلومات الاستقبال</h3>
        <div class="yt-rec-intake-fields yt-rec-form-rows">
         <div class="yt-rec-field-pair">
          <div class="yt-rec-field-row"><label for="arrival_at" string="تاريخ ووقت الدخول"/><field name="arrival_at" nolabel="1" readonly="state != 'draft'"/></div>
          <div class="yt-rec-field-row"><label for="intake_method" string="طريقة الاستلام"/><field name="intake_method" nolabel="1" readonly="state != 'draft'"/></div>
         </div>
         <div class="yt-rec-field-pair">
          <div class="yt-rec-field-row"><label for="odometer_in" string="عداد الدخول"/><field name="odometer_in" nolabel="1" readonly="state != 'draft'"/></div>
          <div class="yt-rec-field-row"><label for="odometer_out" string="عداد الخروج"/><field name="odometer_out" nolabel="1" readonly="state != 'draft'"/></div>
         </div>
        </div>
       </div>

       </div>
       <div class="yt-rec-native-col yt-rec-col-vehicle">
       <div class="yt-rec-native-card yt-rec-card-vehicle">
        <h3><i class="fa fa-car" aria-hidden="true" title="السيارة"/> معلومات السيارة</h3>
        <div class="yt-rec-form-rows yt-rec-primary-fields"><div class="yt-rec-field-row"><label for="vehicle_id" string="السيارة"/><field name="vehicle_id" nolabel="1" placeholder="اختر سيارة أو أنشئ سيارة جديدة" domain="[('partner_id','=',partner_id),('company_id','=',company_id)]" context="{'default_partner_id':partner_id,'default_company_id':company_id}" options="{'no_open': True, 'no_quick_create': True}" readonly="state != 'draft'"/></div></div>
        <div class="yt-rec-vehicle-details">
         <div class="yt-rec-detail-heading"><i class="fa fa-id-card-o" aria-hidden="true" title="الهوية"/> بيانات السيارة المختارة</div>
         <div class="yt-rec-vehicle-summary"><div class="yt-rec-summary-cell"><label for="vehicle_make_id" string="الشركة المصنعة"/><field name="vehicle_make_id" nolabel="1" readonly="1" options="{'no_open': True}"/></div><div class="yt-rec-summary-cell"><label for="vehicle_model_id" string="الموديل"/><field name="vehicle_model_id" nolabel="1" readonly="1" options="{'no_open': True}"/></div><div class="yt-rec-summary-cell"><label for="vehicle_year" string="سنة الصنع"/><field name="vehicle_year" nolabel="1" readonly="1"/></div><div class="yt-rec-summary-cell"><label for="vehicle_color" string="اللون"/><field name="vehicle_color" nolabel="1" readonly="1"/></div><div class="yt-rec-summary-cell"><label for="vehicle_vin" string="رقم الشاصي"/><field name="vehicle_vin" nolabel="1" readonly="1"/></div><div class="yt-rec-summary-cell"><label for="vehicle_plate_country" string="دولة اللوحة"/><field name="vehicle_plate_country" nolabel="1" readonly="1" options="{'no_open': True}"/></div></div>
         <div class="yt-rec-vehicle-hint"><i class="fa fa-info-circle" aria-hidden="true" title="معلومات"/> لإضافة سيارة استخدم «إنشاء وتحرير» من حقل السيارة.</div>
        </div>
       </div>
       </div>
      </div>
      </div><div class="yt-wo-section-lines"><div class="yt-wo-service-grid">
       <section class="yt-wo-card yt-wo-lines yt-wo-services">
        <h3><i class="fa fa-wrench" title="الخدمات"/> الخدمات</h3>
        <div class="yt-wo-table-wrap">
         <field name="service_line_ids" nolabel="1" readonly="state not in ('draft', 'in_progress')">
          <tree editable="bottom"><field name="company_id" column_invisible="1" options="{'no_open': True}"/>
           <field name="sequence" widget="handle" readonly="parent.state != 'draft'"/>
           <field name="product_id" string="الخدمة" domain="[('type','=','service'),('sale_ok','=',True)]" readonly="parent.state != 'draft'" options="{'no_open': True}"/>
           <field name="name" string="الوصف" readonly="parent.state != 'draft'"/><field name="technician_ids" string="الفنيون" widget="many2many_tags" options="{'no_create': True, 'no_open': True}" readonly="parent.state != 'draft'"/>
           <field name="product_uom_qty" string="الكمية" readonly="parent.state != 'draft'"/>
           <field name="price_unit" string="السعر" readonly="parent.state != 'draft'"/><field name="pricing_source" string="مصدر التسعير" readonly="1"/>
           <field name="line_subtotal" string="الإجمالي" readonly="1"/><field name="execution_done" string="أنجز الفنيون" readonly="parent.state != 'in_progress'"/>
          </tree>
         </field>
        </div>
       </section>
       <section class="yt-wo-card yt-wo-lines yt-wo-parts">
        <h3><i class="fa fa-cogs" title="قطع الغيار"/> قطع الغيار</h3>
        <div class="yt-wo-table-wrap">
         <field name="part_line_ids" nolabel="1" readonly="state not in ('draft', 'in_progress')">
          <tree editable="bottom"><field name="company_id" column_invisible="1" options="{'no_open': True}"/>
           <field name="sequence" widget="handle" readonly="parent.state != 'draft'"/>
           <field name="product_id" string="قطعة الغيار" domain="[('type','in',['product','consu']),('sale_ok','=',True)]" readonly="parent.state != 'draft'" options="{'no_open': True}"/>
           <field name="name" string="الوصف" readonly="parent.state != 'draft'"/>
           <field name="product_uom_qty" string="الكمية" readonly="parent.state != 'draft'"/>
           <field name="available_qty" string="المتاح" readonly="1"/>
           <field name="price_unit" string="السعر" readonly="parent.state != 'draft'"/><field name="pricing_source" string="مصدر التسعير" readonly="1"/>
           <field name="line_subtotal" string="الإجمالي" readonly="1"/>
          </tree>
         </field>
        </div>
       </section>
      </div>
      </div><div class="yt-wo-section-extra"><div class="yt-wo-bottom-cards">
       <div class="yt-rec-native-card yt-rec-customer-notes-card yt-wo-notes-bottom-card">
        <h3><i class="fa fa-comment-o" aria-hidden="true" title="ملاحظات"/> ملاحظات الاستقبال</h3>
        <div class="yt-rec-textarea-block"><field name="reception_notes" nolabel="1" placeholder="ملاحظات الاستقبال..." readonly="state != 'draft'"/></div>
       </div>
       <details class="yt-wo-card yt-wo-fold yt-wo-discount" open="open">
        <summary><i class="fa fa-percent" title="الخصم"/> الخصم <i class="fa fa-chevron-down yt-wo-chevron" title="توسيع أو طي القسم"/></summary>
        <div class="yt-wo-finance-body">
         <group col="2">
          <field name="discount_type" string="نوع الخصم" readonly="sale_order_id"/>
          <field name="discount_value" string="قيمة الخصم" readonly="sale_order_id"/>
         </group>
         <div class="yt-wo-finance-hint">تظهر قيمة الخصم والضريبة والإجمالي في الملخص العلوي.</div>
        </div>
       </details>
      </div>
      </div><div class="yt-wo-section-finance"><details class="yt-wo-card yt-wo-finance-tab yt-wo-finance-collapsible">
       <summary class="yt-wo-finance-heading"><i class="fa fa-credit-card" title="المدفوعات"/> الأمور المالية <i class="fa fa-chevron-down yt-wo-finance-main-chevron" title="توسيع أو طي القسم"/></summary>
       <div class="yt-wo-finance-body">
        <div class="yt-wo-finance-kpis">
         <div class="yt-wo-finance-kpi yt-wo-finance-billed"><small>إجمالي الفواتير</small><field name="finance_invoiced" nolabel="1" readonly="1" widget="monetary" options="{'currency_field':'currency_id'}"/></div>
         <div class="yt-wo-finance-kpi yt-wo-finance-credited"><small>الإشعارات الدائنة</small><field name="finance_credited" nolabel="1" readonly="1" widget="monetary" options="{'currency_field':'currency_id'}"/></div>
         <div class="yt-wo-finance-kpi yt-wo-finance-paid"><small>المبالغ المقبوضة</small><field name="finance_received" nolabel="1" readonly="1" widget="monetary" options="{'currency_field':'currency_id'}"/></div>
         <div class="yt-wo-finance-kpi yt-wo-finance-refunded"><small>المبالغ المردودة</small><field name="finance_refunded" nolabel="1" readonly="1" widget="monetary" options="{'currency_field':'currency_id'}"/></div>
         <div class="yt-wo-finance-kpi yt-wo-finance-due"><small>المتبقي للتحصيل</small><field name="finance_due" nolabel="1" readonly="1" widget="monetary" options="{'currency_field':'currency_id'}"/></div>
         <div class="yt-wo-finance-kpi yt-wo-finance-return"><small>المتبقي للرد</small><field name="finance_to_refund" nolabel="1" readonly="1" widget="monetary" options="{'currency_field':'currency_id'}"/></div>
        </div>
        <details class="yt-wo-finance-section yt-wo-finance-fold">
         <summary><i class="fa fa-file-text-o" title="المستند"/> الفواتير والإشعارات الدائنة <i class="fa fa-chevron-down yt-wo-finance-chevron" title="توسيع أو طي القسم"/></summary>
         <field name="finance_invoice_ids" nolabel="1" readonly="1" options="{'no_open': True}">
          <tree create="false" delete="false" edit="false">
           <field name="name" string="رقم المستند"/>
           <field name="move_type" string="نوع المستند"/>
           <field name="state" string="الحالة"/>
           <field name="amount_total" string="الإجمالي"/>
           <field name="amount_residual" string="المتبقي"/>
           <field name="payment_state" string="حالة السداد"/>
          </tree>
         </field>
        </details>
        <div class="yt-wo-finance-section">
         <h4><i class="fa fa-money" title="المبلغ"/> الدفعات</h4>
         <field name="finance_payment_ids" nolabel="1" readonly="1" options="{'no_open': True}">
          <tree create="false" delete="false" edit="false">
           <field name="name" string="رقم الدفعة"/>
           <field name="date" string="التاريخ"/>
           <field name="payment_type" string="نوع الدفعة"/>
           <field name="amount" string="المبلغ"/>
           <field name="state" string="الحالة"/>
          </tree>
         </field>
        </div>
        <div class="yt-wo-finance-cancel-reason" invisible="not cancel_reason">
         <label for="cancel_reason" string="سبب الإلغاء"/>
         <field name="cancel_reason" nolabel="1" readonly="1"/>
        </div>
       </div>
      </details>
      </div><div class="yt-wo-section-extra-more"><details class="yt-rec-native-card yt-rec-other-card yt-wo-extra-bottom">
       <summary><i class="fa fa-sliders" title="الإعدادات"/> بيانات أخرى <i class="fa fa-chevron-down yt-rec-toggle-icon" title="توسيع أو طي القسم"/></summary>
       <div class="yt-wo-extra-body">
        <div class="yt-wo-extra-stock-fields">
         <div class="yt-rec-field-row"><label for="location_id" string="موقع قطع الغيار"/><field name="location_id" nolabel="1" options="{'no_create': True, 'no_open': True}" readonly="sale_order_id"/></div>
         <div class="yt-rec-field-row"><label for="sale_order_id" string="أمر البيع"/><field name="sale_order_id" nolabel="1" readonly="1" options="{'no_open': True}"/></div>
        </div>
      <div class="yt-rec-native-card yt-rec-other-details">
        <div class="yt-rec-form-rows">
         <div class="yt-rec-field-pair">
          <div class="yt-rec-field-row"><label for="branch_id" string="الفرع"/><field name="branch_id" nolabel="1" readonly="1" options="{'no_open': True}"/></div>
          <div class="yt-rec-field-row"><label for="advisor_id" string="المستخدم"/><field name="advisor_id" nolabel="1" readonly="1" options="{'no_open': True}"/></div>
           <div class="yt-rec-field-row"><label for="customer_type_snapshot" string="نوع العميل عند إنشاء الأمر"/><field name="customer_type_snapshot" nolabel="1" readonly="1"/></div>
         </div>
        </div>
        <div class="yt-rec-textarea-block"><label for="internal_notes" string="ملاحظات داخلية"/><field name="internal_notes" nolabel="1" placeholder="ملاحظات داخلية خاصة بالموظفين..." groups="base.group_user" readonly="state != 'draft'"/></div>
       </div>
       </div>
      </details></div><div class="yt-wo-section-inspection" groups="yousentech_car_maintain.group_workshop_inspection"><div class="yt-wo-card yt-wo-inspection-card"><h3><i class="fa fa-stethoscope" title="الفحص"/> الفحص والمتابعة</h3><div class="yt-wo-inspection-body"><p>عرض فحص السيارة ومتابعته وفق الصلاحيات المعتمدة.</p><field name="inspection_state" readonly="1" nolabel="1"/><button name="action_open_inspection" type="object" string="فتح الفحص والمتابعة" icon="fa-stethoscope" class="btn-primary" invisible="state in ('cancelled', 'done') and inspection_state != 'done'"/></div></div></div></div></div>
     </div>
    </sheet>
   </form>
  </field>
 </record>
 <record id="action_reception_native_form_view" model="ir.actions.act_window.view">
  <field name="sequence" eval="3"/>
  <field name="view_mode">form</field>
  <field name="view_id" ref="view_reception_workshop_form"/>
  <field name="act_window_id" ref="action_reception_native"/>
 </record>
 <record id="action_workshop_orders" model="ir.actions.act_window">
  <field name="name">أوامر العمل</field>
  <field name="res_model">yt.reception.order</field>
  <field name="view_mode">tree,form</field>
  <field name="views" eval="[(ref('view_reception_order_tree'),'tree'),(ref('view_reception_workshop_form'),'form')]"/>
   <field name="search_view_id" ref="view_workshop_order_search"/>
   <field name="context">{'search_default_active_workshop_orders':1}</field>
 </record>
 
 <record id="view_workshop_finance_settings_form" model="ir.ui.view">
  <field name="name">yt.workshop.finance.settings.form</field>
  <field name="model">yt.workshop.finance.settings</field>
  <field name="arch" type="xml">
   <form string="إعدادات الورشة المالية" class="yt-finance-settings-form">
    <sheet>
     <div class="yt-config-hero" dir="rtl">
      <span class="yt-config-hero-icon"><i class="fa fa-sliders" title="الإعدادات المالية"/></span>
      <div>
       <h2>إعدادات الورشة المالية</h2>
       <p>إعداد الضريبة وضوابط تحصيل المدفوعات وإنشاء فواتير أوامر العمل.</p>
      </div>
     </div>
     <div class="yt-config-grid" dir="rtl">
      <div class="yt-config-card">
       <h3><i class="fa fa-building-o" title="الشركة"/> الشركة والضرائب</h3>
       <p class="yt-config-description">تحديد الشركة والضريبة التي تُطبّق على مبيعات الورشة.</p>
       <group col="2">
        <field name="company_id" string="الشركة" readonly="1" options="{'no_open': True}"/>
        <field name="tax_id" string="ضريبة المبيعات المعتمدة" options="{'no_create': True, 'no_open': True}"/>
       </group>
      </div>
      <div class="yt-config-card">
       <h3><i class="fa fa-credit-card" title="التحصيل"/> سياسة التحصيل والفوترة</h3>
       <p class="yt-config-description">تحديد متى يمكن إصدار فاتورة للعميل النقدي.</p>
       <group col="2">
        <field name="require_full_payment_before_invoice" string="اشتراط اكتمال الدفع قبل إنشاء الفاتورة"/>
       </group>
      </div>
     </div>
     <div class="yt-config-card yt-wo-navigation-setting" dir="rtl">
      <h3><i class="fa fa-columns" title="طريقة العرض"/> طريقة عرض أمر العمل</h3>
      <p class="yt-config-description">قائمة جانبية للتنقل بين أقسام أمر العمل دون تغيير البطاقات أو العمليات الحالية. عند الإيقاف تظهر الشاشة الكاملة كما كانت.</p>
      <group col="2">
       <field name="workshop_section_nav_enabled" string="تفعيل القائمة الجانبية لأقسام أمر العمل"/>
      </group>
     </div>
     <div class="yt-finance-collection-note" dir="rtl">
      <div class="yt-finance-collection-note-title"><i class="fa fa-info-circle" title="توضيح سياسة التحصيل"/> توضيح سياسة التحصيل والفوترة</div>
      <p>تُقرأ طبيعة التعامل من بطاقة العميل. العميل النقدي يخضع لشرط اكتمال الدفع عند تفعيله، أما العميل الآجل فيمكن إنشاء فاتورته قبل اكتمال التحصيل، سواء كان فردًا أو شركة.</p>
     </div>
    </sheet>
   </form>
  </field> </record>
 <record id="action_workshop_finance_settings" model="ir.actions.server">
  <field name="name">الإعدادات</field>
  <field name="model_id" ref="model_yt_workshop_finance_settings"/>
  <field name="state">code</field>
  <field name="code">action = env['yt.workshop.finance.settings'].action_open_settings()</field>
 </record>
 <menuitem id="menu_workshop_finance_settings" name="الإعدادات المالية" parent="menu_inspection_config" action="action_workshop_finance_settings" sequence="90" groups="base.group_system"/>

 <record id="view_workshop_advance_payment_wizard_form" model="ir.ui.view">
  <field name="name">yt.workshop.advance.payment.wizard.form</field>
  <field name="model">yt.workshop.advance.payment.wizard</field>
  <field name="arch" type="xml">
   <form string="تسجيل دفعة مقدمة" create="false" class="yt-workshop-advance-wizard">
    <field name="company_id" invisible="1" options="{'no_open': True}"/>
    <field name="currency_id" invisible="1"/>
    <field name="allowed_journal_ids" invisible="1"/>
    <field name="available_payment_method_line_ids" invisible="1"/>
    <div class="yt-advance-header">
     <div class="yt-advance-header-icon"><i class="fa fa-money" title="المبلغ"/></div>
     <div>
      <h2>تسجيل دفعة مقدمة</h2>
      <p>تحصيل مبلغ من العميل قبل إصدار الفاتورة وربطه بأمر العمل</p>
     </div>
    </div>
    <div class="yt-advance-content">
     <div class="yt-advance-context">
      <div class="yt-advance-context-field"><span>أمر العمل</span><field name="order_id" nolabel="1" readonly="1"/></div>
      <div class="yt-advance-context-field"><span>العميل</span><field name="partner_id" nolabel="1" readonly="1" options="{'no_open': True}"/></div>
     </div>
     <div class="yt-advance-section-title"><i class="fa fa-credit-card" title="المدفوعات"/> تفاصيل التحصيل</div>
     <div class="yt-advance-fields">
      <div class="yt-advance-field"><label for="journal_id" string="الصندوق / البنك"/><field name="journal_id" nolabel="1" options="{'no_create': True, 'no_open': True}"/></div>
      <div class="yt-advance-field"><label for="payment_method_line_id" string="طريقة الدفع"/><field name="payment_method_line_id" nolabel="1" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/></div>
      <div class="yt-advance-field yt-advance-amount"><label for="amount" string="المبلغ"/><field name="amount" nolabel="1"/></div>
      <div class="yt-advance-field"><label for="payment_date" string="تاريخ الدفعة"/><field name="payment_date" nolabel="1"/></div>
      <div class="yt-advance-field yt-advance-field-wide"><label for="memo" string="البيان"/><field name="memo" nolabel="1" placeholder="مثال: دفعة مقدمة لصيانة السيارة"/></div>
     </div>
     <div class="yt-advance-hint"><i class="fa fa-info-circle" title="معلومات"/> تُسجّل الدفعة على حساب العميل ويمكن تسويتها مع الفاتورة لاحقًا.</div>
    </div>
    <footer>
     <button name="action_confirm_advance" type="object" string="تأكيد الدفعة" class="btn-primary"/>
     <button string="إلغاء" special="cancel" class="btn-secondary"/>
    </footer>
   </form>
  </field>
 </record>
 <record id="view_workshop_cancel_wizard_form" model="ir.ui.view">
  <field name="name">yt.workshop.cancel.wizard.form</field>
  <field name="model">yt.workshop.cancel.wizard</field>
  <field name="arch" type="xml">
   <form string="إلغاء أمر العمل" create="false">
    <group><field name="order_id"/><field name="reason" required="1"/></group>
    <footer>
     <button name="action_confirm_cancel" type="object" string="تأكيد الإلغاء" class="btn-primary"/>
     <button string="رجوع" special="cancel" class="btn-secondary"/>
    </footer>
   </form>
  </field>
 </record>

 <record id="view_workshop_category_pricing_tree" model="ir.ui.view">
  <field name="name">yt.workshop.category.pricing.tree</field>
  <field name="model">yt.workshop.category.pricing</field>
  <field name="arch" type="xml">
   <tree string="سياسات تسعير قطع الغيار">
    <field name="sequence" widget="handle"/>
    <field name="company_id" groups="base.group_multi_company"/>
    <field name="category_scope"/>
    <field name="category_ids" widget="many2many_tags"/>
    <field name="customer_scope"/>
    <field name="partner_ids" widget="many2many_tags"/>
    <field name="active"/>
   </tree>
  </field>
 </record>
 <record id="view_workshop_category_pricing_form" model="ir.ui.view">
  <field name="name">yt.workshop.category.pricing.form</field>
  <field name="model">yt.workshop.category.pricing</field>
  <field name="arch" type="xml">
   <form string="سياسة تسعير قطع الغيار" class="yt-pricing-policy-form">
    <sheet>
     <div class="yt-pricing-head" dir="rtl">
      <div class="yt-pricing-head-icon"><i class="fa fa-line-chart" title="سياسة التسعير"/></div>
      <div>
       <h2>سياسة تسعير قطع الغيار</h2>
       <p>حدد نطاق تطبيق السياسة ثم اضبط نسب الزيادة حسب تكلفة الصنف ونوع العميل.</p>
      </div>
     </div>
     <div class="yt-pricing-settings" dir="rtl">
      <section class="yt-pricing-panel">
       <h3><i class="fa fa-cubes" title="المنتجات"/> نطاق المنتجات</h3>
       <group col="2">
        <field name="company_id" string="الشركة" groups="base.group_multi_company" options="{'no_open': True}"/>
        <field name="category_scope" string="تطبيق على الفئات"/>
        <field name="category_ids" string="الفئات المحددة" widget="many2many_tags" options="{'no_create': True, 'no_open': True}" invisible="category_scope != 'selected'" required="category_scope == 'selected'"/>
       </group>
      </section>
      <section class="yt-pricing-panel">
       <h3><i class="fa fa-users" title="العملاء"/> نطاق العملاء</h3>
       <group col="2">
        <field name="customer_scope" string="تطبيق على العملاء"/>
        <field name="partner_ids" string="العملاء المحددون" widget="many2many_tags" options="{'no_open': True}" invisible="customer_scope != 'selected'" required="customer_scope == 'selected'"/>
        <field name="sequence" string="الأولوية"/>
        <field name="active" string="سياسة نشطة"/>
       </group>
      </section>
     </div>
     <section class="yt-pricing-tiers" dir="rtl">
      <div class="yt-pricing-section-heading">
       <h3><i class="fa fa-percent" title="النسب"/> شرائح التكلفة ونسب الزيادة</h3>
       <p>أدخل تكلفة البداية والنهاية لكل شريحة، ثم نسبة الأفراد والشركات بشكل مستقل. القيمة صفر في نهاية الشريحة تعني بلا حد أعلى.</p>
      </div>
      <div class="yt-pricing-table">
       <field name="tier_ids" nolabel="1">
        <tree editable="bottom" create="1" delete="1">
         <field name="min_cost" string="التكلفة من"/>
         <field name="max_cost" string="التكلفة إلى (0 = بلا حد)"/>
         <field name="individual_percent" string="نسبة الأفراد (%)"/>
         <field name="company_percent" string="نسبة الشركات (%)"/>
        </tree>
       </field>
      </div>
     </section>
     <div class="yt-pricing-guide" dir="rtl">
      <i class="fa fa-info-circle" title="معلومات التسعير"/>
      <div>
       <strong>كيف يُحسب سعر البيع؟</strong>
       <p>سعر البيع = تكلفة المنتج × (1 + نسبة الزيادة ÷ 100). إذا كانت التكلفة صفرًا أو لم تنطبق سياسة، يُستخدم سعر البيع الافتراضي للمنتج. السياسة المخصصة للعميل لها الأولوية على السياسة العامة.</p>
      </div>
     </div>
    </sheet>
   </form>
  </field>
 </record>
 <record id="action_workshop_category_pricing" model="ir.actions.act_window">
  <field name="name">سياسات تسعير قطع الغيار</field>
  <field name="res_model">yt.workshop.category.pricing</field>
  <field name="view_mode">tree,form</field>
 </record>
 <menuitem id="menu_workshop_category_pricing" name="سياسات تسعير قطع الغيار"
           parent="menu_inspection_config" action="action_workshop_category_pricing"
           sequence="91" groups="base.group_system"/>
</odoo>
