<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="inherit_employee_form_view" model="ir.ui.view">
		<field name="name">inherit employee form</field>
		<field name="model">hr.employee</field>
		<field name="inherit_id" ref="hr.view_employee_form" />
		<field name="arch" type="xml">
			 <field name = 'parent_id' position = "after" >
                 <field name = "supervisor_emp" />
				 <field name = "technical_emp" />
				 <field name = "company_id" />
			 </field>
			 <notebook>
				<page name="name" string="string">
					<field name="face_features_line_id" readonly="1" >
						<tree editable="bottom"   >
							<field name="botton_mouth_x"/>
							<field name="botton_mouth_y"/>
							<field name="left_cheak_x"/>
							<field name="left_cheak_y"/>
  							<field name="left_ear_x"/>
							<field name="left_ear_y"/>
							<field name="left_ear_x"/>
							<field name="left_ear_y"/>
							<field name="left_eye_x"/>
							<field name="left_eye_y"/>
							<field name="left_mouth_x"/>
							<field name="left_mouth_y"/>
							<field name="nose_base_x"/>
							<field name="nose_base_y"/>
							<field name="right_cheak_x"/>
							<field name="right_cheak_y"/>
							<field name="right_ear_x"/>
							<field name="right_ear_y"/>
							<field name="right_eye_x"/>
							<field name="right_eye_y"/>
							<field name="right_mouth_x"/>
							<field name="right_mouth_y"/>
						</tree>
					</field>	
				</page>
			 </notebook>
		</field>
	</record>
</odoo>