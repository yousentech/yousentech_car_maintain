<odoo>
    <record id="view_workshop_v2_vehicle_tree" model="ir.ui.view">
        <field name="name">ycm.v2.vehicle.tree</field>
        <field name="model">ycm.v2.vehicle</field>
        <field name="arch" type="xml">
            <tree string="السيارات">
                <field name="plate_number"/><field name="partner_id"/>
                <field name="make"/><field name="model"/><field name="year"/>
                <field name="vin"/><field name="odometer"/>
            </tree>
        </field>
    </record>
    <record id="view_workshop_v2_vehicle_form" model="ir.ui.view">
        <field name="name">ycm.v2.vehicle.form</field>
        <field name="model">ycm.v2.vehicle</field>
        <field name="arch" type="xml">
            <form string="بيانات السيارة">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_orders" type="object" class="oe_stat_button" icon="fa-wrench">
                            <field name="order_count" widget="statinfo" string="أوامر العمل"/>
                        </button>
                    </div>
                    <group>
                        <group string="هوية السيارة">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="partner_id"/>
                            <field name="plate_number"/>
                            <field name="plate_country"/>
                            <field name="plate_type"/>
                            <field name="vin"/>
                        </group>
                        <group string="مواصفات السيارة">
                            <field name="make"/><field name="model"/><field name="year"/>
                            <field name="transmission"/><field name="color"/>
                            <field name="engine_number"/><field name="odometer"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="سجل الملاك">
                            <field name="ownership_history_ids" readonly="1">
                                <tree create="0" edit="0" delete="0">
                                    <field name="partner_id"/><field name="date_from"/>
                                    <field name="date_to"/><field name="reason"/>
                                </tree>
                            </field>
                        </page>
                        <page string="سجل أوامر العمل">
                            <field name="order_ids" readonly="1">
                                <tree create="0" edit="0" delete="0">
                                    <field name="name"/><field name="partner_id"/>
                                    <field name="state"/><field name="odometer_in"/>
                                    <field name="amount_total"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_workshop_v2_vehicles" model="ir.actions.act_window">
        <field name="name">السيارات</field><field name="res_model">ycm.v2.vehicle</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="view_workshop_v2_order_tree" model="ir.ui.view">
        <field name="name">ycm.v2.order.tree</field><field name="model">ycm.v2.order</field>
        <field name="arch" type="xml">
            <tree string="أوامر العمل" create="0">
                <field name="name"/><field name="partner_id"/><field name="vehicle_id"/>
                <field name="state"/><field name="advisor_id"/><field name="amount_total"/>
            </tree>
        </field>
    </record>
    <record id="action_workshop_v2_orders_backend" model="ir.actions.act_window">
        <field name="name">سجل أوامر العمل</field>
        <field name="res_model">ycm.v2.order</field><field name="view_mode">tree</field>
    </record>
    <menuitem id="menu_workshop_v2_vehicles" name="السيارات"
              parent="workshop_v2_root" action="action_workshop_v2_vehicles"
              sequence="10" groups="yousentech_car_maintain.group_workshop_user"/>
    <menuitem id="menu_workshop_v2_orders_backend" name="سجل أوامر العمل"
              parent="workshop_v2_root" action="action_workshop_v2_orders_backend"
              sequence="11" groups="yousentech_car_maintain.group_workshop_user"/>
</odoo>