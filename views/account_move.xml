<?xml version="1.0" encoding="UTF-8"?>
<odoo>
     <record id="account_move_mizan_view" model="ir.ui.view">
          <field name="name">mizan order In invoice</field>
          <field name="model">account.move</field>
          <field name="inherit_id" ref="account.view_move_form" />
          <field name="arch" type="xml">
               <xpath expr="//field[@name='ref']" position="after">
                    <field name="move_type" invisible="1" />

                    <field name="partner_mobile" readonly="1"
                         invisible="move_type not in ['out_invoice','out_refund']" />
                    <field name="car_panel_no" readonly="1"
                         invisible="move_type not in ['out_invoice','out_refund']" />
                    <field name="car_type" readonly="1"
                         invisible="move_type not in ['out_invoice','out_refund']" />
                    <field name="is_guarantee" readonly="1"
                         invisible="move_type not in ['out_invoice','out_refund']" />
                    <field name="maint_wo_id" readonly="1"
                         invisible="move_type not in ['out_invoice','out_refund']" />
                    <field name="collecting_products_report_flag" invisible="1" />

                

               </xpath>
           
          </field>
     </record>
     <record id="account_move_mizan_tree_view" model="ir.ui.view">
          <field name="name">mizan In tree invoice</field>
          <field name="model">account.move</field>
          <field name="inherit_id" ref="account.view_invoice_tree" />
          <field name="arch" type="xml">
               <xpath expr="//field[@name='ref']" position="after">
                    <field name="partner_mobile"
                         invisible="move_type not in ['out_invoice','out_refund']" />
                    <field name="car_panel_no"
                         invisible="move_type not in ['out_invoice','out_refund']" />
                    <field name="car_type" invisible="move_type not in ['out_invoice','out_refund']" />

                    <field name="maint_wo_id"
                         invisible="move_type not in ['out_invoice','out_refund']" />
               </xpath>
          </field>
     </record>
     <record id="account_move_mizan_search2" model="ir.ui.view">
          <field name="name">account.move.search2.mizan</field>
          <field name="model">account.move</field>
          <field name="inherit_id" ref="account.view_account_invoice_filter" />
          <field name="arch" type="xml">

               <xpath expr="//search" position="inside">
                    <field name="partner_mobile" />
                    <field name="car_panel_no" />
                    <field name="car_type" />
     
                    <field name="maint_wo_id" />
               </xpath>

          </field>
     </record>


</odoo>