<?xml version="1.0"?>
<odoo>

    <menuitem id="branch_assignment_menu" name="الاسناد للفروع" parent="hr.menu_hr_root" />

    <record id="view_hr_supervisor_assign_form" model="ir.ui.view">
        <field name="name">hr.supervisor.assignments.form</field>
        <field name="model">hr.supervisor.assignments</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form >
                <sheet>
                    <group >
                         <group>
                             <field name="supervisor_emp_id"  options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"  />
                                <field name="branch_id"  options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}" />

                            <field name="assign_date"  />


                         </group>
                        <group>
                            <field name="state"  />
                            <field name="close_date"  />
                        </group>

                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_hr_supervisor_assign_tree" model="ir.ui.view">
        <field name="name">hr.supervisor.assignments.tree</field>
        <field name="model">hr.supervisor.assignments</field>
         <field name="arch" type="xml">
            <tree >
                         <field name="supervisor_emp_id"  options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}" />
                        <field name="assign_date"  />
                        <field name="branch_id"  options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}" />
                        <field name="state"  />
                        <field name="close_date"  />
            </tree>
        </field>
    </record>
    <record id="view_hr_supervisor_assign_search" model="ir.ui.view">
        <field name="name">hr.supervisor.assignments.search</field>
        <field name="model">hr.supervisor.assignments</field>
         <field eval="10" name="priority"/>

         <field name="arch" type="xml">
            <search >
                         <field name="supervisor_emp_id"  />
                        <field name="assign_date"  />
                        <field name="branch_id"  />
                        <field name="state"  />
                        <field name="close_date"  />
                       <separator/>
                       <group expand='0' string='Filters'>
                            <filter string="حسب الفني" name="supervisor_filter" domain="[]" context="{'group_by': 'supervisor_emp_id'}"/>

                           <filter string="حسب الفرع" name="branch_filter" domain="[]" context="{'group_by': 'branch_id'}"/>

                           <filter string="حسب الحالة" name="state_filter" domain="[]" context="{'group_by': 'state'}"/>

                      </group>
                      <separator/>
                      <group expand='0' string='Filters'>
                           <filter string="الاسناد النشط" name="currecnt_state_filter" domain="[('state','=', 'current')]"/>

                    </group>
            </search>
        </field>
    </record>

    <record model="ir.actions.act_window" id="hr_supervisor_assign_action">
        <field name="name">اسناد المشرفين للفروع</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.supervisor.assignments</field>
        <field name="view_mode">tree,form</field>
        <field name="target">current</field>
        <field name="view_id" ref="view_hr_supervisor_assign_tree" />
    </record>

       <menuitem id="supervisor_assign_menu" name="اسناد المشرفين للفروع" parent="branch_assignment_menu"  sequence="2"
                   action="hr_supervisor_assign_action" />

</odoo>
