<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>
    <record id="wo_services_analysis_tree_view" model="ir.ui.view">
      <field name="name">wo_services_analysis_tree_view</field>
      <field name="model">wo.services.analysis.view</field>
      <field name="arch" type="xml">
        <tree create="0"
          default_order="product_categ_id,product_id,partner_id,header_id,invoice_no,car_panel_no,partner_mobile,state,order_date,create_date,company_id,unit_price,qty,total,price_include,untaxed_amount,discount,amount_tax,amount_with_tax,supervisor_id">
          <field name="id" widget="handle" />
          <field name="header_id"
            options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}" />
          <field name="partner_id"
            options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}" />
          <field name="order_date" />
          <field name="create_date" readonly="1" />
          <field name="company_id" readonly="1" />
          <field name="invoice_no" readonly="1" />
          <field name="car_panel_no" readonly="1" />
          <field name="partner_mobile" readonly="1" />
          <field name="state" readonly="1" optional="hide" />
          <field name="product_categ_id" readonly="1" optional="hide" />
          <field name="product_id" readonly="1" optional="hide" />
          <field name="unit_price" readonly="1" optional="hide" />
          <field name="qty" readonly="1" optional="hide" />
          <field name="total" readonly="1" optional="hide" />
          <field name="price_include" readonly="1" optional="hide" />
          <field name="untaxed_amount" readonly="1" optional="hide" />
          <field name="discount" readonly="1" optional="hide" />
          <field name="amount_tax" readonly="1" optional="hide" />
          <field name="amount_with_tax" readonly="1" optional="hide" />
          <field name="supervisor_id"
            options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}" optional="hide" />

        </tree>
      </field>
    </record>
    <record id="wo_services_analysis_search_view" model="ir.ui.view">
      <field name="name">البحث في </field>
      <field name="model">wo.services.analysis.view</field>
      <field name="arch" type="xml">
        <search string=" البحث في ">

          <field name="header_id"
            options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}" />
          <field name="partner_id"
            options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}" />
          <field name="order_date" />
          <field name="create_date" readonly="1" />
          <field name="company_id" readonly="1" />
          <field name="invoice_no" readonly="1" />
          <field name="car_panel_no" readonly="1" />
          <field name="partner_mobile" readonly="1" />
          <field name="state" readonly="1" />
          <field name="product_categ_id" readonly="1" />
          <field name="product_id" readonly="1" />
          <field name="unit_price" readonly="1" />
          <field name="qty" readonly="1" />
          <field name="total" readonly="1" />
          <field name="untaxed_amount" readonly="1" />
          <field name="discount" readonly="1" />
          <field name="amount_tax" readonly="1" />
          <field name="amount_with_tax" readonly="1" />
          <field name="supervisor_id"
            options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}" />
        </search>
      </field>
    </record>

    <record id="action_wo_services_analysis_view" model="ir.actions.act_window">
      <field name="name">تحليل مبيعات الخدمات </field>
      <field name="res_model">wo.services.analysis.view</field>
      <field name="type">ir.actions.act_window</field>
      <field name="view_mode">tree</field>
      <field name="view_id" ref="wo_services_analysis_tree_view" />
      <field name="target">current</field>
    </record>

    <menuitem id="menu_wo_services_analysis_view" name="تحليل مبيعات الخدمات"
      parent="mizan_report_menu" sequence="100"
      action="action_wo_services_analysis_view"
    />
  </data>
</odoo>