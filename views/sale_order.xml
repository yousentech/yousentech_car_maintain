<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="inherit_sale_order_mizan" model="ir.ui.view">
            <field name="name">sales.order.mizan</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="partner_mobile" />
                    <field name="sale_man_id"
                        options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"
                        readonly="1" string="مندوب نظام الصيانة" />
                </xpath>
            </field>
        </record>
    </data>
</odoo>