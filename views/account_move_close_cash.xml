<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="account_close_cash_view" model="ir.ui.view">
		<field name="name">cash close In invoice</field>
		<field name="model">account.move</field>
		<field name="inherit_id" ref="account.view_move_form" />
		<field name="arch" type="xml">
                   <xpath expr="//field[@name='to_check']" position="after">
                            <field name="move_type" invisible="1"/>
                             <field name="cash_close_id"  readonly="1" />

                   </xpath>

		</field>
	</record>
     <record id="account_close_cash_tree_view" model="ir.ui.view">
		<field name="name">cash close In In tree invoice</field>
		<field name="model">account.move</field>
		<field name="inherit_id" ref="account.view_invoice_tree" />
		<field name="arch" type="xml">
                   <xpath expr="//field[@name='ref']" position="after">
                       <field name="move_type" invisible="1"/>

                       <field name="cash_close_id" invisible="[('move_type','!=', 'entry')]"  options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}" readonly="1" string="مندوب نظام الصيانة"/>

                   </xpath>
        </field>
	</record>
	 <record id="account_close_cash_search" model="ir.ui.view">
                    <field name="name">cash close In.search</field>
                    <field name="model">account.move</field>
                    <field name="inherit_id" ref="account.view_account_invoice_filter" />
                    <field name="arch" type="xml">

                        <xpath expr="//search" position="inside">
                            <field name="move_type" invisible="1"/>

                            <field name="cash_close_id" invisible="[('move_type','!=', 'entry')]"  options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}" readonly="1" string="مندوب نظام الصيانة"/>
                        </xpath>

                    </field>
         </record>


</odoo>