<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>
    <record id="wo_technicals_analysis_tree_view" model="ir.ui.view">
      <field name="name">wo_technicals_analysis_tree_view</field>
      <field name="model">wo.technicals.analysis.view</field>
      <field name="arch" type="xml">
        <tree create="0" default_order="hr_technical_assignments_id,header_id desc">
          <field name="id" widget="handle" />
          <field name="hr_technical_assignments_id" readonly="1" />
          <field name="header_id"
            options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}" />
          <field name="partner_id"
            options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}" />
          <field name="order_date" />
          <field name="create_date" readonly="1" />
          <field name="end_date" readonly="1" />
          <field name="time_difference" readonly="1" />
          <field name="company_id" readonly="1" />
          <field name="invoice_no" readonly="1" />
          <field name="car_panel_no" readonly="1" />
          <field name="partner_mobile" readonly="1" />
          <field name="technical_count" readonly="1" />
          <field name="hr_technical_assignments_id" readonly="1" />
          <field name="product_id" readonly="1" />
          <field name="unit_price" readonly="1" />
          <field name="qty" readonly="1" />
          <field name="total" readonly="1" />
          <field name="untaxed_amount" readonly="1" />
          <field name="discount" readonly="1" />
          <field name="amount_tax" readonly="1" />
          <field name="amount_with_tax" readonly="1" />
          <field name="product_categ_id" readonly="1" />
          <field name="supervisor_id"
            options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}" />
          <field name="state" readonly="1" />
        </tree>
      </field>
    </record>

    <record id="wo_technicals_analysis_search_view" model="ir.ui.view">
      <field name="name">البحث في </field>
      <field name="model">wo.technicals.analysis.view</field>
      <field name="arch" type="xml">
        <search string=" البحث في ">
          <field name="header_id"
            options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}" />
          <field name="partner_id"
            options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}" />
          <field name="order_date" />
          <field name="create_date" readonly="1" />
          <field name="company_id" readonly="1" />
          <field name="invoice_no" readonly="1" />
          <field name="car_panel_no" readonly="1" />
          <field name="partner_mobile" readonly="1" />
          <field name="technical_count" readonly="1" />
          <field name="hr_technical_assignments_id" readonly="1" />
          <field name="product_id" readonly="1" />
          <field name="unit_price" readonly="1" />
          <field name="qty" readonly="1" />
          <field name="total" readonly="1" />
          <field name="untaxed_amount" readonly="1" />
          <field name="discount" readonly="1" />
          <field name="amount_tax" readonly="1" />
          <field name="amount_with_tax" readonly="1" />
          <field name="product_categ_id" readonly="1" />
          <field name="supervisor_id"
            options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}" />
          <field name="state" readonly="1" />

        </search>
      </field>
    </record>

    <record id="action_wo_technicals_analysis_view" model="ir.actions.act_window">
      <field name="name">تحليل مبيعات الفنيين </field>
      <field name="res_model">wo.technicals.analysis.view</field>
      <field name="type">ir.actions.act_window</field>
      <field name="view_mode">tree</field>
      <field name="view_id" ref="wo_technicals_analysis_tree_view" />
      <field name="target">current</field>
    </record>

    <menuitem id="menu_wo_technicals_analysis_view" name="تحليل مبيعات الفنيين"
      parent="mizan_report_menu" sequence="100"
      action="action_wo_technicals_analysis_view"
    />
  </data>
</odoo>