        <!--        الخدمات                 -->
        <record model="ir.ui.view" id="mizan_services_types_view">
            <field name="name">services.types.view</field>
            <field name="model">mizan.services.types</field>
            <field name="type">form</field>
              <field name="arch" type="xml">
                    <form string="انواع الخدمات">
                        <sheet>
                            <group>
                                <field name="name" />
                               <field name="en_name" />

                                <field name="product_id" />
                                <field name="price" />

                                 <field name="company_id" string="الشركة"  options="{'no_create': True}" groups="base.group_multi_company"/>
                            </group>

                         </sheet>
                     </form>
              </field>
         </record>

        <record id="mizan_services_types_tree_view" model="ir.ui.view">
            <field name="name">services.types.tree</field>
            <field name="model">mizan.services.types</field>
            <field name="arch" type="xml">
                <tree string="انواع الخدمات">
                     <field name="name" />
                      <field name="en_name" />

					<field name="product_id" />
					 <field name="company_id" string="الشركة"  options="{'no_create': True}" groups="base.group_multi_company"/>
                </tree>
            </field>
        </record>
          <record id="action_mizan_services_types_view" model="ir.actions.act_window">
            <field name="name">انواع الخدمات</field>
            <field name="res_model">mizan.services.types</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="mizan_services_types_tree_view"/>
            <field name="target">current</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Click to create new service Type
                </p>
            </field>
          </record>



